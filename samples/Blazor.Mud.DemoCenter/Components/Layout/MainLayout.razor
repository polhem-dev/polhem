@inherits LayoutComponentBase
@using Polhem.Web.Blazor.Mud.Theming

<PolhemMudProviders IsDarkMode="_isDark" />

<MudLayout>
    <MudAppBar Dense="true" Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" aria-label="Toggle navigation"
                       OnClick="() => _navOpen = !_navOpen" />
        <MudText Typo="Typo.h6" Class="ml-2 demo-title">Polhem.Web.Blazor.Mud Demo Center</MudText>
        <MudSpacer />
        <MudSwitch T="bool" @bind-Value="_isDark" Label="Dark" Color="Color.Inherit" aria-label="Dark theme" />
    </MudAppBar>
    <MudDrawer @bind-Open="_navOpen" ClipMode="DrawerClipMode.Always" Width="300px" Variant="DrawerVariant.Responsive">
        <MudNavMenu Dense="true">
            @foreach (var topic in DemoModuleRegistry.Modules.GroupBy(m => m.Category))
            {
                <MudNavGroup Title="@topic.Key" Expanded="true">
                    @foreach (var module in topic)
                    {
                        <MudNavLink Href="@module.Href" Match="NavLinkMatch.All">@module.Title</MudNavLink>
                    }
                </MudNavGroup>
            }
        </MudNavMenu>
    </MudDrawer>
    <MudMainContent>
        <div class="demo-main">@Body</div>
    </MudMainContent>
</MudLayout>

@code {
    private bool _isDark = true;
    private bool _navOpen = true;
}
