@* The left column is MudBlazor alone; the right column is the Polhem editor that wraps it. *@
<FormScope DataObject="_data">
    <div class="demo-stack">
        <DemoSection Title="TextEdit ← MudTextField">
            <div class="demo-columns">
                <MudTextField T="string" Value="@("Alice Chen")" Label="Native" Variant="Variant.Outlined" Margin="Margin.Dense" />
                <MudTextField T="string" Value="@("Alice Chen")" Label="Native, read-only" ReadOnly="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
                <TextEdit FieldName="emp_name" />
                <TextEdit LayoutField="ReadOnly(_empName)" />
            </div>
        </DemoSection>
        <DemoSection Title="MemoEdit ← MudTextField (multi-line)">
            <div class="demo-columns">
                <MudTextField T="string" Value="@("Multi-line memo content.")" Lines="3" Label="Native" Variant="Variant.Outlined" Margin="Margin.Dense" />
                <MudTextField T="string" Value="@("Multi-line memo content.")" Lines="3" Label="Native, read-only" ReadOnly="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
                <MemoEdit FieldName="notes" />
                <MemoEdit LayoutField="ReadOnly(_notes)" />
            </div>
        </DemoSection>
        <DemoSection Title="ButtonEdit ← MudTextField (adornment)">
            <div class="demo-columns">
                <MudTextField T="string" Value="@("EMP-001")" Label="Native" Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Search" Variant="Variant.Outlined" Margin="Margin.Dense" />
                <MudTextField T="string" Value="@("EMP-001")" Label="Native, read-only" ReadOnly="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
                <ButtonEdit FieldName="emp_code" />
                <ButtonEdit LayoutField="ReadOnly(_empCode)" />
            </div>
        </DemoSection>
        <DemoSection Title="DateEdit ← MudDatePicker">
            <div class="demo-columns">
                <MudDatePicker Date="s_date" Label="Native" Variant="Variant.Outlined" Margin="Margin.Dense" />
                <MudDatePicker Date="s_date" Label="Native, read-only" ReadOnly="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
                <DateEdit FieldName="hire_date" />
                <DateEdit LayoutField="ReadOnly(_hireDate)" />
            </div>
        </DemoSection>
        <DemoSection Title="YearMonthEdit ← MudDatePicker (month view)">
            <div class="demo-columns">
                <MudDatePicker Date="s_date" Label="Native" OpenTo="OpenTo.Month" FixDay="1" DateFormat="yyyy-MM" Variant="Variant.Outlined" Margin="Margin.Dense" />
                <MudDatePicker Date="s_date" Label="Native, read-only" OpenTo="OpenTo.Month" FixDay="1" DateFormat="yyyy-MM" ReadOnly="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
                <YearMonthEdit FieldName="pay_month" />
                <YearMonthEdit LayoutField="ReadOnly(_payMonth)" />
            </div>
        </DemoSection>
        <DemoSection Title="DropDownEdit ← MudSelect">
            <div class="demo-columns">
                <MudSelect T="string" Value="@("Information Technology")" Label="Native" Variant="Variant.Outlined" Margin="Margin.Dense">
                    @foreach (var name in s_departments) { <MudSelectItem Value="name">@name</MudSelectItem> }
                </MudSelect>
                <MudSelect T="string" Value="@("Information Technology")" Label="Native, read-only" ReadOnly="true" Variant="Variant.Outlined" Margin="Margin.Dense">
                    @foreach (var name in s_departments) { <MudSelectItem Value="name">@name</MudSelectItem> }
                </MudSelect>
                <DropDownEdit FieldName="dept_id" />
                <DropDownEdit LayoutField="ReadOnly(_dept)" />
            </div>
        </DemoSection>
        <DemoSection Title="CheckEdit ← MudCheckBox">
            <div class="demo-columns">
                <MudCheckBox T="bool" Value="true" Label="Native" />
                <MudCheckBox T="bool" Value="true" Label="Native, read-only" ReadOnly="true" />
                <CheckEdit FieldName="is_active" />
                <CheckEdit LayoutField="ReadOnly(_active)" />
            </div>
        </DemoSection>
    </div>
</FormScope>

@code {
    private static readonly string[] s_departments = ["Human Resources", "Information Technology", "Finance"];
    private static readonly DateTime? s_date = new DateTime(2026, 6, 11, 0, 0, 0, DateTimeKind.Unspecified);

    private readonly LayoutField _empName = new() { FieldName = "emp_name" };
    private readonly LayoutField _notes = new() { FieldName = "notes" };
    private readonly LayoutField _empCode = new() { FieldName = "emp_code" };
    private readonly LayoutField _hireDate = new() { FieldName = "hire_date" };
    private readonly LayoutField _payMonth = new() { FieldName = "pay_month" };
    private readonly LayoutField _dept = new() { FieldName = "dept_id" };
    private readonly LayoutField _active = new() { FieldName = "is_active" };
    private readonly FormDataObject _data = BuildData();

    private static LayoutField ReadOnly(LayoutField field)
    {
        field.ReadOnly = true;
        return field;
    }

    private static FormDataObject BuildData()
    {
        var schema = new FormSchema("Gallery", "Gallery");
        var fields = schema.Tables!.Add("Gallery", "Gallery").Fields!;
        fields.Add("emp_name", "Name", FieldDbType.String).MaxLength = 20;
        fields.Add("notes", "Notes", FieldDbType.String);
        fields.Add("emp_code", "Code", FieldDbType.String);
        fields.Add("hire_date", "Hire Date", FieldDbType.Date);
        fields.Add("pay_month", "Pay Month", FieldDbType.String).ControlType = ControlType.YearMonthEdit;
        DataEditorParts.AddDepartment(fields, "dept_id");
        fields.Add("is_active", "Active", FieldDbType.Boolean);

        var data = new FormDataObject(schema);
        data.InitializeNewMaster();
        data.SetField("emp_name", "Alice Chen");
        data.SetField("notes", "Multi-line memo content.");
        data.SetField("emp_code", "EMP-001");
        data.SetField("hire_date", "2026-06-11");
        data.SetField("pay_month", "2026-06");
        data.SetField("dept_id", "IT");
        data.SetField("is_active", bool.TrueString);
        return data;
    }
}
