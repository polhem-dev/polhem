<FormLayoutPresenter Layout="_layout" DataObject="_data" IsCompact="IsCompact" IdPrefix="columns" />

@code {
    private readonly FormLayout _layout;
    private readonly FormDataObject _data;

    [CascadingParameter(Name = "IsCompact")]
    public bool IsCompact { get; set; }

    public MultiColumnLayoutModule()
    {
        var schema = SampleFormData.BuildMasterFormSchema();
        _data = SampleFormData.BuildMasterForm(schema);
        _layout = FormLayoutGenerator.Generate(schema, "default");
        _layout.ColumnCount = 2;
        foreach (var field in (_layout.Sections ?? []).SelectMany(section => section.Fields ?? []))
        {
            if (field.FieldName == "notes")
                field.ColumnSpan = 2;
        }
    }
}
