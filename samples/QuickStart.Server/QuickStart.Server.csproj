<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>QuickStart.Server</RootNamespace>
    <AssemblyName>QuickStart.Server</AssemblyName>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Polhem.Db\Polhem.Db.csproj" />
    <ProjectReference Include="..\Polhem.Samples.Shared\Polhem.Samples.Shared.csproj" />
  </ItemGroup>

  <!-- Polhem.JsonRpc.AspNetCore serves the endpoint. PolhemJsonRpcSource switches to a local checkout; see
       PolhemJsonRpc.props. -->
  <Import Project="..\..\PolhemJsonRpc.props" />
  <ItemGroup Condition="'$(PolhemJsonRpcSource)' == ''">
    <PackageReference Include="Polhem.JsonRpc.AspNetCore" Version="$(PolhemJsonRpcVersion)" />
  </ItemGroup>
  <ItemGroup Condition="'$(PolhemJsonRpcSource)' != ''">
    <ProjectReference Include="$(PolhemJsonRpcSource)/src/Polhem.JsonRpc.AspNetCore/Polhem.JsonRpc.AspNetCore.csproj" />
  </ItemGroup>

</Project>
