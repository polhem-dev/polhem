<?xml version="1.0" encoding="utf-8"?>
<DbCategorySettings xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <Categories>
    <!-- common: framework tables shared across companies. Sign-in reads st_user and writes st_session;
         EnterCompany reads st_company and st_user_company. -->
    <DbCategory Id="common" DisplayName="Common Database">
      <Tables>
        <TableItem TableName="st_user" DisplayName="User" />
        <TableItem TableName="st_session" DisplayName="Session" />
        <TableItem TableName="st_cache_notify" DisplayName="Cache Notification" />
        <TableItem TableName="st_company" DisplayName="Company" />
        <TableItem TableName="st_user_company" DisplayName="User Company Access" />
      </Tables>
    </DbCategory>
    <!-- company: the demo's business tables, plus the framework tables EnterCompany reads while it
         builds the session's company scope (the user's employee row and role grants). Those stay
         empty: no form here declares a PermissionModelId, so neither permission axis applies. -->
    <DbCategory Id="company" DisplayName="Company Database">
      <Tables>
        <TableItem TableName="ft_staff" DisplayName="Staff" />
        <TableItem TableName="ft_staff_phone" DisplayName="Staff Phones" />
        <TableItem TableName="ft_team" DisplayName="Team" />
        <TableItem TableName="ft_project" DisplayName="Project" />
        <TableItem TableName="ft_project_member" DisplayName="Project Members" />
        <TableItem TableName="st_employee" DisplayName="Employee (framework)" />
        <TableItem TableName="st_role" DisplayName="Role" />
        <TableItem TableName="st_role_grant" DisplayName="Role Grant" />
        <TableItem TableName="st_user_role" DisplayName="User Role" />
      </Tables>
    </DbCategory>
  </Categories>
</DbCategorySettings>
