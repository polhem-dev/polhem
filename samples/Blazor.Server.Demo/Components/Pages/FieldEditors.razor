@page "/editors"
@using Polhem.Core.Data
@using Polhem.Definition.Collections
@using Polhem.Definition.Forms
@using Polhem.Definition.Layouts
@using Polhem.Web.Blazor.Server.Controls
@using Polhem.Web.Blazor.Server.Controls.Editors
@using Polhem.Web.Blazor.Server.DataObjects

@* The cases mirror the Avalonia DemoCenter's "Control Types" and "FormMode States" modules, so the same
   behavior can be compared head to head. Everything here is in memory; no backend is called. *@

<section class="polhem-demo-section">
    <h2>Every control type</h2>
    <p>
        One <code>FormLayoutPresenter</code> over an in-memory <code>FormDataObject</code>. Switch the form mode,
        or write a value from code to see the editors refresh.
    </p>
    <div class="polhem-demo-toolbar">
        @foreach (var mode in s_modes)
        {
            <button type="button" disabled="@(mode == _mode)" @onclick="() => _mode = mode">@mode</button>
        }
        <button type="button" @onclick="WriteFromCode">Write the name from code</button>
    </div>
    <FormLayoutPresenter Layout="_layout" DataObject="_data" FormMode="_mode" IdPrefix="all" />
</section>

<section class="polhem-demo-section">
    <h2>The three form modes, with AllowEditModes</h2>
    <p>
        name: All · code: Add only · dept: Edit only · audit: None. Each column is pinned to one mode through a
        <code>FormScope</code>.
    </p>
    <div class="polhem-demo-columns">
        @foreach (var mode in s_modes)
        {
            <div class="polhem-demo-card">
                <h3>@mode</h3>
                <FormScope DataObject="_modeData[mode]" FormMode="mode">
                    <label>name</label>
                    <TextEdit LayoutField="@(Field("name", FormEditModes.All))" />
                    <label>code</label>
                    <TextEdit LayoutField="@(Field("code", FormEditModes.Add))" />
                    <label>dept</label>
                    <DropDownEdit LayoutField="@(Field("dept", FormEditModes.Edit))" />
                    <label>audit</label>
                    <TextEdit LayoutField="@(Field("audit", FormEditModes.None))" />
                </FormScope>
            </div>
        }
    </div>
</section>

@code {
    private static readonly SingleFormMode[] s_modes = [SingleFormMode.View, SingleFormMode.Add, SingleFormMode.Edit];

    private readonly FormLayout _layout;
    private readonly FormDataObject _data;
    private readonly Dictionary<SingleFormMode, FormDataObject> _modeData = new();
    private SingleFormMode _mode = SingleFormMode.Edit;

    public FieldEditors()
    {
        var schema = BuildAllTypesSchema();
        _layout = FormLayoutGenerator.Generate(schema, "default");
        _data = new FormDataObject(schema);
        _data.InitializeNewMaster();
        _data.SetField("name", "Alice Chen");
        _data.SetField("amount", "1234.5");
        _data.SetField("hired", "2024-04-01");
        _data.SetField("period", "2026-03");
        _data.SetField("starts", "08:30");
        _data.SetField("updated", "2026-10-25T14:30:00");
        _data.SetField("active", bool.TrueString);
        _data.SetField("dept", "IT");

        foreach (var mode in s_modes)
            _modeData[mode] = BuildModeData();
    }

    private static LayoutField Field(string name, FormEditModes modes) => new() { FieldName = name, AllowEditModes = modes };

    private void WriteFromCode() => _data.SetField("name", "Written at " + DateTime.Now.ToLongTimeString());

    private static FormSchema BuildAllTypesSchema()
    {
        var schema = new FormSchema("Showcase", "Showcase");
        var fields = schema.Tables!.Add("Showcase", "Showcase").Fields!;
        fields.Add("name", "Name (TextEdit)", FieldDbType.String).MaxLength = 50;
        var amount = fields.Add("amount", "Amount (NumericEdit)", FieldDbType.Decimal);
        amount.NumberFormat = "N2";
        fields.Add("hired", "Hired (DateEdit)", FieldDbType.Date);
        fields.Add("period", "Period (YearMonthEdit)", FieldDbType.String).ControlType = ControlType.YearMonthEdit;
        fields.Add("starts", "Starts (TimeEdit)", FieldDbType.Time);
        fields.Add("updated", "Updated (DateTimeEdit)", FieldDbType.DateTime);
        fields.Add("active", "Active (CheckEdit)", FieldDbType.Boolean);
        var dept = fields.Add("dept", "Department (DropDownEdit)", FieldDbType.String);
        dept.ControlType = ControlType.DropDownEdit;
        dept.ListItems!.Add("HR", "Human Resources");
        dept.ListItems.Add("IT", "Information Technology");
        fields.Add("notes", "Notes (MemoEdit)", FieldDbType.Text);
        return schema;
    }

    private static FormDataObject BuildModeData()
    {
        var schema = new FormSchema("Demo", "Demo");
        var fields = schema.Tables!.Add("Demo", "Demo").Fields!;
        fields.Add("name", "Name", FieldDbType.String);
        fields.Add("code", "Code", FieldDbType.String);
        var dept = fields.Add("dept", "Department", FieldDbType.String);
        dept.ListItems!.Add("HR", "Human Resources");
        dept.ListItems.Add("IT", "Information Technology");
        dept.ListItems.Add("FIN", "Finance");
        fields.Add("audit", "Audit", FieldDbType.String);

        var data = new FormDataObject(schema);
        data.InitializeNewMaster();
        data.SetField("name", "Alice Chen");
        data.SetField("code", "EMP-001");
        data.SetField("dept", "IT");
        data.SetField("audit", "system");
        return data;
    }
}
