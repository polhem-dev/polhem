<?xml version="1.0" encoding="utf-8" ?>
<!--
  SonarCloud analysis settings.

  The SonarScanner Begin step of .github/workflows/build-ci.yml references this file through
  /s:"$GITHUB_WORKSPACE/SonarQube.Analysis.xml".

  Parameters kept on the command line (not in this file):
    /k:                project key
    /o:                organization
    /d:sonar.token     the SONAR_TOKEN secret, kept out of version control
    /d:sonar.host.url  the SonarCloud endpoint (some versions of the dotnet scanner require it on the command line)

  Design principle: settings tied to files or rules in this repository live here and are reviewed with the
  repository's pull requests. Settings shared by the account or organization (quality profile, quality gate)
  stay in the SonarCloud UI.

  NOTE: the /s: parameter of SonarScanner for .NET requires this XML format (SonarQube.Analysis.xml);
  it does not accept the Java sonar-project.properties format.
-->
<SonarQubeAnalysisProperties xmlns="http://www.sonarsource.com/msbuild/integration/2015/1">
  <Property Name="sonar.cs.opencover.reportsPaths">**/TestResults/**/coverage.opencover.xml</Property>

  <!--
    Folders excluded from coverage: tests/ and samples/ do not need coverage themselves.
    (MySQL and Oracle were removed from this list once the main CI started running them.)
  -->
  <Property Name="sonar.coverage.exclusions">tests/**,samples/**</Property>

  <!--
    Duplication detection is excluded for code that is symmetric by design.

    1. **/Providers/**
       Each database in Polhem.Db.Providers (SqlServer/PostgreSql/Sqlite/MySql/Oracle) must implement its own
       SQL dialect, metadata queries and schema operations. The duplication is inherent and cannot be removed
       with a shared base class.

    2. src/Polhem.Web.Blazor.*/Components/**, src/Polhem.Web.Blazor.*/DataObjects/**
       The original reason was that the Blazor Server, Blazor Wasm and MAUI UI component libraries mirrored each
       other on purpose (different runtimes, no shared components). **Wasm and MAUI were removed when the UI heads
       were consolidated**, so only Blazor.Server is left and there is nothing to mirror. This exclusion no longer
       has a reason; remove it once a full-mode scan confirms that no existing duplication shows up without it.
  -->
  <Property Name="sonar.cpd.exclusions">**/Providers/**,src/Polhem.Web.Blazor.*/Components/**,src/Polhem.Web.Blazor.*/DataObjects/**</Property>
</SonarQubeAnalysisProperties>
