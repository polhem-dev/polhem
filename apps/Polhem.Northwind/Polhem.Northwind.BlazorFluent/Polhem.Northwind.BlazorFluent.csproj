<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!-- The same application as Polhem.Northwind.Blazor on Fluent UI. It has no host of its own: Polhem.Northwind.Blazor
       mounts it under a path of its own (NorthwindDemoSite.FluentServerPath) and supplies the backend and the services. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Polhem.Northwind.BlazorFluent</RootNamespace>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Polhem.Web.Blazor.Server\Polhem.Web.Blazor.Server.csproj" />
    <ProjectReference Include="..\..\..\src\Polhem.Web.Blazor.Fluent\Polhem.Web.Blazor.Fluent.csproj" />
  </ItemGroup>

</Project>
