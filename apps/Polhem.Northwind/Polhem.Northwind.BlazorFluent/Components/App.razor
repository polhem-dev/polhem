<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.Name">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="@(HttpContext?.Request.PathBase.Value ?? string.Empty)/" />
    <link href="_content/Microsoft.FluentUI.AspNetCore.Components/css/default-fuib.css" rel="stylesheet" />
    <link href="_content/Microsoft.FluentUI.AspNetCore.Components/Microsoft.FluentUI.AspNetCore.Components.bundle.scp.css" rel="stylesheet" />
    <link href="_content/Polhem.Web.Blazor.Fluent/polhem-fluent.css" rel="stylesheet" />
    <title>Polhem.Northwind</title>
    <HeadOutlet @rendermode="InteractiveServer" />
</head>
<body>
    <Routes @rendermode="InteractiveServer" />
    <script src="_framework/blazor.web.js"></script>
</body>
</html>

@code {
    // Polhem.Northwind.Blazor mounts this head under a path of its own, which the request carries as its path base.
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }
}
