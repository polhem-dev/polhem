@inject PolhemApiClient Client
@inject Polhem.Web.Blazor.Server.DependencyInjection.PolhemBlazorOptions Options

@if (_rows is null)
{
    <div class="nw-nav__loading">@ShellText.Get("Loading")</div>
}
else
{
    <ul class="nw-nav__list">
        @foreach (var row in _rows)
        {
            if (row.ProgId is null)
            {
                <li class="nw-nav__header">@row.Caption</li>
            }
            else
            {
                <li>
                    <NavLink class="nw-nav__link" href="@($"form/{row.ProgId}")" @onclick="OnNavigated">@row.Caption</NavLink>
                </li>
            }
        }
    </ul>
}

@code {
    private IReadOnlyList<MenuRow>? _rows;

    /// <summary>Raised when the user picks an entry, so a narrow screen can close the menu.</summary>
    [Parameter]
    public EventCallback OnNavigated { get; set; }

    protected override async Task OnInitializedAsync()
        => _rows = await MenuRows.LoadAsync(Client, Options);
}
