@inject IHostEnvironment Environment
<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.Name">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="_content/Polhem.Web.Blazor.Server/polhem.css" />
    <link rel="stylesheet" href="app.css" />
    <title>Polhem.Northwind</title>
    <HeadOutlet @rendermode="InteractiveServer" />
</head>
<body>
    <Routes @rendermode="InteractiveServer" />
    @if (Environment.IsEnvironment(Polhem.Northwind.Blazor.Demo.NorthwindDemo.EnvironmentName))
    {
        @* The demo site also serves the Avalonia WASM head, whose page links back here. *@
        <a class="demo-switch" href="web/">Try the Avalonia web version</a>
    }
    <script src="_framework/blazor.web.js"></script>
</body>
</html>
