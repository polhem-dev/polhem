<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Polhem.Northwind.Blazor</RootNamespace>
    <AssemblyName>Polhem.Northwind.Blazor</AssemblyName>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- The Blazor Server head runs the Northwind backend in its own process by default; see Program.cs for the
       Remote switch and the Demo environment. -->
  <ItemGroup>
    <ProjectReference Include="..\Polhem.Northwind.Backend\Polhem.Northwind.Backend.csproj" />
    <ProjectReference Include="..\..\..\src\Polhem.Web.Blazor.Server\Polhem.Web.Blazor.Server.csproj" />
    <ProjectReference Include="..\..\..\src\Polhem.Web.Blazor.Mud\Polhem.Web.Blazor.Mud.csproj" />
    <!-- The Fluent UI head is a Razor class library that Program.cs mounts under its own path. -->
    <ProjectReference Include="..\Polhem.Northwind.BlazorFluent\Polhem.Northwind.BlazorFluent.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\NorthwindDemoSite.cs" Link="Demo\NorthwindDemoSite.cs" />
  </ItemGroup>

  <!-- Polhem.JsonRpc.AspNetCore serves the endpoint of the Demo environment (Demo/NorthwindDemo.cs).
       PolhemJsonRpcSource switches to a local checkout; see PolhemJsonRpc.props. -->
  <Import Project="..\..\..\PolhemJsonRpc.props" />
  <ItemGroup Condition="'$(PolhemJsonRpcSource)' == ''">
    <PackageReference Include="Polhem.JsonRpc.AspNetCore" Version="$(PolhemJsonRpcVersion)" />
  </ItemGroup>
  <ItemGroup Condition="'$(PolhemJsonRpcSource)' != ''">
    <ProjectReference Include="$(PolhemJsonRpcSource)/src/Polhem.JsonRpc.AspNetCore/Polhem.JsonRpc.AspNetCore.csproj" />
  </ItemGroup>

</Project>
