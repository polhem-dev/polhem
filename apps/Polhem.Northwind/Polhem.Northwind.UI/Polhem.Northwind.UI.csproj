<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Polhem.Northwind.UI</RootNamespace>
    <AssemblyName>Polhem.Northwind.UI</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- The shell adds no font; every Northwind head draws with Inter. -->
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Polhem.UI.Avalonia.Shell\Polhem.UI.Avalonia.Shell.csproj" />
  </ItemGroup>

</Project>
