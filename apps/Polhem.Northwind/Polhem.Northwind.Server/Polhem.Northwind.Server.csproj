<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Polhem.Northwind.Server</RootNamespace>
    <AssemblyName>Polhem.Northwind.Server</AssemblyName>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- The JSON-RPC host of the Northwind backend, for the Avalonia heads. The backend itself, its definitions
       analyzer included, is Polhem.Northwind.Backend. -->
  <ItemGroup>
    <ProjectReference Include="..\Polhem.Northwind.Backend\Polhem.Northwind.Backend.csproj" />
  </ItemGroup>

  <!-- Polhem.JsonRpc.AspNetCore serves the endpoint. PolhemJsonRpcSource switches to a local checkout; see
       PolhemJsonRpc.props. -->
  <Import Project="..\..\..\PolhemJsonRpc.props" />
  <ItemGroup Condition="'$(PolhemJsonRpcSource)' == ''">
    <PackageReference Include="Polhem.JsonRpc.AspNetCore" Version="$(PolhemJsonRpcVersion)" />
  </ItemGroup>
  <ItemGroup Condition="'$(PolhemJsonRpcSource)' != ''">
    <ProjectReference Include="$(PolhemJsonRpcSource)/src/Polhem.JsonRpc.AspNetCore/Polhem.JsonRpc.AspNetCore.csproj" />
  </ItemGroup>

</Project>
