<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Polhem.Northwind.BlazorWasm</RootNamespace>
    <AssemblyName>Polhem.Northwind.BlazorWasm</AssemblyName>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- A trimmed browser-wasm publish turns System.Text.Json reflection off, and the JSON-RPC envelope needs it.
         The SDK's default TrimMode here is partial, which copies the Polhem assemblies untouched. Full trimming is
         not supported; see .claude/rules/apple-mobile-trim.md. -->
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <!-- By default the ICU shard is chosen from the browser's language, and the sign-in screen can switch away from it. -->
    <BlazorWebAssemblyLoadAllGlobalizationData>true</BlazorWebAssemblyLoadAllGlobalizationData>
    <!-- The framework converts every instant through TimeZoneInfo (ADR-032), so the time zone data must ship. Both are
         the SDK defaults today; they are pinned because the failure only shows at run time, in the browser. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <InvariantTimezone>false</InvariantTimezone>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.1" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.1" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Polhem.Web.Blazor.Wasm\Polhem.Web.Blazor.Wasm.csproj" />
    <ProjectReference Include="..\..\..\src\Polhem.Web.Blazor.Mud\Polhem.Web.Blazor.Mud.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\NorthwindDemoSite.cs" Link="Demo\NorthwindDemoSite.cs" />
  </ItemGroup>

</Project>
