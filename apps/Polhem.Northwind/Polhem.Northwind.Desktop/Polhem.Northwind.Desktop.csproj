<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>WinExe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Polhem.Northwind.Desktop</RootNamespace>
    <AssemblyName>Polhem.Northwind.Desktop</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- macOS application bundle: dotnet publish -c Release -r osx-arm64 -p:PolhemMacAppBundle=true -->
    <PolhemBundleIdentifier>tw.polhem.northwind</PolhemBundleIdentifier>
    <PolhemBundleName>Polhem.Northwind</PolhemBundleName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Polhem.Northwind.UI\Polhem.Northwind.UI.csproj" />
  </ItemGroup>

  <!-- A package reference imports this through buildTransitive/; a project reference does not. -->
  <Import Project="..\..\..\src\Polhem.UI.Avalonia.Shell\buildTransitive\Polhem.UI.Avalonia.Shell.targets" />

</Project>
