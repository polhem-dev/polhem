      </Rules>
    </PermissionModel>
    <PermissionModel ModelId="Shipper" DisplayName="Shipper">
      <Rules>
        <PermissionRule Action="Create" Scope="All" />
        <PermissionRule Action="Read" Scope="All" />
        <PermissionRule Action="Update" Scope="All" />
        <PermissionRule Action="Delete" Scope="All" />
      </Rules>
    </PermissionModel>
    <PermissionModel ModelId="Department" DisplayName="Department">
      <Rules>
        <PermissionRule Action="Create" Scope="All" />
        <PermissionRule Action="Read" Scope="All" />
        <PermissionRule Action="Update" Scope="All" />
        <PermissionRule Action="Delete" Scope="All" />
      </Rules>
    </PermissionModel>
    <PermissionModel ModelId="Employee" DisplayName="Employee">
      <Rules>
        <PermissionRule Action="Create" Scope="All" />
        <PermissionRule Action="Read" Scope="All" />
        <PermissionRule Action="Update" Scope="All" />
        <PermissionRule Action="Delete" Scope="All" />
      </Rules>
    </PermissionModel>
    <PermissionModel ModelId="AuditRule" DisplayName="Audit Rule">
      <Rules>
        <PermissionRule Action="Create" Scope="All" />
        <PermissionRule Action="Read" Scope="All" />
        <PermissionRule Action="Update" Scope="All" />
