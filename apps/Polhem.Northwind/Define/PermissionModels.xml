<?xml version="1.0" encoding="utf-8"?>
<!--
  The demo's permission model registry: one model per form, named after its ProgId, which each
  FormSchema opts into with PermissionModelId. Enforcement is fail-closed, so every form the menu
  offers is bound to a model and granted through one of two roles (SeedData/RoleGrant.json):

  - OrderClerk (demo, demo-tw) holds every action on every model.
  - OrderViewer (demo-ro) holds Read on Order and on the master data and organization forms
    (Category, Supplier, Customer, Shipper, Department, Employee), nothing on Product and nothing on
    AuditRule. So the front ends hide every command demo-ro may not run, let it open an order's
    customer read-only, and refuse to open an order line's product.

  AuditRule is the framework's own model (src/Polhem.Definition/Defaults/PermissionModels.xml), kept
  here because this file replaces the shipped one. Every action reads every row (Scope All): the
  demo shows the action gate, not record scope.
-->
<PermissionModels xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <Models>
    <PermissionModel ModelId="Order" DisplayName="Order">
      <Rules>
        <PermissionRule Action="Create" Scope="All" />
        <PermissionRule Action="Read" Scope="All" />
        <PermissionRule Action="Update" Scope="All" />
        <PermissionRule Action="Delete" Scope="All" />
      </Rules>
    </PermissionModel>
    <PermissionModel ModelId="Product" DisplayName="Product">
      <Rules>
        <PermissionRule Action="Create" Scope="All" />
        <PermissionRule Action="Read" Scope="All" />
        <PermissionRule Action="Update" Scope="All" />
        <PermissionRule Action="Delete" Scope="All" />
      </Rules>
    </PermissionModel>
    <PermissionModel ModelId="Category" DisplayName="Category">
      <Rules>
        <PermissionRule Action="Create" Scope="All" />
        <PermissionRule Action="Read" Scope="All" />
        <PermissionRule Action="Update" Scope="All" />
        <PermissionRule Action="Delete" Scope="All" />
      </Rules>
    </PermissionModel>
    <PermissionModel ModelId="Supplier" DisplayName="Supplier">
      <Rules>
        <PermissionRule Action="Create" Scope="All" />
        <PermissionRule Action="Read" Scope="All" />
        <PermissionRule Action="Update" Scope="All" />
