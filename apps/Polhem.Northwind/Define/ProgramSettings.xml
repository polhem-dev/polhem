<?xml version="1.0" encoding="utf-8"?>
<ProgramSettings xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <Items>
    <!-- No BusinessObject attribute: System is a framework-reserved progId and resolves to the
         framework's own SystemBusinessObject. The entry stays declared rather than being deleted
         so startup self-registration has nothing missing to add — that path rewrites this whole
         file, comments included. -->
    <ProgramItem ProgId="System" DisplayName="System" />
    <ProgramItem ProgId="Category" DisplayName="Categories" />
    <ProgramItem ProgId="Supplier" DisplayName="Suppliers" />
    <ProgramItem ProgId="Customer" DisplayName="Customers" />
    <ProgramItem ProgId="Shipper" DisplayName="Shippers" />
    <ProgramItem ProgId="Product" DisplayName="Products" />
    <ProgramItem ProgId="Department" DisplayName="Departments" />
    <ProgramItem ProgId="Employee" DisplayName="Employees" />
    <ProgramItem ProgId="Order" DisplayName="Orders" BusinessObject="Polhem.Northwind.Server.BusinessObjects.OrderBO, Polhem.Northwind.Server" Repository="Polhem.Northwind.Server.Repositories.OrderRepository, Polhem.Northwind.Server" />
    <ProgramItem ProgId="AuditLog" DisplayName="AuditLog" BusinessObject="Polhem.Business.AuditLog.AuditLogBusinessObject, Polhem.Business" />
    <!-- No BusinessObject attribute: AuditRule is a framework-reserved progId and resolves to
         AuditRuleBusinessObject on its own. -->
    <ProgramItem ProgId="AuditRule" DisplayName="Audit Rules" />
  </Items>
</ProgramSettings>