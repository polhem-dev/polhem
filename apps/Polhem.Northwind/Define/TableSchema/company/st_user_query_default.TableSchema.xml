<?xml version="1.0" encoding="utf-8"?>
<!--
  Each user's default user query per form: the query the list applies when it opens. It may name a query another user
  shares, which is why it is not a column of st_user_query.
-->
<TableSchema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" TableName="st_user_query_default" DisplayName="Default User Query">
  <Fields>
    <DbField FieldName="sys_no" Caption="Sequence No." DbType="AutoIncrement" />
    <DbField FieldName="sys_rowid" Caption="Row Id" DbType="Guid" />
    <DbField FieldName="sys_company_id" Caption="Company Id" DbType="String" Length="10" />
    <DbField FieldName="prog_id" Caption="Program Id" DbType="String" Length="50" />
    <DbField FieldName="user_id" Caption="User Id" DbType="String" Length="20" />
    <DbField FieldName="query_rowid" Caption="Query Row Id" DbType="Guid" />
    <DbField FieldName="sys_insert_time" Caption="Created At" DbType="DateTime" />
  </Fields>
  <Indexes>
    <DbTableIndex Name="pk_{0}" Unique="true" PrimaryKey="true">
      <IndexFields>
        <IndexField FieldName="sys_no" />
      </IndexFields>
    </DbTableIndex>
    <DbTableIndex Name="rx_{0}" Unique="true">
      <IndexFields>
        <IndexField FieldName="sys_rowid" />
      </IndexFields>
    </DbTableIndex>
    <DbTableIndex Name="uk_{0}" Unique="true">
      <IndexFields>
        <IndexField FieldName="sys_company_id" />
        <IndexField FieldName="prog_id" />
        <IndexField FieldName="user_id" />
      </IndexFields>
    </DbTableIndex>
  </Indexes>
</TableSchema>
