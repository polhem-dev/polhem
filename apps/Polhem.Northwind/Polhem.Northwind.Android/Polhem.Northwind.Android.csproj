<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>23</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Polhem.Northwind.Android</RootNamespace>
    <AssemblyName>Polhem.Northwind.Android</AssemblyName>
    <ApplicationId>com.polhem.northwind</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <!-- Debug-first head: no profiled AOT, so Debug builds run under the Mono interpreter
         (JIT) where Reflection.Emit is available. The AOT-only XmlSerializer incompatibility
         that surfaced on iOS therefore does not apply to Android Debug. -->
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!--
      Unlike the other Northwind heads this deliberately does NOT set TreatWarningsAsErrors:
      a Release Android build runs trim analysis and Polhem's reflection-heavy serialization
      (XmlSerializer for FormSchema, System.Text.Json, MessagePack) emits IL2026 / IL2104
      trim warnings that are expected here. The head keeps the SDK's default partial trim
      (AndroidLinkMode=SdkOnly), the only trim mode Polhem supports; the reasons are in
      docs/repo-ops/gotchas/mobile-trim-aot.md.
    -->
  </PropertyGroup>

  <ItemGroup>
    <AndroidResource Include="Icon.png">
      <Link>Resources\drawable\Icon.png</Link>
    </AndroidResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Android" Version="12.0.4" />
    <PackageReference Include="Xamarin.AndroidX.Core.SplashScreen" Version="1.0.1.15" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Polhem.Northwind.UI\Polhem.Northwind.UI.csproj" />
  </ItemGroup>

  <!-- Time zone data must ship: the framework converts every instant between UTC and the user's
       zone through TimeZoneInfo (ADR-032 D4), so a build without tz data fails at the first
       conversion — and on this head that is every screen showing a date. Invariant globalization
       would also strip it. Both are the SDK defaults today; they are pinned because the failure is
       a runtime exception on device, which no desktop build or test can catch. -->
  <PropertyGroup>
    <InvariantGlobalization>false</InvariantGlobalization>
    <InvariantTimezone>false</InvariantTimezone>
  </PropertyGroup>

</Project>
