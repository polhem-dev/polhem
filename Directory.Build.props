<Project>

  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <!-- Stable, faster restore and build on CI. -->
    <RestoreUseStaticGraphEvaluation>true</RestoreUseStaticGraphEvaluation>
    <MSBuildEnableWorkloadResolver>false</MSBuildEnableWorkloadResolver>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>

    <!-- Packing is a separate step, so the Build step does not pack as well. -->
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>

    <!-- One output folder for every nupkg; the workflows collect the packages from here. -->
    <PackageOutputPath>$(MSBuildThisFileDirectory)nupkgs</PackageOutputPath>

    <!-- Do not fail restore or build on NU1605 (package downgrade). -->
    <NoWarn>$(NoWarn);NU1605</NoWarn>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1605</WarningsNotAsErrors>

    <!-- Optional: skip package validation and analysis to pack faster. -->
    <EnablePackageValidation>false</EnablePackageValidation>
    <NoPackageAnalysis>true</NoPackageAnalysis>
  </PropertyGroup>

  <!-- Applies only while packing. This group gives the largest speed-up. -->
  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true' and '$(Pack)' == 'true'">
    <!-- The build step has already run, so packing does not build again. -->
    <NoBuild>true</NoBuild>

    <!-- Referenced projects are not packed into each package, which would multiply the work. -->
    <IncludeReferencedProjects>false</IncludeReferencedProjects>

    <!-- Symbol packages slow packing down. Enable them only when needed. -->
    <!-- <IncludeSymbols>false</IncludeSymbols> -->
    <!-- <SymbolPackageFormat>snupkg</SymbolPackageFormat> -->
  </PropertyGroup>

</Project>
