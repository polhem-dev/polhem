<Project>

  <!--
    tools/ holds development-time tools and is independent of the build baseline of the core packages.
    This file deliberately does NOT import the Directory.Build.props at the repository root,
    so tools/ is fully self-contained: not published to NuGet, and without the strict analysis settings of src/.

    The version is the one exception, and it is deliberate: Polhem.Cli lives under tools/ but IS published to
    NuGet (see .github/workflows/nuget-publish.yml). It used to carry its own version, which fell twelve minor
    versions behind the framework, so every published Polhem.Cli stamped its assembly as 4.8.0.0. With the
    version now supplied by the single source Version.props, that drift cannot happen again by construction.
    This is an explicit import of a named file, not inheritance of the root props, so the independence
    described above is unaffected.
  -->
  <Import Project="$(MSBuildThisFileDirectory)../Version.props" />

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

</Project>
