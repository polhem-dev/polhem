<Project Sdk="Microsoft.NET.Sdk">

  <!-- Package metadata shared with the src/ packages: icon, license, repository. -->
  <Import Project="..\..\Package.props" />

  <PropertyGroup>
    <!--
      A `dotnet new` template package (`dotnet new install Polhem.Templates`, then `dotnet new polhem-avalonia`). It carries
      only the files under content/; the target framework is required by the SDK and nothing is compiled.
      Overrides tools/Directory.Build.props (IsPackable=false).
    -->
    <TargetFramework>net10.0</TargetFramework>
    <PackageType>Template</PackageType>
    <PackageId>Polhem.Templates</PackageId>
    <IsPackable>true</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <EnableDefaultItems>false</EnableDefaultItems>
    <!-- content/ holds .template.config, .vscode, .config and .gitignore, which NuGet leaves out by default. -->
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <IncludeSymbols>false</IncludeSymbols>
    <!-- NU5128: a template package has no lib/ folder, by design. -->
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <PackageOutputPath>../../nupkgs</PackageOutputPath>
    <Description>Project templates for Polhem. `dotnet new polhem-avalonia` creates a JSON-RPC server and Avalonia clients; `dotnet new polhem-blazor-server` creates one Blazor Server site that runs the backend in its own process. Each references the Polhem packages and the driver of the chosen database, with a definition folder, the DefineEditor and DbManager tools, and VS Code tasks that initialize the database and open DefineEditor.</Description>
    <PackageTags>polhem;dotnet-new;templates</PackageTags>
  </PropertyGroup>

  <!--
    Template strings are translated in each template's .template.config/localize/templatestrings.<language>.json.
    Microsoft.TemplateEngine.Authoring.Tasks rewrites those files from template.json on every build, so the keys
    follow template.json and only the translated values are kept by hand. The build-ci workflow fails when a pack
    leaves them changed. zh-Hant also covers zh-TW and zh-HK, which fall back to it.
  -->
  <PropertyGroup>
    <LocalizeTemplates>true</LocalizeTemplates>
    <LocalizableTemplatesPath>content</LocalizableTemplatesPath>
    <TemplateLanguages>zh-Hant</TemplateLanguages>
    <ValidateTemplatesPath>content</ValidateTemplatesPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.TemplateEngine.Authoring.Tasks" Version="10.0.403" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="content\**" Exclude="content\**\bin\**;content\**\obj\**;content\_shared\**;content\*\.template.config\template.json"
          Pack="true" PackagePath="content\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!--
    A template is a folder of content/ with a .template.config/template.json. content/_shared is not one: it holds
    the files every template carries unchanged, kept once and packed into each template's folder by
    PackTemplateFiles. So a template installed from its content folder misses them; only the package is supported.
  -->
  <ItemGroup>
    <_PolhemTemplateJson Include="content\*\.template.config\template.json" />
    <_PolhemSharedFile Include="content\_shared\**" Exclude="content\_shared\**\bin\**;content\_shared\**\obj\**"
                       RelativePath="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!--
    The generated application references the Polhem packages and tools of this package's own version. template.json
    carries a placeholder as the default of polhemVersion, and the packed copy carries the version, so the version
    has one source (Version.props, or the /p:Version of the release) and template.json never has to be edited for a
    release.
  -->
  <Target Name="_CollectPolhemTemplates">
    <ItemGroup>
      <_PolhemTemplate Include="@(_PolhemTemplateJson)">
        <TemplateName>$([System.IO.Path]::GetFileName($([System.IO.Path]::GetDirectoryName($([System.IO.Path]::GetDirectoryName('%(FullPath)'))))))</TemplateName>
      </_PolhemTemplate>
    </ItemGroup>
    <Error Condition="'@(_PolhemTemplate)' == ''" Text="No template under content/ has a .template.config/template.json." />
  </Target>

  <!-- Runs once for each template (target batching on TemplateName). -->
  <Target Name="PackTemplateFiles" BeforeTargets="_GetPackageFiles" DependsOnTargets="_CollectPolhemTemplates"
          Outputs="%(_PolhemTemplate.TemplateName)">
    <PropertyGroup>
      <_PolhemTemplateName>@(_PolhemTemplate->'%(TemplateName)')</_PolhemTemplateName>
      <_PolhemTemplateJsonPath>@(_PolhemTemplate->'%(FullPath)')</_PolhemTemplateJsonPath>
      <_PolhemStampedTemplateJson>$(IntermediateOutputPath)$(_PolhemTemplateName)\template.json</_PolhemStampedTemplateJson>
      <_PolhemTemplateText>$([System.IO.File]::ReadAllText('$(_PolhemTemplateJsonPath)'))</_PolhemTemplateText>
    </PropertyGroup>
    <Error Condition="!$(_PolhemTemplateText.Contains('&quot;0.0.0-unpacked&quot;'))"
           Text="content\$(_PolhemTemplateName)\.template.config\template.json no longer holds the placeholder 0.0.0-unpacked that PackTemplateFiles replaces with the package version." />
    <WriteLinesToFile File="$(_PolhemStampedTemplateJson)"
                      Lines="$(_PolhemTemplateText.Replace('&quot;0.0.0-unpacked&quot;', '&quot;$(PackageVersion)&quot;'))"
                      Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <None Include="$(_PolhemStampedTemplateJson)" Pack="true" PackagePath="content\$(_PolhemTemplateName)\.template.config\template.json" />
      <None Include="@(_PolhemSharedFile)" Pack="true" PackagePath="content\$(_PolhemTemplateName)\%(_PolhemSharedFile.RelativePath)" />
    </ItemGroup>
  </Target>

</Project>
