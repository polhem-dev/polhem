@page "/form/{ProgId}"

<PageTitle>@ProgId · PolhemApp</PageTitle>

@* One page serves every form: FormPage loads again when the route gives it a new ProgId. *@
<FormPage ProgId="@ProgId" />

@code {
    /// <summary>The form the route names.</summary>
    [Parameter]
    public string ProgId { get; set; } = string.Empty;
}
