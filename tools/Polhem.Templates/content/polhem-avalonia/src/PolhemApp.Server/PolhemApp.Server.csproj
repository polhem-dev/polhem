<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- The definition files live beside the solution, not in this project; the Polhem analyzers check them on build. -->
    <PolhemDefinitionFilesGlob>..\..\Define\**\*.xml</PolhemDefinitionFilesGlob>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Polhem.Hosting" Version="POLHEM_PACKAGE_VERSION" />
    <PackageReference Include="Polhem.JsonRpc.AspNetCore" Version="[1.2.0, 2.0.0)" />
<!--#if (database == "SqlServer") -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <!-- Above the version the driver pulls in, which carries advisories GHSA-846f-f764-76mx and GHSA-2fmv-rv2c-59x7. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="9.0.21" />
<!--#elif (database == "PostgreSql") -->
    <PackageReference Include="Npgsql" Version="10.0.3" />
<!--#elif (database == "MySql") -->
    <PackageReference Include="MySqlConnector" Version="2.6.2" />
<!--#elif (database == "Oracle") -->
    <PackageReference Include="Oracle.ManagedDataAccess.Core" Version="23.26.301" />
    <!-- Above the version the driver pulls in, which carries advisories GHSA-846f-f764-76mx and GHSA-2fmv-rv2c-59x7. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="9.0.21" />
<!--#else -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <!-- Above the native bundle the driver pulls in (2.1.x), which carries advisory GHSA-2m69-gcr7-jv3q. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
<!--#endif -->
  </ItemGroup>

</Project>
