<Project Sdk="Microsoft.NET.Sdk">

  <!-- The front end every platform head starts: the Polhem shell with this application's options. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Polhem.UI.Avalonia.Shell" Version="POLHEM_PACKAGE_VERSION" />
  </ItemGroup>

</Project>
