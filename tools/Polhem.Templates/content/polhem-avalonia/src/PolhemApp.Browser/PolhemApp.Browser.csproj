<Project Sdk="Microsoft.NET.Sdk.WebAssembly">

  <!-- The browser (WebAssembly) head. Needs the wasm-tools workload: dotnet workload install wasm-tools -->
  <PropertyGroup>
    <TargetFramework>net10.0-browser</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- browser-wasm turns off reflection-based System.Text.Json, which Polhem's JSON-RPC envelope uses. -->
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <!-- Polhem serializes its definitions and messages by reflection, which trimming breaks. -->
    <PublishTrimmed>false</PublishTrimmed>
    <!-- Dates are converted to the user's time zone through TimeZoneInfo, so the time zone data must ship. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <InvariantTimezone>false</InvariantTimezone>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Browser" Version="12.1.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PolhemApp.UI\PolhemApp.UI.csproj" />
  </ItemGroup>

</Project>
