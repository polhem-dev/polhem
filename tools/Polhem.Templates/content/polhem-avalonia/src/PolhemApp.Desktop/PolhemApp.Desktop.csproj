<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>WinExe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- macOS application bundle: dotnet publish -c Release -r osx-arm64 -p:PolhemMacAppBundle=true -->
    <PolhemBundleIdentifier>com.example.polhem-app-bundle</PolhemBundleIdentifier>
    <PolhemBundleName>PolhemApp</PolhemBundleName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PolhemApp.UI\PolhemApp.UI.csproj" />
  </ItemGroup>

</Project>
