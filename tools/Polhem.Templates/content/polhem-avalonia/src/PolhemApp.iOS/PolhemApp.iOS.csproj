<Project Sdk="Microsoft.NET.Sdk">

  <!-- The iOS head. Needs the ios workload and the Xcode it names: dotnet workload install ios -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-ios</TargetFramework>
    <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!--
      No TreatWarningsAsErrors here: the iOS build runs trim analysis, and the reflection-based serialization of
      Polhem's definitions and messages reports trim warnings (IL2026, IL2104) that are expected. Keep the SDK's
      default partial trim; Polhem does not support full trimming.
    -->
    <!-- Dates are converted to the user's time zone through TimeZoneInfo, so the time zone data must ship. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <InvariantTimezone>false</InvariantTimezone>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.iOS" Version="12.1.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PolhemApp.UI\PolhemApp.UI.csproj" />
  </ItemGroup>

</Project>
