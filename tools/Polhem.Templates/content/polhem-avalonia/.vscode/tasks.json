{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Polhem: Initialize database",
            "dependsOrder": "sequence",
            "dependsOn": [
                "polhem-db-create",
                "polhem-db-upgrade",
                "polhem-db-seed-admin"
            ],
            "problemMatcher": []
        },
        {
            "label": "polhem-db-create",
            "type": "process",
            "command": "dotnet",
            "args": [
                "run",
                "--project",
                "${workspaceFolder}/src/PolhemApp.Server/PolhemApp.Server.csproj",
                "--",
                "db",
                "create"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": "$msCompile",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "hide": true
        },
        {
            "label": "polhem-db-upgrade",
            "type": "process",
            "command": "dotnet",
            "args": [
                "run",
                "--project",
                "${workspaceFolder}/src/PolhemApp.Server/PolhemApp.Server.csproj",
                "--",
                "db",
                "upgrade"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": "$msCompile",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "hide": true
        },
        {
            "label": "polhem-db-seed-admin",
            "type": "process",
            "command": "dotnet",
            "args": [
                "run",
                "--project",
                "${workspaceFolder}/src/PolhemApp.Server/PolhemApp.Server.csproj",
                "--",
                "db",
                "seed-admin",
                "--company",
                "POLHEM_COMPANY_ID"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": "$msCompile",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "hide": true
        },
        {
            "label": "Polhem: Upgrade database",
            "type": "process",
            "command": "dotnet",
            "args": [
                "run",
                "--project",
                "${workspaceFolder}/src/PolhemApp.Server/PolhemApp.Server.csproj",
                "--",
                "db",
                "upgrade"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": "$msCompile",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "Polhem: Open DefineEditor",
            "type": "process",
            "command": "dotnet",
            "args": [
                "polhem-define",
                "${workspaceFolder}/Define"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": [
                "polhem-tool-restore"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "silent",
                "panel": "dedicated"
            }
        },
        {
            "label": "polhem-tool-restore",
            "type": "process",
            "command": "dotnet",
            "args": [
                "tool",
                "restore"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "hide": true
        },
        {
            "label": "Polhem: Run all",
            // Builds the solution once, then starts the server and every client side by side. The clients are not
            // rebuilt as they start: parallel builds of the shared UI project would collide over its obj folder.
            // A definition changed while they run shows after signing out and in again; the server picks up the
            // changed files by itself.
            "dependsOrder": "sequence",
            "dependsOn": [
                "build",
                "polhem-run-parallel"
            ],
            "problemMatcher": []
        },
        {
            "label": "polhem-run-parallel",
            "dependsOrder": "parallel",
            "dependsOn": [
                "polhem-run-server",
//#if (browser)
                "polhem-run-browser",
//#endif
//#if (ios)
                "polhem-run-ios",
//#endif
//#if (android)
                "polhem-run-android",
//#endif
                "polhem-run-desktop"
            ],
            "problemMatcher": [],
            "hide": true
        },
        {
            "label": "polhem-run-server",
            "type": "process",
            "command": "dotnet",
            "args": [
                "run",
                "--project",
                "${workspaceFolder}/src/PolhemApp.Server/PolhemApp.Server.csproj",
                "--no-build"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "silent",
                "panel": "dedicated"
            },
            "hide": true
        },
        {
            "label": "polhem-run-desktop",
            "type": "process",
            "command": "dotnet",
            "args": [
                "run",
                "--project",
                "${workspaceFolder}/src/PolhemApp.Desktop/PolhemApp.Desktop.csproj",
                "--no-build"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "silent",
                "panel": "dedicated"
            },
            "hide": true
        },
//#if (browser)
        {
            // Started by the Browser launch configuration: the WebAssembly development server, ready once it prints
            // its URL.
            "label": "polhem-serve-browser",
            "type": "process",
            "command": "dotnet",
            "args": [
                "run",
                "--project",
                "${workspaceFolder}/src/PolhemApp.Browser/PolhemApp.Browser.csproj"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "isBackground": true,
            "problemMatcher": {
                "owner": "polhem-browser",
                "pattern": {
                    "regexp": "^\\s*error\\s+(.*)$",
                    "message": 1
                },
                "background": {
                    "activeBegins": true,
                    "beginsPattern": "^.*$",
                    "endsPattern": "^App url:"
                }
            },
            "presentation": {
                "reveal": "silent",
                "panel": "dedicated"
            },
            "hide": true
        },
        {
            // Run after a Browser debug session: ends the development server task, so the next start can bind the port.
            "label": "polhem-stop-browser",
            "type": "shell",
            "command": "echo ${input:polhem-terminate-browser}",
            "problemMatcher": [],
            "presentation": {
                "reveal": "never"
            },
            "hide": true
        },
        {
            "label": "polhem-run-browser",
            "type": "process",
            "command": "dotnet",
            "args": [
                "run",
                "--project",
                "${workspaceFolder}/src/PolhemApp.Browser/PolhemApp.Browser.csproj",
                "--no-build"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "silent",
                "panel": "dedicated"
            },
            "hide": true
        },
//#endif
//#if (ios)
        {
            "label": "polhem-run-ios",
            "type": "process",
            "command": "dotnet",
            "args": [
                "build",
                "${workspaceFolder}/src/PolhemApp.iOS/PolhemApp.iOS.csproj",
                "-t:Run",
                "-f",
                "net10.0-ios",
                "-p:BuildProjectReferences=false"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "silent",
                "panel": "dedicated"
            },
            "hide": true
        },
//#endif
//#if (android)
        {
            "label": "polhem-run-android",
            "type": "process",
            "command": "dotnet",
            "args": [
                "build",
                "${workspaceFolder}/src/PolhemApp.Android/PolhemApp.Android.csproj",
                "-t:Run",
                "-f",
                "net10.0-android",
                "-p:BuildProjectReferences=false"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "silent",
                "panel": "dedicated"
            },
            "hide": true
        },
//#endif
//#if (ios)
        {
            "label": "Polhem: Run iOS simulator",
            "type": "process",
            "command": "dotnet",
            "args": [
                "build",
                "${workspaceFolder}/src/PolhemApp.iOS/PolhemApp.iOS.csproj",
                "-t:Run",
                "-f",
                "net10.0-ios"
            ],
            // The Run target computes the launch arguments from the app bundle, so the bundle is built first.
            "dependsOn": [
                "polhem-ios-build"
            ],
            "problemMatcher": "$msCompile",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        },
        {
            "label": "polhem-ios-build",
            "type": "process",
            "command": "dotnet",
            "args": [
                "build",
                "${workspaceFolder}/src/PolhemApp.iOS/PolhemApp.iOS.csproj",
                "-f",
                "net10.0-ios"
            ],
            "problemMatcher": "$msCompile",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "hide": true
        },
//#endif
//#if (android)
        {
            "label": "Polhem: Run Android emulator",
            "type": "process",
            "command": "dotnet",
            "args": [
                "build",
                "${workspaceFolder}/src/PolhemApp.Android/PolhemApp.Android.csproj",
                "-t:Run",
                "-f",
                "net10.0-android"
            ],
            "problemMatcher": "$msCompile",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        },
//#endif
        {
            "label": "build",
            "type": "process",
            "command": "dotnet",
            "args": [
                "build",
                "${workspaceFolder}/PolhemApp.slnx",
                "/consoleloggerparameters:NoSummary;ForceNoAlign"
            ],
            "problemMatcher": "$msCompile",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
//#if (browser)
    ],
    "inputs": [
        {
            "id": "polhem-terminate-browser",
            "type": "command",
            "command": "workbench.action.tasks.terminate",
            "args": "polhem-serve-browser"
        }
//#endif
    ]
}
