{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Polhem: Initialize database",
            "dependsOrder": "sequence",
            "dependsOn": [
                "polhem-db-create",
                "polhem-db-upgrade",
                "polhem-db-seed-admin"
            ],
            "problemMatcher": []
        },
        {
            "label": "polhem-db-create",
            "type": "process",
            "command": "dotnet",
            "args": [
                "run",
                "--project",
                "${workspaceFolder}/src/PolhemApp.Server/PolhemApp.Server.csproj",
                "--",
                "db",
                "create"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": "$msCompile",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "hide": true
        },
        {
            "label": "polhem-db-upgrade",
            "type": "process",
            "command": "dotnet",
            "args": [
                "run",
                "--project",
                "${workspaceFolder}/src/PolhemApp.Server/PolhemApp.Server.csproj",
                "--",
                "db",
                "upgrade"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": "$msCompile",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "hide": true
        },
        {
            "label": "polhem-db-seed-admin",
            "type": "process",
            "command": "dotnet",
            "args": [
                "run",
                "--project",
                "${workspaceFolder}/src/PolhemApp.Server/PolhemApp.Server.csproj",
                "--",
                "db",
                "seed-admin",
                "--company",
                "POLHEM_COMPANY_ID"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": "$msCompile",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "hide": true
        },
        {
            "label": "Polhem: Upgrade database",
            "type": "process",
            "command": "dotnet",
            "args": [
                "run",
                "--project",
                "${workspaceFolder}/src/PolhemApp.Server/PolhemApp.Server.csproj",
                "--",
                "db",
                "upgrade"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": "$msCompile",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "Polhem: Open DefineEditor",
            "type": "process",
            "command": "dotnet",
            "args": [
                "polhem-define",
                "${workspaceFolder}/Define"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": [
                "polhem-tool-restore"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "silent",
                "panel": "dedicated"
            }
        },
        {
            "label": "polhem-tool-restore",
            "type": "process",
            "command": "dotnet",
            "args": [
                "tool",
                "restore"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "hide": true
        },
//#if (ios)
        {
            "label": "Polhem: Run iOS simulator",
            "type": "process",
            "command": "dotnet",
            "args": [
                "build",
                "${workspaceFolder}/src/PolhemApp.iOS/PolhemApp.iOS.csproj",
                "-t:Run",
                "-f",
                "net10.0-ios"
            ],
            // The Run target computes the launch arguments from the app bundle, so the bundle is built first.
            "dependsOn": [
                "polhem-ios-build"
            ],
            "problemMatcher": "$msCompile",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        },
        {
            "label": "polhem-ios-build",
            "type": "process",
            "command": "dotnet",
            "args": [
                "build",
                "${workspaceFolder}/src/PolhemApp.iOS/PolhemApp.iOS.csproj",
                "-f",
                "net10.0-ios"
            ],
            "problemMatcher": "$msCompile",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "hide": true
        },
//#endif
//#if (android)
        {
            "label": "Polhem: Run Android emulator",
            "type": "process",
            "command": "dotnet",
            "args": [
                "build",
                "${workspaceFolder}/src/PolhemApp.Android/PolhemApp.Android.csproj",
                "-t:Run",
                "-f",
                "net10.0-android"
            ],
            "problemMatcher": "$msCompile",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        },
//#endif
        {
            "label": "build",
            "type": "process",
            "command": "dotnet",
            "args": [
                "build",
                "${workspaceFolder}/PolhemApp.slnx",
                "/consoleloggerparameters:NoSummary;ForceNoAlign"
            ],
            "problemMatcher": "$msCompile",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
