{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Server",
            "type": "dotnet",
            "request": "launch",
            "projectPath": "${workspaceFolder}/src/PolhemApp.Server/PolhemApp.Server.csproj"
        },
        {
            "name": "Desktop",
