{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Server",
            "type": "dotnet",
            "request": "launch",
            "projectPath": "${workspaceFolder}/src/PolhemApp.Server/PolhemApp.Server.csproj",
            "presentation": {
                "group": "parts",
                "order": 1
            }
        },
        {
            "name": "Desktop",
            "type": "dotnet",
            "request": "launch",
            "projectPath": "${workspaceFolder}/src/PolhemApp.Desktop/PolhemApp.Desktop.csproj",
            "presentation": {
                "group": "parts",
                "order": 1
            }
//#if (browser)
        },
        {
            // The "dotnet" launch type cannot start a WebAssembly head (it starts nothing and reports nothing). The
            // development server runs as a background task instead, and VS Code's built-in JavaScript debugger opens
            // the page in Chrome once the server prints its URL. Stopping the session stops the server.
            "name": "Browser",
            "type": "chrome",
            "request": "launch",
            "url": "http://localhost:5380",
            "preLaunchTask": "polhem-serve-browser",
            "postDebugTask": "polhem-stop-browser",
            "presentation": {
                "group": "parts",
                "order": 1
            }
//#endif
        }
    ],
    // VS Code selects the first entry of the sorted list in a new workspace. Group "app" sorts before "parts",
    // so F5 starts the server and the desktop client together.
    "compounds": [
        {
            "name": "Server + Desktop",
            "configurations": [
                "Server",
                "Desktop"
            ],
            "stopAll": true,
            "presentation": {
                "group": "app",
                "order": 1
            }
//#if (browser)
        },
        {
            "name": "Server + Browser",
            "configurations": [
                "Server",
                "Browser"
            ],
            "stopAll": true,
            "presentation": {
                "group": "app",
                "order": 2
            }
//#endif
        }
    ]
}
