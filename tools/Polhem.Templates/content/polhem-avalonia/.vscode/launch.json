{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Server",
            "type": "dotnet",
            "request": "launch",
            "projectPath": "${workspaceFolder}/src/PolhemApp.Server/PolhemApp.Server.csproj",
            "presentation": {
                "group": "parts",
                "order": 1
            }
        },
        {
            "name": "Desktop",
            "type": "dotnet",
            "request": "launch",
            "projectPath": "${workspaceFolder}/src/PolhemApp.Desktop/PolhemApp.Desktop.csproj",
            "presentation": {
                "group": "parts",
                "order": 1
            }
//#if (browser)
        },
        {
            "name": "Browser",
            "type": "dotnet",
            "request": "launch",
            "projectPath": "${workspaceFolder}/src/PolhemApp.Browser/PolhemApp.Browser.csproj",
            "presentation": {
                "group": "parts",
                "order": 1
            }
//#endif
        }
    ],
    // VS Code selects the first entry of the sorted list in a new workspace. Group "app" sorts before "parts",
    // so F5 starts the server and the desktop client together.
    "compounds": [
        {
            "name": "Server + Desktop",
            "configurations": [
                "Server",
                "Desktop"
            ],
            "stopAll": true,
            "presentation": {
                "group": "app",
                "order": 1
            }
//#if (browser)
        },
        {
            "name": "Server + Browser",
            "configurations": [
                "Server",
                "Browser"
            ],
            "stopAll": true,
            "presentation": {
                "group": "app",
                "order": 2
            }
//#endif
        }
    ]
}
