<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Polhem.DefineEditor.App"
             xmlns:local="using:Polhem.DefineEditor"
             xmlns:conv="using:Polhem.DefineEditor.Converters"
             RequestedThemeVariant="Dark">

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <!-- Sidebar colors modelled on VS Code: one step darker than the (white) editor area in Light,
                     one step lighter in Dark, so the solution tree is clearly set apart from the definition editor.
                     The values come from sideBar.background in the VS Code default themes. -->
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="SidebarBackground">#F3F3F3</SolidColorBrush>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="SidebarBackground">#252526</SolidColorBrush>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <conv:IconKeyToGeometryConverter x:Key="IconKeyToGeometry"/>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <StyleInclude Source="avares://Semi.Avalonia/Index.axaml"/>
        <StyleInclude Source="/Styles/DocumentStyles.axaml"/>
    </Application.Styles>
</Application>
