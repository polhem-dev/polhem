@page "/preview/{Token}/{DocumentId}"
@namespace Polhem.DefineEditor.BrowserPreview
@rendermode Microsoft.AspNetCore.Components.Web.RenderMode.InteractiveServer
@using Polhem.Core.Serialization
@using Polhem.Definition.Layouts
@using Polhem.DefineEditor.Services
@implements IDisposable
@inject BrowserPreviewHub Hub
@inject IJSRuntime JS

<PageTitle>@(_snapshot?.Title ?? "Polhem DefineEditor")</PageTitle>
@if (IsFluent)
{
    <Polhem.Web.Blazor.Fluent.Theming.PolhemFluentProviders IsDarkMode="IsDark" />
}
else
{
    <Polhem.Web.Blazor.Mud.Theming.PolhemMudProviders IsDarkMode="IsDark" />
}

<div class="@(IsDark ? "browser-preview-canvas browser-preview-canvas--dark" : "browser-preview-canvas")">
    @if (_error is not null)
    {
        <p class="browser-preview__message browser-preview__message--error">@_error</p>
    }
    else if (_layout is null)
    {
        <p class="browser-preview__message">@LocalizationService.Current["BrowserPreview_NotPublished"]</p>
    }
    else
    {
        <div class="@(_snapshot!.IsCompact ? "browser-preview browser-preview--compact" : "browser-preview")">
            @if (IsFluent)
            {
                <Polhem.Web.Blazor.Fluent.Controls.FormLayoutPresenter Layout="_layout" FormMode="_snapshot.FormMode"
                                                                       IsCompact="_snapshot.IsCompact" IdPrefix="@IdPrefix" />
            }
            else
            {
                <Polhem.Web.Blazor.Mud.Controls.FormLayoutPresenter Layout="_layout" FormMode="_snapshot.FormMode"
                                                                    IsCompact="_snapshot.IsCompact" IdPrefix="@IdPrefix" />
            }
        </div>
    }
</div>

@code {
    private const string IdPrefix = "preview";

    private BrowserPreviewSnapshot? _snapshot;
    private DotNetObjectReference<BrowserPreviewPage>? _selfReference;
    private FormLayout? _layout;
    private string? _error;

    /// <summary>Gets or sets the URL token; the host checks it before the page is reached.</summary>
    [Parameter]
    public string Token { get; set; } = string.Empty;

    /// <summary>
    /// Gets or sets the theme of the form and the canvas around it: <c>dark</c> when the editor that shows the page uses
    /// its dark theme. A browser opened from the editor passes nothing and gets the light theme.
    /// </summary>
    [SupplyParameterFromQuery(Name = "canvas")]
    public string? Canvas { get; set; }

    private bool IsDark => string.Equals(Canvas, "dark", StringComparison.OrdinalIgnoreCase);

    /// <summary>
    /// Gets or sets the package that draws the form, a <see cref="BrowserPreviewUi"/> by
    /// <see cref="BrowserPreviewHost.ParseUi"/>; the document links that package's stylesheets from the same query.
    /// </summary>
    [SupplyParameterFromQuery(Name = BrowserPreviewHost.UiQueryName)]
    public string? Ui { get; set; }

    private bool IsFluent => BrowserPreviewHost.ParseUi(Ui) == BrowserPreviewUi.Fluent;

    /// <summary>Gets or sets the id of the document to show.</summary>
    [Parameter]
    public string DocumentId { get; set; } = string.Empty;

    protected override void OnInitialized()
    {
        Hub.SnapshotPublished += OnSnapshotPublished;
        Hub.SelectionPublished += OnSelectionPublished;
        Load();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_layout is null) return;
        await JS.InvokeVoidAsync("polhemBrowserPreview.showFieldNames", IdPrefix, _snapshot!.ShowFieldNames);
        if (_selfReference is null)
        {
            _selfReference = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("polhemBrowserPreview.followClicks", _selfReference);
        }
        // A render may draw the form again, so the outline goes back on what is selected now.
        await OutlineSelectionAsync();
    }

    public void Dispose()
    {
        Hub.SnapshotPublished -= OnSnapshotPublished;
        Hub.SelectionPublished -= OnSelectionPublished;
        _selfReference?.Dispose();
    }

    /// <summary>
    /// Called by the page's script with the part of the form that was clicked, which the editor then selects.
    /// </summary>
    /// <param name="kind">A <see cref="PreviewTargetKind"/> name.</param>
    /// <param name="index">The position of the section or the detail grid.</param>
    /// <param name="item">The position of the field or the column in it, or -1.</param>
    [JSInvokable]
    public void SelectFromPreview(string kind, int index, int item)
    {
        if (Enum.TryParse<PreviewTargetKind>(kind, out var targetKind) && Enum.IsDefined(targetKind))
            Hub.RequestSelection(DocumentId, new PreviewTarget(targetKind, index, item));
    }

    private void OnSelectionPublished(string documentId)
    {
        if (string.Equals(documentId, DocumentId, StringComparison.Ordinal))
            _ = InvokeAsync(OutlineSelectionAsync);
    }

    private async Task OutlineSelectionAsync()
    {
        if (_layout is null) return;
        var target = Hub.GetSelection(DocumentId);
        await JS.InvokeVoidAsync("polhemBrowserPreview.outline",
            target?.Kind.ToString(), target?.Index ?? -1, target?.Item ?? -1);
    }

    private void OnSnapshotPublished(string documentId)
    {
        if (string.Equals(documentId, DocumentId, StringComparison.Ordinal))
            _ = InvokeAsync(() =>
            {
                Load();
                StateHasChanged();
            });
    }

    private void Load()
    {
        _snapshot = Hub.GetSnapshot(DocumentId);
        _layout = null;
        _error = _snapshot?.Error is { } error
            ? string.Format(LocalizationService.Current.Culture, LocalizationService.Current["Preview_RenderFailed"], error)
            : null;
        if (_snapshot is null || _error is not null) return;
        try
        {
            _layout = XmlCodec.Deserialize<FormLayout>(_snapshot.LayoutXml);
        }
        catch (InvalidOperationException ex)
        {
            _error = string.Format(LocalizationService.Current.Culture, LocalizationService.Current["Preview_RenderFailed"], ex.Message);
        }
    }
}
