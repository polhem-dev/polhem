<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Polhem.DefineEditor.ViewModels"
             xmlns:m="using:Polhem.DefineEditor.Models"
             xmlns:loc="using:Polhem.DefineEditor.Markup"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="Polhem.DefineEditor.Views.WelcomeDocumentView"
             x:DataType="vm:WelcomeDocumentViewModel"
             x:CompileBindings="True">

    <UserControl.Styles>
        <!-- Link-style buttons like the VS Code welcome page: no border, primary-color text, hand cursor -->
        <Style Selector="Button.link">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="2,3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource SemiColorPrimary}"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <Style Selector="Button.link:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource SemiColorPrimaryPointerover}"/>
        </Style>
        <!-- Recent entries: the remove button shows only while the pointer is over its row, like VS Code -->
        <Style Selector="Button.removeRecent">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource SemiColorText2}"/>
            <Setter Property="Opacity" Value="0"/>
        </Style>
        <Style Selector="Grid.recent:pointerover Button.removeRecent">
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <!-- A recent folder that no longer exists stays listed, dimmed, so it can still be removed -->
        <Style Selector="Grid.recent.missing Button.link">
            <Setter Property="Opacity" Value="0.45"/>
        </Style>
    </UserControl.Styles>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="780" Margin="56,44" Spacing="4"
                    HorizontalAlignment="Left">
            <TextBlock Classes="h1" FontSize="34" Text="DefineEditor"/>
            <TextBlock Classes="muted" FontSize="15" Margin="0,2,0,30"
                       Text="{loc:Loc About_Subtitle}"/>

            <Grid ColumnDefinitions="5*,56,4*">
                <!-- Left column: Start + Recent -->
                <StackPanel Grid.Column="0" Spacing="8">
                    <TextBlock Classes="h2" Text="{loc:Loc Welcome_SectionStart}"/>
                    <Button Classes="link" Command="{Binding OpenFolderCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Data="{StaticResource IconFolder}" Width="14" Height="14"/>
                            <TextBlock Text="{loc:Loc Welcome_OpenFolderButton}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <TextBlock Classes="h2" Text="{loc:Loc Welcome_SectionRecent}" Margin="0,22,0,0"/>
                    <ItemsControl ItemsSource="{Binding RecentSolutions}"
                                  IsVisible="{Binding HasRecentSolutions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="m:RecentSolution">
                                <Grid Classes="recent" Classes.missing="{Binding !Exists}"
                                      ColumnDefinitions="*,Auto" Background="Transparent">
                                    <Button Classes="link"
                                            Command="{Binding $parent[ItemsControl].((vm:WelcomeDocumentViewModel)DataContext).OpenRecentCommand}"
                                            CommandParameter="{Binding Path}">
                                        <ToolTip.Tip>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Path}"/>
                                                <TextBlock Text="{loc:Loc Welcome_RecentMissing}"
                                                           IsVisible="{Binding !Exists}"/>
                                            </StackPanel>
                                        </ToolTip.Tip>
                                        <Grid ColumnDefinitions="Auto,*">
                                            <TextBlock Text="{Binding Name}"/>
                                            <TextBlock Grid.Column="1" Classes="muted" Margin="12,0,0,0"
                                                       Text="{Binding Location}"
                                                       TextTrimming="PathSegmentEllipsis"/>
                                        </Grid>
                                    </Button>
                                    <Button Grid.Column="1" Classes="removeRecent"
                                            Command="{Binding $parent[ItemsControl].((vm:WelcomeDocumentViewModel)DataContext).RemoveRecentCommand}"
                                            CommandParameter="{Binding Path}"
                                            ToolTip.Tip="{loc:Loc Welcome_RemoveRecent}">
                                        <PathIcon Data="{StaticResource IconClear}" Width="10" Height="10"/>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Classes="muted" Text="{loc:Loc Welcome_NoRecent}"
                               IsVisible="{Binding !HasRecentSolutions}"/>
                </StackPanel>

                <!-- Right column: usage tips -->
                <StackPanel Grid.Column="2" Spacing="10">
                    <TextBlock Classes="h2" Text="{loc:Loc Welcome_SectionTips}"/>
                    <TextBlock Classes="muted" TextWrapping="Wrap" Text="{loc:Loc Welcome_Tip1}"/>
                    <TextBlock Classes="muted" TextWrapping="Wrap" Text="{loc:Loc Welcome_Tip2}"/>
                    <TextBlock Classes="muted" TextWrapping="Wrap" Text="{loc:Loc Welcome_Tip3}"/>
                </StackPanel>
            </Grid>

            <CheckBox Margin="0,36,0,0"
                      IsChecked="{Binding ShowOnStartup, Mode=TwoWay}"
                      Content="{loc:Loc Welcome_ShowOnStartup}"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
