<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Polhem.DefineEditor.ViewModels"
             xmlns:svc="using:Polhem.DefineEditor.Services"
             xmlns:loc="using:Polhem.DefineEditor.Markup"
             x:Class="Polhem.DefineEditor.Views.CreateTablePreview"
             x:DataType="vm:TableSchemaDocumentViewModel"
             x:CompileBindings="True">

    <DockPanel>
        <Border DockPanel.Dock="Top" Classes="surface-sunken" Padding="12,6">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Classes="h2" Text="{loc:Loc CreateTable_Title}" VerticalAlignment="Center"
                           Margin="0,0,16,0"/>
                <WrapPanel HorizontalAlignment="Right" ItemSpacing="12" LineSpacing="4">
                    <ComboBox ItemsSource="{x:Static svc:CreateTableScriptBuilder.Options}"
                              SelectedValue="{Binding CreateTableDatabase, Mode=TwoWay}"
                              SelectedValueBinding="{Binding Type, x:DataType=svc:CreateTableScriptBuilder+DatabaseOption}"
                              DisplayMemberBinding="{Binding Name, x:DataType=svc:CreateTableScriptBuilder+DatabaseOption}"
                              MinWidth="140" VerticalAlignment="Center"
                              ToolTip.Tip="{loc:Loc CreateTable_DatabaseTip}"
                              IsVisible="{Binding IsCreateTablePreviewVisible}"/>
                    <Button Content="{loc:Loc CreateTable_Copy}" Click="OnCopyClick" VerticalAlignment="Center"
                            IsVisible="{Binding IsCreateTablePreviewVisible}"/>
                    <CheckBox IsChecked="{Binding IsCreateTablePreviewVisible}" Content="{loc:Loc Preview_Show}"
                              VerticalAlignment="Center"/>
                </WrapPanel>
            </DockPanel>
        </Border>

        <TextBox Classes="code" IsVisible="{Binding IsCreateTablePreviewVisible}"
                 Text="{Binding CreateTableScript, Mode=OneWay}"
                 IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                 VerticalContentAlignment="Top"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 Margin="0" CornerRadius="0" BorderThickness="0"/>
    </DockPanel>
</UserControl>
