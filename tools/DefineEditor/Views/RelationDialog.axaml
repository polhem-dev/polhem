<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Polhem.DefineEditor.ViewModels"
        xmlns:svc="using:Polhem.DefineEditor.Services"
        xmlns:conv="using:Polhem.DefineEditor.Converters"
        xmlns:loc="using:Polhem.DefineEditor.Markup"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="600"
        x:Class="Polhem.DefineEditor.Views.RelationDialog"
        x:DataType="vm:RelationDialogViewModel"
        x:CompileBindings="True"
        Width="1100" Height="600" MinWidth="880" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Title="{Binding Title}">

    <Border Padding="22,20">
        <DockPanel>
            <!-- The related form: typing filters the list by ProgId or name. -->
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                <TextBlock DockPanel.Dock="Left" Text="{loc:Loc Relation_Form}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock DockPanel.Dock="Right" Text="{Binding SelectedName}" Classes="muted"
                           VerticalAlignment="Center" Margin="10,0,0,0" MinWidth="160"/>
                <AutoCompleteBox x:Name="FormPicker"
                                 ItemsSource="{Binding FilteredChoices}"
                                 Text="{Binding SearchText, Mode=TwoWay}"
                                 SelectedItem="{Binding SelectedChoice, Mode=TwoWay}"
                                 FilterMode="None" MinimumPrefixLength="0" MaxDropDownHeight="320"
                                 PlaceholderText="{loc:Loc Relation_FormWatermark}">
                    <AutoCompleteBox.ItemTemplate>
                        <DataTemplate x:DataType="svc:RelationProgramChoice">
                            <Grid ColumnDefinitions="200,*,Auto">
                                <TextBlock Text="{Binding ProgId}" Classes="path"/>
                                <TextBlock Grid.Column="1" Text="{Binding DisplayName}" Classes="muted"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="2" Text="{loc:Loc Relation_NoFormSchemaShort}" Classes="muted"
                                           IsVisible="{Binding !HasFormSchema}" Margin="8,0,0,0"/>
                            </Grid>
                        </DataTemplate>
                    </AutoCompleteBox.ItemTemplate>
                </AutoCompleteBox>
            </DockPanel>

            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                        HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
                <Button Classes="tool" Content="{loc:Loc Action_Cancel}" Click="OnCancel" MinWidth="90"/>
                <Button Classes="tool Primary" Content="{loc:Loc Action_OK}" Command="{Binding ApplyCommand}" MinWidth="100"/>
            </StackPanel>

            <StackPanel DockPanel.Dock="Bottom" Spacing="4" Margin="0,10,0,0">
                <CheckBox IsVisible="{Binding IsRelating}" IsChecked="{Binding ValueChangeCallback, Mode=TwoWay}">
                    <TextBlock Text="{loc:Loc Relation_ValueChangeCallback}" TextWrapping="Wrap"/>
                </CheckBox>
                <CheckBox IsVisible="{Binding HasOrphans}" IsChecked="{Binding RemoveOrphans, Mode=TwoWay}">
                    <TextBlock Text="{Binding OrphansText}" TextWrapping="Wrap"/>
                </CheckBox>
                <ItemsControl ItemsSource="{Binding Messages}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <TextBlock Text="{Binding}" Foreground="{DynamicResource SemiColorWarning}"
                                       FontSize="12" TextWrapping="Wrap"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <DataGrid ItemsSource="{Binding Rows}" AutoGenerateColumns="False" CanUserSortColumns="False"
                      CanUserReorderColumns="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="{loc:Loc Relation_Include}" Width="64">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="svc:RelationSetupRow">
                                <CheckBox IsChecked="{Binding IsIncluded, Mode=TwoWay}" HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="{loc:Loc Relation_SourceField}" Width="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="svc:RelationSetupRow">
                                <TextBlock Text="{Binding SourceField}" Classes="path" VerticalAlignment="Center" Margin="6,0"
                                           Classes.danger="{Binding IsSourceMissing}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <!-- The only star column; without a minimum the fixed columns squeeze it to nothing. -->
                    <DataGridTemplateColumn Header="{loc:Loc Relation_Caption}" Width="*" MinWidth="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="svc:RelationSetupRow">
                                <TextBlock Text="{Binding SourceCaption}" VerticalAlignment="Center" Margin="6,0"
                                           TextTrimming="CharacterEllipsis"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="{loc:Loc Relation_Type}" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="svc:RelationSetupRow">
                                <TextBlock Text="{Binding SourceTypeText}" Classes="muted" VerticalAlignment="Center" Margin="6,0"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="{loc:Loc Relation_Destination}" Width="220">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="svc:RelationSetupRow">
                                <TextBox Text="{Binding DestinationField, Mode=TwoWay}" IsEnabled="{Binding IsIncluded}"
                                         FontFamily="ui-monospace, Menlo, Consolas, monospace" FontSize="12"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="{loc:Loc Relation_LookupOnly}" Width="112">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="svc:RelationSetupRow">
                                <CheckBox IsChecked="{Binding LookupOnly, Mode=TwoWay}" IsEnabled="{Binding IsIncluded}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="{loc:Loc Relation_NewFieldType}" Width="140">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="svc:RelationSetupRow">
                                <ComboBox ItemsSource="{x:Static vm:RelationDialogViewModel.NewFieldTypes}"
                                          SelectedItem="{Binding NewFieldType, Mode=TwoWay}"
                                          IsVisible="{Binding CreatesField}" HorizontalAlignment="Stretch"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="{loc:Loc Relation_Status}" Width="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="svc:RelationSetupRow">
                                <TextBlock Text="{Binding Status, Converter={x:Static conv:RelationSetupStatusConverter.Instance}}"
                                           Classes.danger="{Binding IsError}" VerticalAlignment="Center" Margin="6,0"
                                           TextWrapping="Wrap" FontSize="12"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </Border>

    <Window.Styles>
        <Style Selector="TextBlock.danger">
            <Setter Property="Foreground" Value="{DynamicResource SemiColorDanger}"/>
        </Style>
    </Window.Styles>
</Window>
