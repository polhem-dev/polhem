<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Polhem.DefineEditor.ViewModels"
        xmlns:models="using:Polhem.DefineEditor.Models"
        xmlns:loc="using:Polhem.DefineEditor.Markup"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="720"
        x:Class="Polhem.DefineEditor.Views.MainWindow"
        x:Name="WindowRoot"
        x:DataType="vm:MainWindowViewModel"
        x:CompileBindings="True"
        Icon="/Assets/avalonia-logo.ico"
        Width="1200" Height="720"
        WindowState="Maximized"
        Title="{loc:Loc Window_Title}">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <DockPanel>
        <!-- The menus live in the macOS system menu bar at the top of the screen (set up by
             App.ConfigureApplicationMenu / ConfigureWindowMenu), not inside the window. This follows the
             VS Code convention on macOS: File, View and the rest are all at the top. -->

        <!-- Bottom status bar in the VS Code style.
             Left: [solution path] › [relative path of the current definition file]
             Right: StatusText (feedback messages for actions) -->
        <Border DockPanel.Dock="Bottom" Classes="statusbar" Padding="10,3">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6"
                            IsVisible="{Binding IsSolutionOpened}">
                    <PathIcon Data="{StaticResource IconFolder}" Width="12" Height="12"
                              Foreground="{DynamicResource SemiColorText2}"/>
                    <TextBlock Text="{Binding SolutionPath}" Classes="muted"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{Binding SolutionPath}"/>

                    <!-- Separator + relative path of the active document (hidden for tabs without a file, such as Welcome) -->
                    <TextBlock Text="›" Classes="muted" VerticalAlignment="Center"
                               Margin="4,0,0,0"
                               IsVisible="{Binding HasActiveDocumentPath}"/>
                    <TextBlock Text="{Binding ActiveDocumentRelativePath}"
                               Classes="muted" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{Binding ActiveDocumentRelativePath}"
                               IsVisible="{Binding HasActiveDocumentPath}"/>
                </StackPanel>
                <TextBlock Grid.Column="0" Text="{loc:Loc Status_NoSolution}"
                           Classes="muted" VerticalAlignment="Center"
                           IsVisible="{Binding !IsSolutionOpened}"/>

                <TextBlock Grid.Column="2" Text="{Binding StatusText}"
                           Classes="muted" VerticalAlignment="Center"
                           Margin="14,0,0,0" TextTrimming="CharacterEllipsis"/>
            </Grid>
        </Border>

        <!-- Body: solution tree on the left, document tabs on the right -->
        <Grid ColumnDefinitions="320,4,*">
            <!-- Left: the TreeView when a solution is open, otherwise a VS Code style welcome / Open Folder.
                 The sidebar class gives the whole column (including the space below the tree and the welcome
                 panel) the VS Code style background. -->
            <Grid Grid.Column="0" Classes="sidebar">
                <TreeView IsVisible="{Binding IsSolutionOpened}"
                          ItemsSource="{Binding Nodes}"
                          SelectedItem="{Binding SelectedNode, Mode=TwoWay}"
                          Padding="6,4">
                    <TreeView.ItemTemplate>
                        <TreeDataTemplate ItemsSource="{Binding Children}" x:DataType="models:DefineNode">
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2">
                                <PathIcon Classes="tree-icon"
                                          Data="{Binding Icon, Converter={StaticResource IconKeyToGeometry}}"/>
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </TreeDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>

                <!-- VS Code style welcome, shown while no solution is open -->
                <Border IsVisible="{Binding !IsSolutionOpened}" Padding="20">
                    <StackPanel Spacing="14" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="{loc:Loc Welcome_NoSolution}" Classes="muted"
                                   HorizontalAlignment="Center"/>
                        <Button Click="OnOpenSolutionClick" Classes="welcome"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                ToolTip.Tip="{loc:Loc Welcome_OpenFolderTip}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Data="{StaticResource IconFolder}" Width="14" Height="14"/>
                                <TextBlock Text="{loc:Loc Welcome_OpenFolderButton}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <TextBlock Classes="muted" HorizontalAlignment="Center"
                                   TextWrapping="Wrap" MaxWidth="240"
                                   TextAlignment="Center"
                                   Text="{loc:Loc Welcome_MenuAlternative}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="1" Background="{DynamicResource SemiColorBorder}" ResizeDirection="Columns"
                          IsVisible="{Binding IsSolutionOpened}"/>

            <Grid Grid.Column="2">
                <!-- Multi-document tab area (IDE style) -->
                <TabControl ItemsSource="{Binding OpenDocuments}"
                            SelectedItem="{Binding ActiveDocument, Mode=TwoWay}"
                            IsVisible="{Binding HasOpenDocuments}"
                            Padding="0">
                    <TabControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:DocumentViewModelBase">
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto" MinWidth="120">
                                <!-- Tab context menu modelled on VS Code, with the close actions.
                                     The commands live on MainWindowViewModel (reached through #WindowRoot);
                                     CommandParameter is the doc of the right-clicked tab. -->
                                <Grid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="{loc:Loc MenuItem_CloseTab}"
                                                  Command="{Binding #WindowRoot.((vm:MainWindowViewModel)DataContext).CloseDocumentCommand}"
                                                  CommandParameter="{Binding}"/>
                                        <MenuItem Header="{loc:Loc MenuItem_CloseOtherTabs}"
                                                  Command="{Binding #WindowRoot.((vm:MainWindowViewModel)DataContext).CloseOtherDocumentsCommand}"
                                                  CommandParameter="{Binding}"/>
                                        <MenuItem Header="{loc:Loc MenuItem_CloseTabsToRight}"
                                                  Command="{Binding #WindowRoot.((vm:MainWindowViewModel)DataContext).CloseDocumentsToTheRightCommand}"
                                                  CommandParameter="{Binding}"/>
                                        <MenuItem Header="{loc:Loc MenuItem_CloseSavedTabs}"
                                                  Command="{Binding #WindowRoot.((vm:MainWindowViewModel)DataContext).CloseSavedDocumentsCommand}"/>
                                        <MenuItem Header="{loc:Loc MenuItem_CloseAllTabs}"
                                                  Command="{Binding #WindowRoot.((vm:MainWindowViewModel)DataContext).CloseAllDocumentsCommand}"/>
                                    </ContextMenu>
                                </Grid.ContextMenu>
                                <PathIcon Grid.Column="0" Classes="tab-icon" Margin="0,0,8,0"
                                          Data="{Binding TabIcon, Converter={StaticResource IconKeyToGeometry}}"/>
                                <TextBlock Grid.Column="1" Text="{Binding Title}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" MaxWidth="260"
                                           ToolTip.Tip="{Binding DocumentKey}"/>
                                <Ellipse Grid.Column="2" Width="6" Height="6"
                                         Fill="{DynamicResource SemiColorWarning}"
                                         VerticalAlignment="Center" Margin="6,0,0,0"
                                         IsVisible="{Binding IsDirty}"
                                         ToolTip.Tip="{loc:Loc Tab_DirtyTooltip}"/>
                                <Button Grid.Column="3" Classes="tabclose"
                                        Command="{Binding #WindowRoot.((vm:MainWindowViewModel)DataContext).CloseDocumentCommand}"
                                        CommandParameter="{Binding}"
                                        ToolTip.Tip="{loc:Loc Tab_CloseTooltip}">
                                    <PathIcon Data="{StaticResource IconClear}" Width="10" Height="10"/>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </TabControl.ItemTemplate>
                    <TabControl.ContentTemplate>
                        <DataTemplate x:DataType="vm:DocumentViewModelBase">
                            <ContentControl Content="{Binding}"/>
                        </DataTemplate>
                    </TabControl.ContentTemplate>
                </TabControl>

                <!-- Welcome screen, shown when a solution is open but no tab is (without a solution, the welcome on the left covers it) -->
                <Border Padding="40" IsVisible="{Binding ShowDocumentWelcome}">
                    <StackPanel Spacing="14" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <PathIcon Data="{StaticResource IconFolder}" Width="48" Height="48"
                                  Foreground="{DynamicResource SemiColorText2}"/>
                        <TextBlock Classes="muted" HorizontalAlignment="Center"
                                   Text="{loc:Loc DocumentWelcome_Tip}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>

</Window>
