<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Polhem.DefineEditor.ViewModels"
             xmlns:loc="using:Polhem.DefineEditor.Markup"
             xmlns:controls="using:Polhem.UI.Avalonia.Controls"
             xmlns:views="using:Polhem.DefineEditor.Views"
             x:Class="Polhem.DefineEditor.Views.FormLayoutPreview"
             x:DataType="vm:FormLayoutDocumentViewModel"
             x:CompileBindings="True">

    <DockPanel>
        <Border DockPanel.Dock="Top" Classes="surface-sunken" Padding="12,6">
            <DockPanel>
                <!-- What draws the preview: two engines side by side, as a segmented switch, so which one is showing is
                     always visible. Each is a button of its own, so the macOS accessibility API can press it. -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="2"
                            AutomationProperties.Name="{loc:Loc Preview_Engine}">
                    <Button Classes="toolbar-icon view-switch" Classes.selected="{Binding IsAvaloniaPreview}"
                            Command="{Binding SetPreviewEngineCommand}" CommandParameter="{x:Static vm:FormLayoutPreviewEngine.Avalonia}"
                            ToolTip.Tip="{loc:Loc Preview_AvaloniaTooltip}"
                            AutomationProperties.Name="{loc:Loc Preview_Avalonia}">
                        <TextBlock Text="{loc:Loc Preview_Avalonia}" VerticalAlignment="Center"/>
                    </Button>
                    <Button Classes="toolbar-icon view-switch" Classes.selected="{Binding IsWebPreview}"
                            Command="{Binding SetPreviewEngineCommand}" CommandParameter="{x:Static vm:FormLayoutPreviewEngine.Web}"
                            ToolTip.Tip="{loc:Loc Preview_WebTooltip}"
                            AutomationProperties.Name="{loc:Loc Preview_Web}">
                        <TextBlock Text="{loc:Loc Preview_Web}" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>
                <!-- The options both engines follow, as icon toggles with tooltips; then the browser, which opens another
                     window rather than changing this one. -->
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="2">
                    <ToggleButton Classes="toolbar-icon" IsChecked="{Binding IsPreviewViewMode}"
                                  ToolTip.Tip="{loc:Loc Preview_ViewMode}"
                                  AutomationProperties.Name="{loc:Loc Preview_ViewMode}">
                        <PathIcon Data="{StaticResource IconPreviewViewMode}"/>
                    </ToggleButton>
                    <ToggleButton Classes="toolbar-icon" IsChecked="{Binding IsPreviewCompact}"
                                  ToolTip.Tip="{loc:Loc Preview_PhoneWidth}"
                                  AutomationProperties.Name="{loc:Loc Preview_PhoneWidth}">
                        <PathIcon Data="{StaticResource IconPreviewPhone}"/>
                    </ToggleButton>
                    <ToggleButton Classes="toolbar-icon" IsChecked="{Binding ShowPreviewFieldNames}"
                                  ToolTip.Tip="{loc:Loc Preview_FieldNames}"
                                  AutomationProperties.Name="{loc:Loc Preview_FieldNames}">
                        <PathIcon Data="{StaticResource IconPreviewFieldNames}"/>
                    </ToggleButton>
                    <Button Classes="toolbar-icon" Margin="10,0,0,0" Command="{Binding OpenInBrowserCommand}"
                            ToolTip.Tip="{loc:Loc FormLayout_OpenInBrowserTooltip}"
                            AutomationProperties.Name="{loc:Loc FormLayout_OpenInBrowser}">
                        <PathIcon Data="{StaticResource IconBrowser}"/>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <DockPanel>
            <TextBlock x:Name="ErrorText" DockPanel.Dock="Top" IsVisible="False" TextWrapping="Wrap" Margin="12,8,12,0"
                       Foreground="{DynamicResource SemiColorDanger}"/>
            <Panel>
                <ScrollViewer x:Name="PreviewScroller" HorizontalScrollBarVisibility="Disabled"
                              IsVisible="{Binding !IsWebPreview}">
                    <controls:FormLayoutPresenter x:Name="LayoutPresenter" Margin="12"/>
                </ScrollViewer>
                <views:WebPreviewPane x:Name="WebPane" IsVisible="{Binding IsWebPreview}"/>
            </Panel>
        </DockPanel>
    </DockPanel>
</UserControl>
