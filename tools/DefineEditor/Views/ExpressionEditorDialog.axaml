<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Polhem.DefineEditor.ViewModels"
        xmlns:loc="using:Polhem.DefineEditor.Markup"
        xmlns:ae="using:AvaloniaEdit"
        x:Class="Polhem.DefineEditor.Views.ExpressionEditorDialog"
        x:DataType="vm:ExpressionEditorViewModel"
        x:CompileBindings="True"
        Width="820" Height="620" MinWidth="560" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Title="{Binding Title}">

    <Border Padding="18,16">
        <DockPanel>
            <TextBlock DockPanel.Dock="Top" Classes="muted" TextWrapping="Wrap" Margin="0,0,0,8"
                       Text="{loc:Loc ExpressionEditor_Hint}"/>

            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                        HorizontalAlignment="Right" Spacing="8" Margin="0,14,0,0">
                <Button Classes="tool" Content="{loc:Loc Action_Cancel}" Click="OnCancel" MinWidth="90" IsCancel="True"/>
                <Button Classes="tool Primary" Content="{loc:Loc Action_OK}" Click="OnOk" MinWidth="90"/>
            </StackPanel>

            <StackPanel DockPanel.Dock="Bottom" Spacing="4" Margin="0,10,0,0" IsVisible="{Binding HasMessage}">
                <TextBlock Text="{loc:Loc ExpressionEditor_Message}"/>
                <TextBox Text="{Binding Message, Mode=TwoWay}" AutomationProperties.Name="{loc:Loc ExpressionEditor_Message}"/>
            </StackPanel>

            <Expander DockPanel.Dock="Bottom" Margin="0,10,0,0" HorizontalAlignment="Stretch"
                      Header="{loc:Loc ExpressionTrial_Title}" IsVisible="{Binding Trial, Converter={x:Static ObjectConverters.IsNotNull}}">
                <StackPanel Spacing="6" DataContext="{Binding Trial}" x:DataType="vm:ExpressionTrialViewModel">
                    <TextBlock Classes="muted" FontSize="11" TextWrapping="Wrap" Text="{loc:Loc ExpressionTrial_Hint}"/>
                    <TextBlock Classes="muted" IsVisible="{Binding HasNoInputs}" Text="{loc:Loc ExpressionTrial_NoInputs}"/>
                    <ScrollViewer MaxHeight="130" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Inputs}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ExpressionTrialInput">
                                    <Grid ColumnDefinitions="160,80,*" Margin="0,2">
                                        <TextBlock Grid.Column="0" Text="{Binding FieldName}" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="1" Text="{Binding TypeName}" Classes="muted" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="2">
                                            <TextBox Text="{Binding Text, Mode=TwoWay}" AutomationProperties.Name="{Binding FieldName}"/>
                                            <TextBlock Text="{Binding Error}" IsVisible="{Binding HasError}" FontSize="11"
                                                       TextWrapping="Wrap" Foreground="{DynamicResource SemiColorDanger}"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <SelectableTextBlock Text="{Binding Result}" IsVisible="{Binding IsFine}" TextWrapping="Wrap"
                                         FontWeight="SemiBold" Foreground="{DynamicResource SemiColorSuccess}"/>
                    <SelectableTextBlock Text="{Binding Result}" IsVisible="{Binding IsProblem}" TextWrapping="Wrap"
                                         FontWeight="SemiBold" Foreground="{DynamicResource SemiColorDanger}"/>
                </StackPanel>
            </Expander>

            <Border DockPanel.Dock="Bottom" Margin="0,8,0,0" Padding="8,6" CornerRadius="4"
                    Background="{DynamicResource SemiColorDangerLight}" IsVisible="{Binding HasError}">
                <SelectableTextBlock Text="{Binding Error}" TextWrapping="Wrap"
                                     Foreground="{DynamicResource SemiColorDanger}"/>
            </Border>

            <Border DockPanel.Dock="Right" Width="320" Margin="10,0,0,0" BorderThickness="1" CornerRadius="4"
                    BorderBrush="{DynamicResource SemiColorBorder}">
                <TreeView x:Name="SymbolTree" ItemsSource="{Binding SymbolGroups}"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          DoubleTapped="OnSymbolDoubleTapped" KeyDown="OnSymbolKeyDown">
                    <TreeView.Styles>
                        <!-- The headings say whether they start open; a name has no IsExpanded and stays closed. -->
                        <Style Selector="TreeViewItem">
                            <Setter Property="IsExpanded" Value="{ReflectionBinding IsExpanded, Mode=OneTime, FallbackValue=False}"/>
                        </Style>
                    </TreeView.Styles>
                    <TreeView.DataTemplates>
                        <TreeDataTemplate DataType="vm:ExpressionSymbolGroup" ItemsSource="{Binding Items}">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                        </TreeDataTemplate>
                        <DataTemplate DataType="vm:ExpressionSymbol">
                            <DockPanel ToolTip.Tip="{Binding Detail}">
                                <TextBlock DockPanel.Dock="Left" Text="{Binding Name}" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding Detail}" Classes="muted" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                        </DataTemplate>
                    </TreeView.DataTemplates>
                </TreeView>
            </Border>

            <Border BorderThickness="1" CornerRadius="4" BorderBrush="{DynamicResource SemiColorBorder}">
                <ae:TextEditor x:Name="Editor" ShowLineNumbers="False" WordWrap="True"
                               FontFamily="ui-monospace, Menlo, Consolas, monospace" FontSize="14"
                               Padding="6,4" Background="Transparent"
                               Foreground="{DynamicResource SemiColorText0}"
                               HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"/>
            </Border>
        </DockPanel>
    </Border>
</Window>
