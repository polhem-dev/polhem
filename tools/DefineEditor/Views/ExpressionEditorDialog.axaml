<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Polhem.DefineEditor.ViewModels"
        xmlns:loc="using:Polhem.DefineEditor.Markup"
        xmlns:ae="using:AvaloniaEdit"
        x:Class="Polhem.DefineEditor.Views.ExpressionEditorDialog"
        x:DataType="vm:ExpressionEditorViewModel"
        x:CompileBindings="True"
        Width="820" Height="540" MinWidth="560" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Title="{Binding Title}">

    <Border Padding="18,16">
        <DockPanel>
            <TextBlock DockPanel.Dock="Top" Classes="muted" TextWrapping="Wrap" Margin="0,0,0,8"
                       Text="{loc:Loc ExpressionEditor_Hint}"/>

            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                        HorizontalAlignment="Right" Spacing="8" Margin="0,14,0,0">
                <Button Classes="tool" Content="{loc:Loc Action_Cancel}" Click="OnCancel" MinWidth="90" IsCancel="True"/>
                <Button Classes="tool Primary" Content="{loc:Loc Action_OK}" Click="OnOk" MinWidth="90"/>
            </StackPanel>

            <StackPanel DockPanel.Dock="Bottom" Spacing="4" Margin="0,10,0,0" IsVisible="{Binding HasMessage}">
                <TextBlock Text="{loc:Loc ExpressionEditor_Message}"/>
                <TextBox Text="{Binding Message, Mode=TwoWay}" AutomationProperties.Name="{loc:Loc ExpressionEditor_Message}"/>
            </StackPanel>

            <Border DockPanel.Dock="Bottom" Margin="0,8,0,0" Padding="8,6" CornerRadius="4"
                    Background="{DynamicResource SemiColorDangerLight}" IsVisible="{Binding HasError}">
                <SelectableTextBlock Text="{Binding Error}" TextWrapping="Wrap"
                                     Foreground="{DynamicResource SemiColorDanger}"/>
            </Border>

            <Grid DockPanel.Dock="Right" Width="270" Margin="10,0,0,0" RowDefinitions="Auto,3*,Auto,2*">
                <TextBlock Grid.Row="0" Classes="muted" Margin="0,0,0,4" Text="{loc:Loc ExpressionEditor_Fields}"/>
                <ListBox Grid.Row="1" x:Name="FieldList" ItemsSource="{Binding Fields}"
                         DoubleTapped="OnSymbolDoubleTapped" KeyDown="OnSymbolKeyDown"
                         AutomationProperties.Name="{loc:Loc ExpressionEditor_Fields}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:ExpressionSymbol">
                            <StackPanel ToolTip.Tip="{Binding Detail}">
                                <TextBlock Text="{Binding Name}"/>
                                <TextBlock Text="{Binding Detail}" Classes="muted" FontSize="11"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Grid.Row="2" Classes="muted" Margin="0,8,0,4" Text="{loc:Loc ExpressionEditor_Functions}"/>
                <ListBox Grid.Row="3" x:Name="FunctionList" ItemsSource="{Binding Functions}"
                         DoubleTapped="OnSymbolDoubleTapped" KeyDown="OnSymbolKeyDown"
                         AutomationProperties.Name="{loc:Loc ExpressionEditor_Functions}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:ExpressionSymbol">
                            <TextBlock Text="{Binding Detail}" TextTrimming="CharacterEllipsis"
                                       ToolTip.Tip="{Binding Detail}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <Border BorderThickness="1" CornerRadius="4" BorderBrush="{DynamicResource SemiColorBorder}">
                <ae:TextEditor x:Name="Editor" ShowLineNumbers="False" WordWrap="True"
                               FontFamily="ui-monospace, Menlo, Consolas, monospace" FontSize="14"
                               Padding="6,4" Background="Transparent"
                               Foreground="{DynamicResource SemiColorText0}"
                               HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"/>
            </Border>
        </DockPanel>
    </Border>
</Window>
