<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Polhem.DefineEditor.ViewModels"
        xmlns:loc="using:Polhem.DefineEditor.Markup"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="760" d:DesignHeight="520"
        x:Class="Polhem.DefineEditor.Views.DatabaseUpgradeWindow"
        x:DataType="vm:DatabaseUpgradeViewModel"
        x:CompileBindings="True"
        Width="760" Height="520" MinWidth="480" MinHeight="320"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Title="{Binding Title}">

    <Border Padding="22,20">
        <DockPanel>
            <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,12">
                <TextBlock Classes="h1" Text="{Binding Title}"/>
                <TextBlock Classes="path" Text="{Binding CommandLine}" TextWrapping="Wrap"/>
                <TextBlock Classes="muted" TextWrapping="Wrap">
                    <Run Text="{loc:Loc Upgrade_WorkingDirectory}"/>
                    <Run Text="{Binding WorkingDirectory}"/>
                </TextBlock>
            </StackPanel>

            <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                <Button DockPanel.Dock="Right" Classes="tool Primary" MinWidth="100"
                        Content="{Binding ActionLabel}" Command="{Binding CancelOrCloseCommand}"/>
                <DockPanel VerticalAlignment="Center" Margin="0,0,12,0">
                    <ProgressBar DockPanel.Dock="Left" IsIndeterminate="True" Width="60" Margin="0,0,8,0"
                                 IsVisible="{Binding IsRunning}"/>
                    <TextBlock x:Name="StatusLine" Text="{Binding StatusText}" TextWrapping="Wrap"
                               VerticalAlignment="Center" FontWeight="SemiBold"
                               Classes.danger="{Binding HasFailed}"/>
                </DockPanel>
            </DockPanel>

            <!-- Fills the window from the start rather than growing with the first lines. -->
            <TextBox x:Name="OutputBox" Classes="code" IsReadOnly="True" AcceptsReturn="True"
                     TextWrapping="NoWrap" Text="{Binding OutputText}"
                     VerticalAlignment="Stretch" VerticalContentAlignment="Top"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
        </DockPanel>
    </Border>

    <Window.Styles>
        <Style Selector="TextBlock.danger">
            <Setter Property="Foreground" Value="{DynamicResource SemiColorDanger}"/>
        </Style>
    </Window.Styles>
</Window>
