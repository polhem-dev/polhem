<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Polhem.DefineEditor.ViewModels"
             xmlns:loc="using:Polhem.DefineEditor.Markup"
             x:Class="Polhem.DefineEditor.Views.TreeCommandBar"
             x:DataType="vm:ObjectTreeDocumentViewModelBase"
             x:CompileBindings="True">

    <!-- The commands of the selected tree node, the same ones its context menu lists, as icon buttons named by their
         tooltips: the Add commands, then Move Up, Move Down, Duplicate and Delete, then the other commands in an
         overflow menu. At the right, Find in tree (Cmd/Ctrl+F); its keys are in TreeCommandBar.OnFindKeyDown. -->
    <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" Margin="12,0,0,0">
            <Button Classes="toolbar-icon" Command="{Binding UndoCommand}"
                    ToolTip.Tip="{Binding UndoToolTip}" AutomationProperties.Name="{loc:Loc Action_Undo}">
                <PathIcon Data="{StaticResource IconUndo}"/>
            </Button>
            <Button Classes="toolbar-icon" Command="{Binding RedoCommand}"
                    ToolTip.Tip="{Binding RedoToolTip}" AutomationProperties.Name="{loc:Loc Action_Redo}">
                <PathIcon Data="{StaticResource IconRedo}"/>
            </Button>
            <TextBlock Classes="muted" VerticalAlignment="Center" Text="{Binding TreeFindStatus}"/>
            <TextBox x:Name="FindBox" Width="190" Classes="clearButton search-box"
                     Text="{Binding TreeFindText, Mode=TwoWay}"
                     PlaceholderText="{Binding TreeFindWatermark}"
                     AutomationProperties.Name="{loc:Loc TreeFind_Watermark}"
                     KeyDown="OnFindKeyDown" TextChanged="OnFindTextChanged">
                <TextBox.InnerLeftContent>
                    <PathIcon Classes="search-box-icon" Data="{StaticResource IconSearch}"/>
                </TextBox.InnerLeftContent>
            </TextBox>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="2">
            <ItemsControl ItemsSource="{Binding ToolbarAddItems}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="2"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:TreeToolbarItem">
                        <Button Classes="toolbar-icon" Command="{Binding Command}" IsEnabled="{Binding IsEnabled}"
                                ToolTip.Tip="{Binding ToolTip}" AutomationProperties.Name="{Binding Label}">
                            <PathIcon Data="{Binding IconKey, Converter={StaticResource IconKeyToGeometry}}"/>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <ItemsControl ItemsSource="{Binding ToolbarEditItems}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="2"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:TreeToolbarItem">
                        <Button Classes="toolbar-icon" Command="{Binding Command}" IsEnabled="{Binding IsEnabled}"
                                ToolTip.Tip="{Binding ToolTip}" AutomationProperties.Name="{Binding Label}">
                            <PathIcon Data="{Binding IconKey, Converter={StaticResource IconKeyToGeometry}}"/>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button x:Name="MoreButton" Classes="toolbar-icon" IsVisible="{Binding HasToolbarActions}"
                    ToolTip.Tip="{loc:Loc TreeCommandBar_MoreActions}"
                    AutomationProperties.Name="{loc:Loc TreeCommandBar_MoreActions}">
                <PathIcon Data="{StaticResource IconMore}"/>
                <Button.Flyout>
                    <!-- Filled from ToolbarActionItems whenever they change (FillMoreFlyout). -->
                    <MenuFlyout Placement="BottomEdgeAlignedLeft"/>
                </Button.Flyout>
            </Button>
        </StackPanel>
    </DockPanel>
</UserControl>
