<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Polhem.DefineEditor.ViewModels"
             xmlns:loc="using:Polhem.DefineEditor.Markup"
             x:Class="Polhem.DefineEditor.Views.TreeCommandBar"
             x:DataType="vm:ObjectTreeDocumentViewModelBase"
             x:CompileBindings="True">

    <!-- The commands of the selected tree node, the same ones its context menu lists: Add buttons with their text,
         since they are what a newcomer looks for, then Delete, then the other commands in an overflow menu. -->
    <StackPanel Orientation="Horizontal" Spacing="2">
        <ItemsControl ItemsSource="{Binding ToolbarAddItems}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="2"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:TreeToolbarItem">
                    <Button Classes="toolbar-icon toolbar-labeled" Command="{Binding Command}"
                            IsEnabled="{Binding IsEnabled}"
                            ToolTip.Tip="{Binding Label}" AutomationProperties.Name="{Binding Label}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{Binding IconKey, Converter={StaticResource IconKeyToGeometry}}"/>
                            <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Button Classes="toolbar-icon" IsVisible="{Binding ToolbarDeleteItem, Converter={x:Static ObjectConverters.IsNotNull}}"
                Command="{Binding ToolbarDeleteItem.Command, FallbackValue={x:Null}}"
                IsEnabled="{Binding ToolbarDeleteItem.IsEnabled, FallbackValue=False}"
                ToolTip.Tip="{Binding ToolbarDeleteItem.Label, FallbackValue={x:Null}}"
                AutomationProperties.Name="{Binding ToolbarDeleteItem.Label, FallbackValue={x:Null}}">
            <PathIcon Data="{StaticResource IconDelete}"/>
        </Button>

        <Button x:Name="MoreButton" Classes="toolbar-icon" IsVisible="{Binding HasToolbarActions}"
                ToolTip.Tip="{loc:Loc TreeCommandBar_MoreActions}"
                AutomationProperties.Name="{loc:Loc TreeCommandBar_MoreActions}">
            <PathIcon Data="{StaticResource IconMore}"/>
            <Button.Flyout>
                <!-- Filled from ToolbarActionItems each time it opens (OnMoreFlyoutOpening). -->
                <MenuFlyout Placement="BottomEdgeAlignedLeft" Opening="OnMoreFlyoutOpening"/>
            </Button.Flyout>
        </Button>
    </StackPanel>
</UserControl>
