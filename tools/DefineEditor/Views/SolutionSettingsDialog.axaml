<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Polhem.DefineEditor.ViewModels"
        xmlns:loc="using:Polhem.DefineEditor.Markup"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="380"
        x:Class="Polhem.DefineEditor.Views.SolutionSettingsDialog"
        x:DataType="vm:SolutionSettingsDialogViewModel"
        x:CompileBindings="True"
        Width="600" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False"
        Title="{loc:Loc SolutionSettings_Title}">

    <Border Padding="22,20">
        <DockPanel>
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                        HorizontalAlignment="Right" Spacing="8" Margin="0,16,0,0">
                <Button Classes="tool" Content="{loc:Loc Action_Cancel}" Click="OnCancel" MinWidth="90"/>
                <Button Classes="tool Primary" Content="{loc:Loc Action_Save}" Command="{Binding ApplyCommand}" MinWidth="100"/>
            </StackPanel>

            <StackPanel Spacing="6">
                <TextBlock Classes="h1" Text="{loc:Loc SolutionSettings_UpgradeSection}"/>
                <TextBlock Classes="muted" TextWrapping="Wrap" Text="{loc:Loc SolutionSettings_UpgradeHint}"/>

                <TextBlock Text="{loc:Loc SolutionSettings_Command}" Margin="0,8,0,0"/>
                <TextBox x:Name="CommandBox" Text="{Binding Command, Mode=TwoWay}" PlaceholderText="dotnet"/>

                <TextBlock Text="{loc:Loc SolutionSettings_Arguments}" Margin="0,4,0,0"/>
                <TextBox Text="{Binding ArgumentsText, Mode=TwoWay}"
                         PlaceholderText="run --project ../MyApp.Server -- db upgrade"/>

                <TextBlock Text="{loc:Loc SolutionSettings_WorkingDirectory}" Margin="0,4,0,0"/>
                <TextBox Text="{Binding WorkingDirectory, Mode=TwoWay}" PlaceholderText=".."/>
                <TextBlock Classes="muted" TextWrapping="Wrap" Text="{loc:Loc SolutionSettings_WorkingDirectoryHint}"/>

                <TextBlock IsVisible="{Binding HasSecret}" TextWrapping="Wrap" Margin="0,6,0,0"
                           Foreground="{DynamicResource SemiColorWarning}" Text="{loc:Loc SolutionSettings_SecretWarning}"/>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
