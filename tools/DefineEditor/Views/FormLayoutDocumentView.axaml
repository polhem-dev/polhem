<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Polhem.DefineEditor.ViewModels"
             xmlns:loc="using:Polhem.DefineEditor.Markup"
             xmlns:views="using:Polhem.DefineEditor.Views"
             xmlns:models="using:Polhem.DefineEditor.Models"
             xmlns:controls="using:Polhem.UI.Avalonia.Controls"
             xmlns:conv="using:Polhem.DefineEditor.Converters"
             xmlns:layouts="using:Polhem.Definition.Layouts"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="Polhem.DefineEditor.Views.FormLayoutDocumentView"
             x:DataType="vm:FormLayoutDocumentViewModel"
             x:CompileBindings="True">

    <DockPanel>

        <!-- What the right-hand side shows. Each option is a button of its own, so the macOS accessibility API can
             press it (AXPress) without opening a menu first. -->
        <Border DockPanel.Dock="Top" Padding="8,6">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4">
                    <Button Classes="tool pane-layout" Classes.selected="{Binding IsPropertiesAndPreviewLayout}"
                            Command="{Binding SetPaneLayoutCommand}" CommandParameter="{x:Static vm:FormLayoutPaneLayout.PropertiesAndPreview}"
                            ToolTip.Tip="{loc:Loc FormLayout_PaneLayout_PropertiesAndPreview}"
                            AutomationProperties.Name="{loc:Loc FormLayout_PaneLayout_PropertiesAndPreview}">
                        <PathIcon Data="{StaticResource IconPaneBoth}"/>
                    </Button>
                    <Button Classes="tool pane-layout" Classes.selected="{Binding IsPreviewOnlyLayout}"
                            Command="{Binding SetPaneLayoutCommand}" CommandParameter="{x:Static vm:FormLayoutPaneLayout.PreviewOnly}"
                            ToolTip.Tip="{loc:Loc FormLayout_PaneLayout_PreviewOnly}"
                            AutomationProperties.Name="{loc:Loc FormLayout_PaneLayout_PreviewOnly}">
                        <PathIcon Data="{StaticResource IconPanePreview}"/>
                    </Button>
                    <Button Classes="tool pane-layout" Classes.selected="{Binding IsPropertiesOnlyLayout}"
                            Command="{Binding SetPaneLayoutCommand}" CommandParameter="{x:Static vm:FormLayoutPaneLayout.PropertiesOnly}"
                            ToolTip.Tip="{loc:Loc FormLayout_PaneLayout_PropertiesOnly}"
                            AutomationProperties.Name="{loc:Loc FormLayout_PaneLayout_PropertiesOnly}">
                        <PathIcon Data="{StaticResource IconPaneProperties}"/>
                    </Button>
                    <!-- Not a layout of this window, so it stands apart from the three above. -->
                    <Button Classes="tool" Margin="12,0,0,0" Command="{Binding OpenInBrowserCommand}"
                            ToolTip.Tip="{loc:Loc FormLayout_OpenInBrowserTooltip}"
                            AutomationProperties.Name="{loc:Loc FormLayout_OpenInBrowser}">
                        <PathIcon Data="{StaticResource IconBrowser}"/>
                    </Button>
                </StackPanel>
                <Button Classes="tool" HorizontalAlignment="Left" Command="{Binding EditPropertiesCommand}"
                        IsVisible="{Binding !IsPropertyPaneVisible}"
                        ToolTip.Tip="{loc:Loc FormLayout_EditPropertiesTooltip}"
                        AutomationProperties.Name="{loc:Loc FormLayout_EditProperties}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="{StaticResource IconSettings}"/>
                        <TextBlock Text="{loc:Loc FormLayout_EditProperties}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Classes="statusbar" Padding="12,5">
            <TextBlock Classes="muted" Text="{Binding StatusText}" TextTrimming="CharacterEllipsis"/>
        </Border>

        <Border DockPanel.Dock="Bottom" Classes="surface-sunken" Padding="12,8" IsVisible="{Binding Issues.Count}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Classes="h2" Text="{loc:Loc Section_ValidationResults}"/>
                <ListBox ItemsSource="{Binding Issues}" MaxHeight="160" Background="Transparent" BorderThickness="0" Margin="0,6,0,0">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="models:ValidationIssue">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding Icon}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Path}" Classes="muted" Width="240"/>
                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <Grid ColumnDefinitions="*,4,1.2*">
            <controls:ObjectTreeView Grid.Column="0" RootNode="{Binding RootNode}" CommandProvider="{Binding CommandProvider}" DragDropHandler="{Binding DragDropHandler}"
                                     IconSelector="{Binding IconKeys, Converter={x:Static conv:TreeIconSelector.Converter}}"
                                     SelectedItem="{Binding SelectedTreeNode, Mode=TwoWay}" Padding="6,4"/>
            <GridSplitter Grid.Column="1" ResizeDirection="Columns"/>
            <Grid x:Name="RightPane" Grid.Column="2" RowDefinitions="*,4,*">
                <views:EditorPane Grid.Row="0" Context="{Binding SelectedEditorContext}" IsVisible="{Binding IsPropertyPaneVisible}"/>
                <GridSplitter x:Name="PreviewSplitter" Grid.Row="1" ResizeDirection="Rows">
                    <GridSplitter.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="IsPreviewVisible"/>
                            <Binding Path="IsPropertiesAndPreviewLayout"/>
                        </MultiBinding>
                    </GridSplitter.IsVisible>
                </GridSplitter>
                <views:FormLayoutPreview Grid.Row="2" IsVisible="{Binding IsPreviewPaneVisible}"/>
            </Grid>
        </Grid>
    </DockPanel>
</UserControl>
