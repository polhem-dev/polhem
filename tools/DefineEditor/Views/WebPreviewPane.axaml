<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Polhem.DefineEditor.ViewModels"
             xmlns:loc="using:Polhem.DefineEditor.Markup"
             x:Class="Polhem.DefineEditor.Views.WebPreviewPane"
             x:DataType="vm:FormLayoutDocumentViewModel"
             x:CompileBindings="True">

    <Panel>
        <!-- The web view is created in code, and only after the engine check passes. -->
        <Panel x:Name="WebViewHost"/>
        <StackPanel x:Name="MessagePanel" IsVisible="False" Margin="12" Spacing="8">
            <TextBlock x:Name="MessageText" TextWrapping="Wrap" Foreground="{DynamicResource SemiColorDanger}"/>
            <Button Content="{loc:Loc FormLayout_OpenInBrowser}" Command="{Binding OpenInBrowserCommand}"
                    HorizontalAlignment="Left"/>
        </StackPanel>
    </Panel>
</UserControl>
