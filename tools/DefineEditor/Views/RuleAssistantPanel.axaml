<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Polhem.DefineEditor.ViewModels"
             xmlns:views="using:Polhem.DefineEditor.Views"
             xmlns:loc="using:Polhem.DefineEditor.Markup"
             xmlns:md="using:Polhem.Markdown.Avalonia"
             xmlns:chat="using:Polhem.Chat.Avalonia"
             x:Class="Polhem.DefineEditor.Views.RuleAssistantPanel"
             x:DataType="vm:RuleAssistantViewModel"
             x:CompileBindings="True">
    <UserControl.Styles>
        <Style Selector="Border.proposal">
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SemiColorBorder}"/>
            <Setter Property="Background" Value="{DynamicResource SemiColorBackground0}"/>
        </Style>
    </UserControl.Styles>
    <!-- The whole panel is the conversation, so the prompt box always sits at its foot. Each drafted or explained rule is
         a card in it, after the reply of its turn. -->
    <Border Classes="surface-sunken" BorderThickness="1" CornerRadius="4" ClipToBounds="True"
            BorderBrush="{DynamicResource SemiColorBorder}">
        <chat:ChatView x:Name="Chat" Conversation="{Binding Conversation}" IsGenerating="{Binding IsBusy}"
                       IsEnabled="{Binding IsAvailable}"
                       PromptSubmitted="OnPromptSubmitted" StopRequested="OnStopRequested">
            <chat:ChatView.HeaderContent>
                <StackPanel Spacing="6" Margin="10,8">
                    <TextBlock Classes="muted" FontSize="11" TextWrapping="Wrap" Text="{Binding CredentialText}"/>
                    <WrapPanel>
                        <Button Classes="tool" Margin="0,0,6,0" Command="{Binding ExplainCommand}"
                                Content="{loc:Loc RuleAssistant_Explain}" ToolTip.Tip="{loc:Loc RuleAssistant_ExplainTip}"/>
                        <Button Classes="tool" Command="{Binding NewConversationCommand}"
                                Content="{loc:Loc RuleAssistant_NewConversation}"
                                ToolTip.Tip="{loc:Loc RuleAssistant_NewConversationTip}"/>
                    </WrapPanel>
                </StackPanel>
            </chat:ChatView.HeaderContent>
            <chat:ChatView.DataTemplates>
                <!-- A card keeps what it showed when it was added. Only the newest card of a draft edits the message and
                     applies it; those parts bind to the assistant, which holds the draft. -->
                <DataTemplate DataType="vm:RuleProposalEntry">
                    <Border Classes="proposal">
                        <StackPanel Spacing="8">
                            <!-- The no-image options: see RuleAssistantPanel.ExplanationOptions. -->
                            <md:MarkdownViewer Markdown="{Binding Explanation}"
                                               Options="{x:Static views:RuleAssistantPanel.ExplanationOptions}"
                                               LinkForeground="{DynamicResource SemiColorLink}"
                                               RuleBrush="{DynamicResource SemiColorBorder}"
                                               CopyCodeLabel="{loc:Loc Drafting_Copy}"/>
                            <Border Padding="8,6" CornerRadius="4" Background="{DynamicResource SemiColorFill0}"
                                    IsVisible="{Binding IsDraft}">
                                <SelectableTextBlock Text="{Binding RuleText}" TextWrapping="Wrap" FontSize="12"
                                                     FontFamily="ui-monospace, Menlo, Consolas, monospace"/>
                            </Border>
                            <TextBlock FontWeight="SemiBold" Text="{loc:Loc RuleAssistant_Samples}"/>
                            <ItemsControl ItemsSource="{Binding Samples}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:RuleAssistantSample">
                                        <Grid ColumnDefinitions="56,*" Margin="0,3">
                                            <Border Grid.Column="0" VerticalAlignment="Top" CornerRadius="3" Padding="4,1"
                                                    HorizontalAlignment="Left" Classes.passes="{Binding Passes}"
                                                    Classes.blocked="{Binding IsBlocked}" Classes.skipped="{Binding IsSkipped}">
                                                <TextBlock Text="{Binding OutcomeText}" FontSize="11" Foreground="White"/>
                                            </Border>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Values}" TextWrapping="Wrap" Classes="muted" FontSize="11"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Classes="muted" FontSize="11" TextWrapping="Wrap"
                                       Text="{loc:Loc RuleAssistant_Superseded}">
                                <TextBlock.IsVisible>
                                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                                        <Binding Path="IsDraft"/>
                                        <Binding Path="!IsCurrent"/>
                                    </MultiBinding>
                                </TextBlock.IsVisible>
                            </TextBlock>
                            <StackPanel Spacing="4" IsVisible="{Binding CanApplyHere}">
                                <TextBlock FontWeight="SemiBold" Text="{loc:Loc RuleAssistant_Message}"/>
                                <TextBox Text="{Binding Assistant.Message, Mode=TwoWay}" TextWrapping="Wrap"
                                         AutomationProperties.Name="{loc:Loc RuleAssistant_Message}"/>
                                <ItemsControl ItemsSource="{Binding Assistant.Translations}"
                                              IsVisible="{Binding Assistant.HasTranslations}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:RuleMessageTranslation">
                                            <Grid ColumnDefinitions="56,*" Margin="0,2">
                                                <TextBlock Text="{Binding Language}" VerticalAlignment="Center" Classes="muted"/>
                                                <TextBox Grid.Column="1" Text="{Binding Text, Mode=TwoWay}" TextWrapping="Wrap"
                                                         AutomationProperties.Name="{Binding Language}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Classes="muted" FontSize="11" TextWrapping="Wrap"
                                           Text="{loc:Loc RuleAssistant_TranslationsHint}"
                                           IsVisible="{Binding Assistant.HasTranslations}"/>
                                <Button Classes="tool Primary" HorizontalAlignment="Right" Margin="0,4,0,0"
                                        Command="{Binding Assistant.ApplyCommand}"
                                        Content="{loc:Loc RuleAssistant_Apply}" ToolTip.Tip="{loc:Loc RuleAssistant_ApplyTip}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </chat:ChatView.DataTemplates>
        </chat:ChatView>
    </Border>
</UserControl>
