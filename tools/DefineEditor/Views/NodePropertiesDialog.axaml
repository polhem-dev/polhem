<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Polhem.DefineEditor.ViewModels"
        xmlns:loc="using:Polhem.DefineEditor.Markup"
        xmlns:views="using:Polhem.DefineEditor.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="520" d:DesignHeight="560"
        x:Class="Polhem.DefineEditor.Views.NodePropertiesDialog"
        x:DataType="vm:ObjectTreeDocumentViewModelBase"
        x:CompileBindings="True"
        Width="520" Height="560" MinWidth="360" MinHeight="300"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <DockPanel>
        <Border DockPanel.Dock="Bottom" Classes="statusbar" Padding="12,8">
            <Button x:Name="CloseButton" Classes="tool Primary" HorizontalAlignment="Right" MinWidth="90"
                    Content="{loc:Loc Action_Close}" Click="OnClose"/>
        </Border>
        <views:EditorPane x:Name="Pane" Context="{Binding SelectedEditorContext}"
                          PropertyFilter="{Binding SelectedPropertyFilter}"
                          ValueSuggestionProvider="{Binding ValueSuggestionProvider}"
                          CollectionEditorProvider="{Binding CollectionEditorProvider}"
                          ValueEditorProvider="{Binding ValueEditorProvider}"/>
    </DockPanel>
</Window>
