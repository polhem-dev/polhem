<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Polhem.DefineEditor.ViewModels"
        xmlns:loc="using:Polhem.DefineEditor.Markup"
        x:Class="Polhem.DefineEditor.Views.FieldPickerDialog"
        x:DataType="vm:FieldPickerViewModel"
        x:CompileBindings="True"
        Width="460" Height="520" MinWidth="360" MinHeight="320"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Title="{Binding PropertyName}">

    <Border Padding="18,16">
        <DockPanel>
            <TextBlock DockPanel.Dock="Top" Classes="muted" TextWrapping="Wrap" Margin="0,0,0,8"
                       Text="{loc:Loc FieldPicker_Hint}"/>

            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                        HorizontalAlignment="Right" Spacing="8" Margin="0,14,0,0">
                <Button Classes="tool" Content="{loc:Loc Action_Cancel}" Click="OnCancel" MinWidth="90" IsCancel="True"/>
                <Button Classes="tool Primary" Content="{loc:Loc Action_OK}" Click="OnOk" MinWidth="90" IsDefault="True"/>
            </StackPanel>

            <StackPanel DockPanel.Dock="Right" Spacing="4" Margin="8,0,0,0">
                <Button Classes="toolbar-icon" Command="{Binding MoveUpCommand}"
                        ToolTip.Tip="{loc:Loc Action_MoveUp}" AutomationProperties.Name="{loc:Loc Action_MoveUp}">
                    <PathIcon Data="{StaticResource IconArrowUp}"/>
                </Button>
                <Button Classes="toolbar-icon" Command="{Binding MoveDownCommand}"
                        ToolTip.Tip="{loc:Loc Action_MoveDown}" AutomationProperties.Name="{loc:Loc Action_MoveDown}">
                    <PathIcon Data="{StaticResource IconArrowDown}"/>
                </Button>
            </StackPanel>

            <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:FieldPickerItem">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" VerticalAlignment="Center"
                                      AutomationProperties.Name="{Binding Name}"/>
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Caption}" Classes="muted" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </Border>
</Window>
