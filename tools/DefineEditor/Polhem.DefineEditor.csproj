<Project Sdk="Microsoft.NET.Sdk">

  <!-- Package metadata shared with the src/ packages: icon, license, repository, SourceLink, symbols. -->
  <Import Project="..\..\Package.props" />

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>

    <!--
      dotnet tool packaging, so a project can pin the editor in its tool manifest and open its definitions with
      `dotnet polhem-define Define`. Overrides tools/Directory.Build.props (IsPackable=false).
      Unlike Polhem.Cli it does not turn on the strict settings of src/: it is an application nobody compiles
      against, so it has no public API or XML documentation to guard.
    -->
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>polhem-define</ToolCommandName>
    <PackageId>Polhem.DefineEditor</PackageId>
    <PackageOutputPath>../../nupkgs</PackageOutputPath>
    <!-- Keep only the desktop runtimes' native libraries in the tool package (tools/Directory.Build.targets). -->
    <PolhemKeepDesktopNativeRuntimes>true</PolhemKeepDesktopNativeRuntimes>
    <Description>Polhem DefineEditor, the desktop editor for Polhem definition files, as a dotnet tool invoked as `polhem-define [DefinePath]`. Imports forms from Excel workbooks and runs the project's database upgrade command.</Description>
    <PackageTags>polhem;defineeditor;dotnet-tool;defines;excel;avalonia</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>


  <ItemGroup>
    <!-- Assets/brand holds the SVG sources of the icons, which scripts/build-icon.swift reads; the app does not. -->
    <AvaloniaResource Include="Assets\**" Exclude="Assets\brand\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
    <PackageReference Include="Semi.Avalonia" Version="12.1.0.1" />
    <!-- The layout preview draws detail grids; without a DataGrid theme they render nothing at all. -->
    <PackageReference Include="Semi.Avalonia.DataGrid" Version="12.1.0.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.3" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- References the core definition model and XmlCodec directly (not through NuGet), so no serialization conversion is needed. -->
    <ProjectReference Include="..\..\src\Polhem.Definition\Polhem.Definition.csproj" />
    <ProjectReference Include="..\..\src\Polhem.Core\Polhem.Core.csproj" />
    <!-- Excel export and import of FormSchema, and the FormSchema validator shared with the CLI. -->
    <ProjectReference Include="..\Polhem.Definition.Spreadsheet\Polhem.Definition.Spreadsheet.csproj" />
    <!-- The CREATE TABLE preview of the TableSchema editor uses the framework's own dialect builders. Polhem.Db brings
         no database driver; it depends on Polhem.Definition only. -->
    <ProjectReference Include="..\..\src\Polhem.Db\Polhem.Db.csproj" />
    <!-- Brings the framework's Avalonia controls (ObjectTreeView). It also carries Polhem.Api.Client and Polhem.Expressions,
         which the editor needs for remote define access and design-time expression checks. -->
    <ProjectReference Include="..\..\src\Polhem.UI.Avalonia\Polhem.UI.Avalonia.csproj" />
  </ItemGroup>
</Project>
