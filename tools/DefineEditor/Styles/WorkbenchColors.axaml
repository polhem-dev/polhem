<!-- The DefineEditor-only workbench colours, from VS Code's "Dark (Visual Studio)" and "Light (Visual Studio)" themes.
     The Semi palette colours of those themes are Polhem.UI.Avalonia's VisualStudioTheme, applied in App.axaml.cs. -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <!-- sideBar.background; activityBar.background, activityBar.foreground, activityBar.inactiveForeground -->
            <SolidColorBrush x:Key="SidebarBackground">#252526</SolidColorBrush>
            <SolidColorBrush x:Key="ActivityBarBackground">#333333</SolidColorBrush>
            <SolidColorBrush x:Key="ActivityBarForeground">#FFFFFF</SolidColorBrush>
            <SolidColorBrush x:Key="ActivityBarInactiveForeground">#66FFFFFF</SolidColorBrush>
            <!-- Icon buttons and toggles on document toolbars: icon.foreground, toolbar.hoverBackground and
                 inputOption.activeBackground / activeBorder / activeForeground -->
            <SolidColorBrush x:Key="ToolbarIconForeground">#CCCCCC</SolidColorBrush>
            <SolidColorBrush x:Key="ToolbarIconHoverBackground">#505A5D5E</SolidColorBrush>
            <SolidColorBrush x:Key="ToolbarIconActiveBackground">#822489DB</SolidColorBrush>
            <SolidColorBrush x:Key="ToolbarIconActiveBorder">#2488DB</SolidColorBrush>
            <SolidColorBrush x:Key="ToolbarIconActiveForeground">#FFFFFF</SolidColorBrush>
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="SidebarBackground">#F3F3F3</SolidColorBrush>
            <!-- The Light (Visual Studio) theme keeps a dark activity bar -->
            <SolidColorBrush x:Key="ActivityBarBackground">#2C2C2C</SolidColorBrush>
            <SolidColorBrush x:Key="ActivityBarForeground">#FFFFFF</SolidColorBrush>
            <SolidColorBrush x:Key="ActivityBarInactiveForeground">#66FFFFFF</SolidColorBrush>
            <SolidColorBrush x:Key="ToolbarIconForeground">#424242</SolidColorBrush>
            <SolidColorBrush x:Key="ToolbarIconHoverBackground">#50B8B8B8</SolidColorBrush>
            <SolidColorBrush x:Key="ToolbarIconActiveBackground">#BED6ED</SolidColorBrush>
            <SolidColorBrush x:Key="ToolbarIconActiveBorder">#005FB8</SolidColorBrush>
            <SolidColorBrush x:Key="ToolbarIconActiveForeground">#005FB8</SolidColorBrush>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
