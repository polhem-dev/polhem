<Project>

  <!--
    POLHEM9002: the three version properties must agree; the definition is shared with src/.

    tools/ needs this gate for the same reason as src/, only more directly: Polhem.Cli is published to NuGet,
    and the publish workflow overrides the package version with /p:Version=<tag> but does not override
    AssemblyVersion / FileVersion. With the version coming from Version.props, this target catches the case
    where a command-line override makes a single project contradict itself.
  -->
  <Import Project="$(MSBuildThisFileDirectory)../Version.targets" />

  <!--
    A RID-agnostic dotnet tool carries the native libraries (SkiaSharp, HarfBuzzSharp, e_sqlite3, SNI and others) of
    every runtime its packages support. With all of them the DefineEditor package was 197 MB, near the 250 MB limit
    of nuget.org, and most of it was for runtimes a desktop developer never runs on, or debug symbols of native Windows
    libraries. A tool that sets PolhemKeepDesktopNativeRuntimes keeps the native libraries of macOS and the 64-bit Windows
    and Linux (glibc and musl) runtimes, without those symbols; the rest is dropped from the build output and from the deps file alike.
  -->
  <PropertyGroup>
    <_PolhemDesktopNativeRuntimes>;osx;osx-arm64;osx-x64;win-x64;win-arm64;linux-x64;linux-arm64;linux-musl-x64;linux-musl-arm64;</_PolhemDesktopNativeRuntimes>
  </PropertyGroup>
  <Target Name="KeepDesktopNativeRuntimes" AfterTargets="ResolvePackageAssets"
          Condition="'$(PolhemKeepDesktopNativeRuntimes)' == 'true'">
    <ItemGroup>
      <!-- Native assets only: a RID-specific managed assembly (Microsoft.Data.SqlClient's runtimes/unix/lib) is the
           real implementation on that platform, and without it the reference stub runs instead. -->
      <RuntimeTargetsCopyLocalItems Remove="@(RuntimeTargetsCopyLocalItems)"
          Condition="'%(RuntimeTargetsCopyLocalItems.AssetType)' == 'native'
                     and (!$(_PolhemDesktopNativeRuntimes.Contains(';%(RuntimeTargetsCopyLocalItems.RuntimeIdentifier);'))
                          or '%(RuntimeTargetsCopyLocalItems.Extension)' == '.pdb')" />
    </ItemGroup>
  </Target>

</Project>
