<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RootNamespace>Polhem.LoadTests</RootNamespace>
    <!--
      No PackageReference by design. NBomber 6.x is commercially licensed (organisations
      need a paid subscription and an activation key), which does not fit a public MIT
      repository whose load-testing method is meant to be usable by anyone who clones it.
      Scheduling, timing and percentile statistics are written here against the BCL.
    -->
  </PropertyGroup>

  <ItemGroup>
    <!-- Copied to output so a run can start from it, and so the test project can assert
         that the shipped sample actually parses and validates. -->
    <Content Include="loadtest.sample.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!-- ADO.NET drivers, one per engine a run can target. Not an exception to the "no
         load-testing framework" rule: in Local mode this project is the host, and Polhem.Db
         references no driver because choosing them is the host's decision. Comparing engines is
         the point of having them all here. Logging comes from the ASP.NET Core framework
         reference below, which a bare ServiceCollection also draws on for AddLogging. -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="MySqlConnector" Version="2.6.2" />
    <PackageReference Include="Oracle.ManagedDataAccess.Core" Version="23.26.301" />
  </ItemGroup>

  <ItemGroup>
    <!-- The 'serve' command hosts the JSON-RPC endpoint so a Remote run has something to measure
         against; every host in this repository is SQLite-only, which a load test excludes. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Polhem.Api.Client\Polhem.Api.Client.csproj" />
    <ProjectReference Include="..\..\src\Polhem.Db\Polhem.Db.csproj" />
    <ProjectReference Include="..\..\src\Polhem.Definition\Polhem.Definition.csproj" />
    <ProjectReference Include="..\..\src\Polhem.Hosting\Polhem.Hosting.csproj" />
    <ProjectReference Include="..\..\src\Polhem.ObjectCaching\Polhem.ObjectCaching.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Polhem.LoadTests.UnitTests" />
  </ItemGroup>

  <!-- Polhem.JsonRpc.AspNetCore serves the endpoint. PolhemJsonRpcSource switches to a local checkout; see
       PolhemJsonRpc.props. -->
  <Import Project="..\..\PolhemJsonRpc.props" />
  <ItemGroup Condition="'$(PolhemJsonRpcSource)' == ''">
    <PackageReference Include="Polhem.JsonRpc.AspNetCore" Version="$(PolhemJsonRpcVersion)" />
  </ItemGroup>
  <ItemGroup Condition="'$(PolhemJsonRpcSource)' != ''">
    <ProjectReference Include="$(PolhemJsonRpcSource)/src/Polhem.JsonRpc.AspNetCore/Polhem.JsonRpc.AspNetCore.csproj" />
  </ItemGroup>

</Project>
