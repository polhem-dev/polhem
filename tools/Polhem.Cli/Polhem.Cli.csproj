<Project Sdk="Microsoft.NET.Sdk">

  <!-- Package metadata shared with the src/ packages: icon, license, repository, SourceLink, symbols. -->
  <Import Project="..\..\Package.props" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Polhem.Cli</RootNamespace>
    <AssemblyName>dotnet-polhem</AssemblyName>

    <!-- dotnet tool packaging. Overrides tools/Directory.Build.props (IsPackable=false). -->
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>dotnet-polhem</ToolCommandName>
    <PackageId>Polhem.Cli</PackageId>
    <PackageOutputPath>../../nupkgs</PackageOutputPath>

    <!--
      Version comes from Version.props at the repository root, by way of
      tools/Directory.Build.props. It used to be hardcoded here with a comment saying to bump it
      alongside the framework; that requirement had no way to notice it had been broken, and it
      stayed at 4.8.0 for twelve minor versions while every published Polhem.Cli carried an assembly
      stamped 4.8.0.0. Do not reintroduce a local copy.
    -->

    <!-- Published like the src/ packages, so it keeps their strictness even though tools/ opts out of it. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- Required by EnforceCodeStyleInBuild for IDE0005 (unnecessary usings) to run during the build. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <Description>Polhem framework CLI, a dotnet tool invoked as `dotnet polhem`. Writes out and lists the default definition files embedded in Polhem.Definition, and migrates a ProgramSettings.xml that still carries its menu into a flat registry plus MenuSettings.xml.</Description>
    <PackageTags>polhem;cli;dotnet-tool;defines</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <!-- ProjectReference works for dotnet tool packaging: referenced DLLs are included in the tool package. -->
    <ProjectReference Include="..\..\src\Polhem.Definition\Polhem.Definition.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Polhem.Cli.UnitTests" />
  </ItemGroup>

</Project>
