<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <Description>The host-independent and UI-framework-independent layer of the Polhem Blazor head: form data objects, field editor bases and the user context.</Description>
    <PackageTags>polhem;blazor;rcl;ui</PackageTags>
    <!-- RS0041 fires only on the Razor-generated BuildRenderTree overrides, as in Polhem.Web.Blazor.Server. -->
    <NoWarn>$(NoWarn);RS0041</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Polhem.Web.Blazor.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Not the Microsoft.AspNetCore.App framework reference: that cannot load in WebAssembly. POLHEM9001 enforces it. -->
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Polhem.Api.Client\Polhem.Api.Client.csproj" />
    <ProjectReference Include="..\Polhem.UI.Core\Polhem.UI.Core.csproj" />
    <ProjectReference Include="..\Polhem.Expressions\Polhem.Expressions.csproj" />
  </ItemGroup>

</Project>
