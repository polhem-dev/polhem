@namespace Polhem.Web.Blazor.Controls
@implements IGridEditorSlot
@implements IAsyncDisposable
@using Microsoft.JSInterop
@using System.Data
@using Polhem.Definition.Layouts

@* A cell shows text until it takes the focus, because an editor in every cell costs too much on a circuit. *@
@if (ReferenceEquals(Host.Active, this))
{
    <div @ref="_editor" class="polhem-grid-cell__editor"><DynamicComponent Type="EditorType" Parameters="EditorParameters()" /></div>
}
else
{
    <div class="@TextClass" tabindex="0" @onfocus="OnFocus">
        @if (IsCheck)
        {
            <input type="checkbox" disabled checked="@IsChecked" tabindex="-1" />
        }
        else
        {
            @Text
        }
    </div>
}

@code {
    private ElementReference _editor;
    private bool _focusEditor;
    private bool _ignoreFocus;
    private Microsoft.JSInterop.DotNetObjectReference<GridEditorCell>? _self;

    /// <summary>Gets or sets the host that keeps one editor open in the grid.</summary>
    [Parameter, EditorRequired]
    public GridEditorHost Host { get; set; } = default!;

    /// <summary>Gets or sets the grid's script module.</summary>
    [Parameter, EditorRequired]
    public GridEditorScript Script { get; set; } = default!;

    /// <summary>Gets or sets the editor component.</summary>
    [Parameter, EditorRequired]
    public Type EditorType { get; set; } = default!;

    /// <summary>Gets or sets the row the cell edits.</summary>
    [Parameter, EditorRequired]
    public DataRow Row { get; set; } = default!;

    /// <summary>Gets or sets the column the cell edits.</summary>
    [Parameter, EditorRequired]
    public LayoutColumn Column { get; set; } = default!;

    /// <summary>Gets or sets the text the cell shows at rest.</summary>
    [Parameter]
    public string Text { get; set; } = string.Empty;

    /// <summary>Gets or sets the state of the check box at rest.</summary>
    [Parameter]
    public bool IsChecked { get; set; }

    private RenderedState _rendered;

    private bool IsNumeric => Column.ControlType == ControlType.NumericEdit;

    private bool IsCheck => Column.ControlType == ControlType.CheckEdit;

    // Built only while the cell holds the editor, so the cells at rest allocate nothing for it.
    private Dictionary<string, object?> EditorParameters()
        => Host.EditorParametersBuilder!(Column, Row);

    private string TextClass => IsNumeric ? "polhem-grid-cell__text polhem-grid-cell__text--numeric" : "polhem-grid-cell__text";

    /// <inheritdoc />
    public void RefreshEditorState() => _ = InvokeAsync(StateHasChanged);

    /// <summary>
    /// Closes the editor, called from script when the user presses Escape. Script then gives the text the focus, which
    /// must not open the editor again.
    /// </summary>
    [Microsoft.JSInterop.JSInvokable]
    public void CloseEditor()
    {
        if (!ReferenceEquals(Host.Active, this)) return;
        _ignoreFocus = true;
        Host.Close();
    }

    private void OnFocus()
    {
        if (_ignoreFocus)
        {
            _ignoreFocus = false;
            return;
        }
        Open();
    }

    private void Open()
    {
        // An event that left before the editor rendered. Focusing again would select what the user is typing.
        if (ReferenceEquals(Host.Active, this)) return;
        _focusEditor = true;
        Host.Activate(this);
    }

    /// <inheritdoc />
    protected override void OnInitialized()
    {
        // Checked when the cell first renders rather than when the user first focuses it, so a grid that forgot to set
        // the builder fails on its first page instead of on a later click.
        if (Host.EditorParametersBuilder is null)
            throw new InvalidOperationException($"The {nameof(GridEditorHost)} of the grid has no {nameof(GridEditorHost.EditorParametersBuilder)}.");
        _rendered = CurrentState();
    }

    /// <summary>
    /// Renders the cell only when what it shows changed, or while it holds the editor. A value committed in one cell
    /// renders the whole grid again, and without this every cell of every row went through a render and a diff.
    /// </summary>
    /// <returns>Whether the cell renders.</returns>
    protected override bool ShouldRender()
    {
        var current = CurrentState();
        if (!current.IsActive && current == _rendered) return false;
        _rendered = current;
        return true;
    }

    private RenderedState CurrentState()
        => new(ReferenceEquals(Host.Active, this), Text, IsChecked, EditorType, Row, Column);

    private readonly record struct RenderedState(bool IsActive, string Text, bool IsChecked, Type EditorType, DataRow Row,
        LayoutColumn Column);

    /// <inheritdoc />
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusEditor)
        {
            _focusEditor = false;
            _self ??= Microsoft.JSInterop.DotNetObjectReference.Create(this);
            await Script.FocusEditorAsync(_editor, _self).ConfigureAwait(true);
        }
    }

    /// <inheritdoc />
    public ValueTask DisposeAsync()
    {
        Host.Release(this);
        _self?.Dispose();
        return ValueTask.CompletedTask;
    }
}
