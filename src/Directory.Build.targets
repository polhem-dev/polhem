<Project>

  <!--
    Dependency boundary for the assemblies every consumer inherits (ADR-038).

    Polhem.Base is a dependency of every project in the framework and Polhem.Definition is the most
    depended-on project in it, so anything added here is inherited by every consumer of the
    framework — including consumers that only want to read definitions. (No dependent count here:
    it drifts and nothing checks it. The csproj files are the authority; docs/en/dependency-map.md
    renders them.) Polhem.Api.Contracts is locked for the same reason:
    it sits in the transitive closure of every UI head. This target locks each of them to an explicit
    allowlist: adding a reference fails the build rather than silently widening the public
    dependency surface. Widening it is allowed, but it has to be a decision someone made on
    purpose — edit the allowlist below and record the reasoning in ADR-038.

    Only consumer-facing references are checked, because those are the ones that reach the nuspec:
    a PackageReference marked PrivateAssets="all" (SourceLink, analyzers) is build-time only, and a
    ProjectReference with ReferenceOutputAssembly="false" (the Polhem.Analyzers build ordering
    reference) contributes no assembly.

    The same boundary is asserted from the other end by
    tests/Polhem.Definition.UnitTests/DefinitionDependencyGateTests.cs, which walks the full
    transitive closure. The two are complements, not duplicates: this target catches the direct
    edge at the moment it is written, the test catches a package that arrives indirectly through a
    project reference — which is exactly how DynamicExpresso.Core got in.
  -->

  <PropertyGroup>
    <PolhemEnforceDependencyBoundary Condition="'$(MSBuildProjectName)' == 'Polhem.Base' Or '$(MSBuildProjectName)' == 'Polhem.Definition' Or '$(MSBuildProjectName)' == 'Polhem.Api.Contracts'">true</PolhemEnforceDependencyBoundary>
  </PropertyGroup>

  <!-- Polhem.Base: no consumer-facing dependency of any kind. The allowlist is deliberately empty. -->

  <ItemGroup Condition="'$(MSBuildProjectName)' == 'Polhem.Definition'">
    <!-- Microsoft first-party, abstraction-only, versioned with .NET itself: it makes no technology
         choice on the consumer's behalf. Used by Language/PolhemStringLocalizer.cs. -->
    <PolhemAllowedDependency Include="Microsoft.Extensions.Localization.Abstractions" />
    <PolhemAllowedDependency Include="Polhem.Base" />
  </ItemGroup>

  <!--
    Polhem.Api.Contracts sits in the transitive closure of every UI head, so ADR-038's argument
    ("anything added here is inherited by every consumer") applies to it almost verbatim. It has
    no external package today; the lock is what keeps it that way.
  -->
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'Polhem.Api.Contracts'">
    <PolhemAllowedDependency Include="Polhem.Definition" />
    <!-- Arrives transitively through Polhem.Definition. The SDK folds transitive project references
         into @(ProjectReference) before Build, so the allowlist has to name the whole
         project-reference closure, not just what the csproj writes down. -->
    <PolhemAllowedDependency Include="Polhem.Base" />
  </ItemGroup>

  <!-- POLHEM9002：版號三屬性一致。與 tools/ 共用同一份定義。 -->
  <Import Project="$(MSBuildThisFileDirectory)../Version.targets" />

  <Target Name="PolhemVerifyDependencyBoundary"
          BeforeTargets="Build"
          Condition="'$(PolhemEnforceDependencyBoundary)' == 'true'">
    <ItemGroup>
      <_PolhemConsumerFacingDependency Include="@(PackageReference)"
                                    Exclude="@(PackageReference->WithMetadataValue('PrivateAssets', 'all'))" />
      <_PolhemConsumerFacingDependency Include="@(ProjectReference->'%(Filename)')"
                                    Exclude="@(ProjectReference->WithMetadataValue('ReferenceOutputAssembly', 'false')->'%(Filename)')" />
      <_PolhemBoundaryViolation Include="@(_PolhemConsumerFacingDependency)"
                             Exclude="@(PolhemAllowedDependency)" />
    </ItemGroup>

    <Error Condition="'@(_PolhemBoundaryViolation)' != ''"
           Code="POLHEM9001"
           Text="$(MSBuildProjectName) is inherited by every consumer of the framework and is locked to an explicit dependency allowlist (ADR-038). Unexpected consumer-facing reference(s): @(_PolhemBoundaryViolation, ', '). Anything added here is inherited by every consumer of the framework. Prefer keeping the abstraction here and the implementation in a separate assembly that only a composition root references. If the dependency really belongs here, add it to PolhemAllowedDependency in src/Directory.Build.targets, add it to the whitelist in tests/Polhem.Definition.UnitTests/DefinitionDependencyGateTests.cs, and record why in docs/adr/adr-038-definition-dependency-boundary.md." />
  </Target>

</Project>
