  <ItemGroup>
    <ProjectReference Include="..\Polhem.Definition\Polhem.Definition.csproj" />
    <ProjectReference Include="..\Polhem.Repository.Abstractions\Polhem.Repository.Abstractions.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Polhem.ObjectCaching.UnitTests" />
  </ItemGroup>


</Project>
