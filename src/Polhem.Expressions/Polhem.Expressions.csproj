<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <Description>Portable expression evaluation engine (DynamicExpresso-backed) shared by the business layer and UI clients for field computation and rule validation.</Description>
    <PackageTags>polhem;expression;formula;rule;dynamicexpresso;enterprise</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DynamicExpresso.Core" Version="2.19.6" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Polhem.Core\Polhem.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Polhem.Expressions.UnitTests" />
  </ItemGroup>

  <!--
    Trimmer preservation roots for the members expressions reach by reflection, shipped with the
    package. The logical name "ILLink.Descriptors.xml" is the one the trimmer picks up from a
    referenced assembly, so every trimmed consumer applies it. See the file for what it keeps and why.
  -->
  <ItemGroup>
    <EmbeddedResource Include="ILLink.Descriptors.xml">
      <LogicalName>ILLink.Descriptors.xml</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
