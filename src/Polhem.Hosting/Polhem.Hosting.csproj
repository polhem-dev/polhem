<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Description>Composition root for the Polhem framework. Registers backend services into any IServiceCollection — usable from ASP.NET Core, WinForms/WPF, Console, Worker Service, and integration test hosts without pulling in ASP.NET Core.</Description>
    <PackageTags>polhem;di;composition;hosting;backend</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Polhem.Api.Core\Polhem.Api.Core.csproj" />
    <ProjectReference Include="..\Polhem.Business\Polhem.Business.csproj" />
    <!-- Declared explicitly rather than taken transitively via Polhem.Repository: the composition
         root binds Polhem.Db types directly (IDbAccessFactory, IDbConnectionManager, the cache-notify
         reader/writer), so the dependency is real and must be visible in the package graph. -->
    <ProjectReference Include="..\Polhem.Db\Polhem.Db.csproj" />
    <ProjectReference Include="..\Polhem.Expressions\Polhem.Expressions.csproj" />
    <ProjectReference Include="..\Polhem.Repository\Polhem.Repository.csproj" />
    <ProjectReference Include="..\Polhem.ObjectCaching\Polhem.ObjectCaching.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Polhem.Hosting.UnitTests" />
  </ItemGroup>

</Project>
