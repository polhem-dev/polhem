<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Polhem.UI.Avalonia.Shell.ViewModels"
             xmlns:models="clr-namespace:Polhem.UI.Avalonia.Shell.Navigation"
             xmlns:l="clr-namespace:Polhem.UI.Avalonia.Shell.Localization"
             x:Class="Polhem.UI.Avalonia.Shell.Views.FormsView"
             x:ClassModifier="internal"
             x:DataType="vm:FormsViewModel">

  <!-- Icons are geometry, not text: the embedded Inter font has no glyph for characters such as U+2630 or U+2715,
       and the browser head has no system font to fall back on. -->
  <UserControl.Resources>
    <StreamGeometry x:Key="ShellIconMenu">M3,6H21V8H3V6M3,11H21V13H3V11M3,16H21V18H3V16Z</StreamGeometry>
    <StreamGeometry x:Key="ShellIconClose">M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z</StreamGeometry>
  </UserControl.Resources>

  <UserControl.Styles>
    <!-- Tab close button: flat by default, a subtle fill block only on hover / press. -->
    <Style Selector="Button.tabclose">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="4,0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style Selector="Button.tabclose:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SemiColorFill1}" />
    </Style>
    <Style Selector="Button.tabclose:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SemiColorFill2}" />
    </Style>
  </UserControl.Styles>

  <DockPanel>

    <!-- Top bar: hamburger toggles the navigation pane; brand sits next to it; on the right the switch flips the
         app-wide Light / Dark theme variant, and Sign out returns to the sign-in screen. -->
    <Border DockPanel.Dock="Top"
            Background="{DynamicResource SemiColorBackground1}"
            BorderBrush="{DynamicResource SemiColorBorder}"
            BorderThickness="0,0,0,1"
            Padding="8,6">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" VerticalAlignment="Center">
        <Button Grid.Column="0"
                Command="{Binding TogglePaneCommand}"
                Classes="Tertiary"
                Padding="8,4"
                ToolTip.Tip="{l:ShellText Forms_ToggleMenu}">
          <PathIcon Data="{StaticResource ShellIconMenu}" Width="16" Height="16" />
        </Button>
        <TextBlock Grid.Column="1" Text="{Binding AppTitle}" FontSize="16" FontWeight="SemiBold"
                   VerticalAlignment="Center" Margin="10,0,0,0" />
        <ToggleSwitch Grid.Column="3"
                      x:Name="ThemeToggle"
                      OnContent="{l:ShellText Forms_Dark}" OffContent="{l:ShellText Forms_Light}"
                      IsChecked="False"
                      VerticalAlignment="Center"
                      IsCheckedChanged="OnThemeToggled" />
        <Button Grid.Column="4"
                Command="{Binding SignOutCommand}"
                Classes="Tertiary"
                Padding="8,4"
                Margin="12,0,0,0"
                Content="{l:ShellText Forms_SignOut}" />
      </Grid>
    </Border>

    <!-- Collapsible navigation menu + content host. Inline display mode slides the whole
         pane away when collapsed so the form area takes the full width. -->
    <SplitView x:Name="Split"
               IsPaneOpen="{Binding IsPaneOpen}"
               DisplayMode="Inline"
               OpenPaneLength="220"
               PaneBackground="{DynamicResource SemiColorBackground1}">

      <SplitView.Pane>
        <ListBox x:Name="NavList"
                 ItemsSource="{Binding NavItems}"
                 Background="Transparent"
                 BorderThickness="0"
                 Padding="6,8"
                 Tapped="OnNavTapped"
                 SelectionChanged="OnNavSelectionChanged">
          <ListBox.Styles>
            <!-- Header rows are labels, not choices: disable so selection skips them. -->
            <Style Selector="ListBoxItem">
              <Setter Property="IsEnabled" Value="{Binding !IsHeader, x:DataType=models:NavItem}" />
            </Style>
          </ListBox.Styles>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="models:NavItem">
              <Panel>
                <TextBlock Text="{Binding Title}"
                           IsVisible="{Binding IsHeader}"
                           Classes="muted"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Margin="2,8,0,2"
                           Foreground="{DynamicResource SemiColorText2}" />
                <TextBlock Text="{Binding Title}"
                           IsVisible="{Binding !IsHeader}"
                           VerticalAlignment="Center" />
              </Panel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </SplitView.Pane>

      <!-- Open forms as IDE-style document tabs. Selecting a menu entry opens a new tab
           (a fresh FormView so it runs its attach-time initialisation) or switches to the
           existing one; tabs are built and de-duplicated in code-behind. The iOS and Android
           heads show one form at a time in SingleHost instead. -->
      <Panel>
        <TabControl x:Name="Tabs" Margin="8" />
        <ContentControl x:Name="SingleHost" Margin="8" IsVisible="False" />
      </Panel>

    </SplitView>

  </DockPanel>

</UserControl>
