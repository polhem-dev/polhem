<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <Description>A ready-made Avalonia front end for a Polhem backend: connect, sign in to a company, and open every form of the server's menu. Shared by the desktop, browser, iOS and Android heads.</Description>
    <PackageTags>polhem;avalonia;ui;shell;client</PackageTags>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- The [JSImport] source generator behind Browser/LocalStorageInterop emits unsafe marshalling code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- Lower bounds, as in Polhem.UI.Avalonia: the heads in this repository run these versions, and a host may bring
         a newer 12.x. Semi.Avalonia is the theme the shell applies, on the version line the Avalonia core is on. -->
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
    <PackageReference Include="Semi.Avalonia" Version="12.1.0.1" />
    <PackageReference Include="Semi.Avalonia.DataGrid" Version="12.1.0.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Polhem.UI.Avalonia\Polhem.UI.Avalonia.csproj" />
    <ProjectReference Include="..\Polhem.UI.ApiBridge\Polhem.UI.ApiBridge.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="buildTransitive\Polhem.UI.Avalonia.Shell.targets" Pack="true" PackagePath="buildTransitive\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Polhem.UI.Avalonia.Shell.UnitTests" />
  </ItemGroup>

</Project>
