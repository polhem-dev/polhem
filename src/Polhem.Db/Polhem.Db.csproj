<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <Description>Database abstraction with dynamic command generation and connection binding.</Description>
    <PackageTags>polhem;database;dbccess;orm;sql;connection;query</PackageTags>
  </PropertyGroup>

  <!--
    Framework convention analyzers applied to this project itself: POLHEM4002-4006 check the shape of
    collection types that go over the wire or through XmlSerializer's reflection-only path, and the
    framework collections here are exactly that. Without this reference the rules stay silent for
    this assembly (POLHEM4001 is the only one that reaches across assemblies).
  -->
  <ItemGroup>
    <ProjectReference Include="..\Polhem.Analyzers\Polhem.Analyzers.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Polhem.Definition\Polhem.Definition.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Polhem.Db.UnitTests" />
  </ItemGroup>

</Project>
