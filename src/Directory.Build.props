<Project>

  <!-- The single source of version information; tools/ imports the same file. POLHEM9002 checks at build time that the three version properties agree. -->
  <Import Project="$(MSBuildThisFileDirectory)../Version.props" />
  <!-- Package metadata shared with the published dotnet tool (tools/Polhem.Cli). -->
  <Import Project="$(MSBuildThisFileDirectory)../Package.props" />

  <!--
    The JSON-RPC packages (polhem-dev/polhem-jsonrpc). Polhem.Api.Core references them as packages of this version.
    A maintainer changing both repositories at once sets PolhemJsonRpcSource to a local checkout of polhem-jsonrpc,
    and the same projects then reference its source instead. Set it in PolhemJsonRpc.local.props at the repository
    root, which git ignores, for example:

      <Project><PropertyGroup><PolhemJsonRpcSource>$(MSBuildThisFileDirectory)../polhem-jsonrpc</PolhemJsonRpcSource></PropertyGroup></Project>

    CI and the release workflow never set it, so what they build and publish depends on the released packages.
  -->
  <PropertyGroup>
    <PolhemJsonRpcVersion>0.1.0</PolhemJsonRpcVersion>
  </PropertyGroup>
  <Import Project="$(MSBuildThisFileDirectory)../PolhemJsonRpc.local.props"
          Condition="Exists('$(MSBuildThisFileDirectory)../PolhemJsonRpc.local.props')" />

  <PropertyGroup>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <!-- CI packs in a separate step (build-ci.yml, nuget-publish.yml), so its build step does not pack as well. -->
    <GeneratePackageOnBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">false</GeneratePackageOnBuild>

    <GenerateDocumentationFile>True</GenerateDocumentationFile>

    <ImplicitUsings>enable</ImplicitUsings>

    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!-- Opt-in per-project SARIF diagnostics, used to regenerate the PublicAPI baselines in bulk.
         Off unless PolhemSarifDir is passed, so normal builds are unaffected. Procedure:
         maintainers/public-api-baseline.md -->
    <ErrorLog Condition="'$(PolhemSarifDir)' != ''">$(PolhemSarifDir)/$(MSBuildProjectName).sarif,version=2.1</ErrorLog>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!-- Public API surface tracking. RS0016/RS0017 turn "a published type or member was added,
         removed or changed" into a build failure unless the baseline below is updated in the same
         commit, so a breaking change can no longer reach a release without someone noticing.
         Adopted because the commit-subject `!` convention was previously the only gate and it
         missed real breaks twice. Baseline maintenance: maintainers/public-api-baseline.md. -->
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="4.14.0" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>
</Project>
