@namespace Polhem.Web.Blazor.Fluent.Controls
@inherits GridColumnFilterBase
@using Polhem.Definition.Forms
@using Polhem.Definition.Language
@using Polhem.Definition.Layouts
@using Polhem.UI.Core.Connectors

<span class="polhem-grid-filter">
    <FluentButton Id="@_buttonId"
                  Class="@(IsFiltered ? "polhem-grid-filter__button polhem-grid-filter__button--active" : "polhem-grid-filter__button")"
                  Appearance="@(IsFiltered ? ButtonAppearance.Primary : ButtonAppearance.Transparent)"
                  Title="@ButtonLabel"
                  StopPropagation="true"
                  OnClick="Toggle">▾</FluentButton>
    @* WARNING: the text boxes are native inputs. A Fluent input can overwrite what is typed just after it takes the focus,
       which here would apply an empty filter while the panel closes as usual. Enter also submits only from a native input.
       WARNING: the popover opens only when `Opened` turns true on an element that is already there, so it stays in the markup
       and only its content comes and goes. A click outside or Escape closes it and drops what was typed and not applied. *@
    <FluentPopover AnchorId="@_buttonId" Opened="IsOpen" OpenedChanged="OnOpenedChanged" Class="polhem-grid-filter__panel">
        @if (IsOpen)
        {
            <form class="polhem-grid-filter__form" @onsubmit="() => ApplyAsync()" @onsubmit:preventDefault @onkeydown="OnKeyDown">
                @switch (Kind)
                {
                    case ColumnFilterKind.Boolean:
                    case ColumnFilterKind.Choice:
                        <FluentSelect TOption="KeyValuePair<string, string>"
                                      TValue="string"
                                      Class="polhem-grid-filter__first"
                                      Label="@Column.Caption"
                                      Items="Choices"
                                      OptionText="@(c => c.Value)"
                                      OptionValue="@(c => c.Key)"
                                      @bind-Value="First"
                                      Width="100%" />
                        break;
                    case ColumnFilterKind.Text:
                        <label class="polhem-grid-filter__first">
                            <span class="polhem-native-input__label">@Column.Caption</span>
                            <input @ref="_firstInputReference" class="polhem-native-input" @bind="First" />
                        </label>
                        break;
                    default:
                        <label class="polhem-grid-filter__first">
                            <span class="polhem-native-input__label">@Text(PolhemUIText.FilterFrom)</span>
                            <input @ref="_firstInputReference" class="polhem-native-input" placeholder="@RangePlaceholder" @bind="First" />
                        </label>
                        <label class="polhem-grid-filter__second">
                            <span class="polhem-native-input__label">@Text(PolhemUIText.FilterTo)</span>
                            <input class="polhem-native-input" placeholder="@RangePlaceholder" @bind="Second" />
                        </label>
                        break;
                }
                @if (IsInvalid)
                {
                    <div class="polhem-grid-filter__error" role="alert">@Text(PolhemUIText.FilterInvalid)</div>
                }
                <div class="polhem-grid-filter__buttons">
                    <FluentButton Class="polhem-grid-filter__clear" OnClick="() => ClearAsync()">@Text(PolhemUIText.FilterClear)</FluentButton>
                    <button type="submit" class="polhem-native-button polhem-grid-filter__apply">@Text(PolhemUIText.FilterApply)</button>
                </div>
            </form>
        }
    </FluentPopover>
</span>

@code {
    private bool _focusFirst;
    private readonly string _buttonId = $"polhem-filter-{Guid.NewGuid():N}";
    private ElementReference _firstInputReference;

    // Fluent's text input has no date type.
    private string? RangePlaceholder => IsDateRange ? "yyyy-MM-dd" : null;

    /// <inheritdoc />
    protected override void Toggle()
    {
        base.Toggle();
        _focusFirst = IsOpen;
    }

    /// <inheritdoc />
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_focusFirst || Kind is ColumnFilterKind.Boolean or ColumnFilterKind.Choice) return;
        _focusFirst = false;
        await _firstInputReference.FocusAsync().ConfigureAwait(true);
    }

    private void OnOpenedChanged(bool opened)
    {
        if (!opened) Close();
    }
}
