@namespace Polhem.Web.Blazor.Fluent.Components

@* The host renders this while the question is open and removes it when either callback runs. The focus starts on Cancel,
   so a stray Enter or Space does not go ahead. *@
<PolhemDialog Class="polhem-confirm-dialog" Title="@Title" Dismissable="true" Dismissed="() => OnCancelled.InvokeAsync()">
    <ChildContent>
        <div class="polhem-confirm-dialog__message">@Message</div>
    </ChildContent>
    <Actions>
        <FluentButton AutoFocus="true" Class="polhem-confirm-dialog__cancel" OnClick="() => OnCancelled.InvokeAsync()">@CancelText</FluentButton>
        <FluentButton Appearance="ButtonAppearance.Primary" Class="polhem-confirm-dialog__confirm" OnClick="() => OnConfirmed.InvokeAsync()">@ConfirmText</FluentButton>
    </Actions>
</PolhemDialog>

@code {
    /// <summary>Gets or sets the title.</summary>
    [Parameter]
    public string? Title { get; set; }

    /// <summary>Gets or sets the question.</summary>
    [Parameter]
    public string? Message { get; set; }

    /// <summary>Gets or sets the caption of the safe answer.</summary>
    [Parameter]
    public string? CancelText { get; set; }

    /// <summary>Gets or sets the caption of the answer that goes ahead.</summary>
    [Parameter]
    public string? ConfirmText { get; set; }

    /// <summary>Invoked when the user goes ahead.</summary>
    [Parameter]
    public EventCallback OnConfirmed { get; set; }

    /// <summary>Invoked when the user backs out, including through Escape or a click outside.</summary>
    [Parameter]
    public EventCallback OnCancelled { get; set; }
}
