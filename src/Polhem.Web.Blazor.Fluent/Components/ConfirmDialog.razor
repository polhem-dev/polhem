@namespace Polhem.Web.Blazor.Fluent.Components
@inherits ConfirmDialogBase

@* The host renders this while the question is open and removes it when either callback runs. The focus starts on Cancel,
   so a stray Enter or Space does not go ahead. *@
<PolhemDialog Class="polhem-confirm-dialog" Title="@Title" Dismissable="true" Dismissed="() => OnCancelled.InvokeAsync()">
    <ChildContent>
        <div class="polhem-confirm-dialog__message">@Message</div>
    </ChildContent>
    <Actions>
        <FluentButton AutoFocus="true" Class="polhem-confirm-dialog__cancel" OnClick="() => OnCancelled.InvokeAsync()">@CancelText</FluentButton>
        <FluentButton Appearance="ButtonAppearance.Primary" Class="polhem-confirm-dialog__confirm" OnClick="() => OnConfirmed.InvokeAsync()">@ConfirmText</FluentButton>
    </Actions>
</PolhemDialog>
