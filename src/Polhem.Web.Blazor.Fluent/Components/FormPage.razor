@namespace Polhem.Web.Blazor.Fluent.Components
@inherits FormPageBase
@using Polhem.Definition.Language
@using Polhem.Definition.Settings
@using Polhem.Web.Blazor.Fluent.Controls

<div class="polhem-form-page">
    @if (IsCompact is null)
    {
        <CompactViewportObserver CompactWidthThreshold="CompactWidthThreshold" CompactChanged="compact => OnCompactChangedAsync(compact)" />
    }
    @if (Error is not null)
    {
        <FluentMessageBar Intent="MessageBarIntent.Error" Class="polhem-form-page__error">@Error</FluentMessageBar>
    }
    else if (IsInitializing || DataObject is null)
    {
        <div class="polhem-form-page__loading">@Text(PolhemUIText.Loading)</div>
    }
    else
    {
        @* A command the user lacks the permission for is hidden, as in the Avalonia views. *@
        <div class="polhem-form-page__toolbar">
            @if (!IsShowingRecord)
            {
                @if (Can(PermissionActions.Read))
                {
                    <FluentButton Disabled="@(IsListLocked || SelectedRowId is null)" OnClick="() => OnViewAsync()">@Text(PolhemUIText.View)</FluentButton>
                }
                @if (Can(PermissionActions.Create))
                {
                    <FluentButton Disabled="@IsListLocked" OnClick="() => OnNewAsync()">@Text(PolhemUIText.New)</FluentButton>
                }
                @if (Can(PermissionActions.Update))
                {
                    <FluentButton Disabled="@(IsListLocked || SelectedRowId is null)" OnClick="() => OnEditAsync()">@Text(PolhemUIText.Edit)</FluentButton>
                }
                @if (Can(PermissionActions.Delete))
                {
                    <FluentButton Disabled="@(IsListLocked || SelectedRowId is null)" OnClick="() => OnDeleteAsync()">@Text(PolhemUIText.Delete)</FluentButton>
                }
            }
            else if (IsEditing)
            {
                @if (Can(PermissionActions.Create | PermissionActions.Update))
                {
                    <FluentButton Appearance="ButtonAppearance.Primary" Disabled="@IsBusy" OnClick="() => OnSaveAsync()">@Text(PolhemUIText.Save)</FluentButton>
                }
                <FluentButton Disabled="@IsBusy" OnClick="OnClose">@Text(PolhemUIText.Cancel)</FluentButton>
                @if (DataObject.IsDirty)
                {
                    <span class="polhem-form-page__dirty">@Text(PolhemUIText.Unsaved)</span>
                }
            }
            else
            {
                <FluentButton Disabled="@IsBusy" OnClick="OnClose">@Text(PolhemUIText.Back)</FluentButton>
            }
        </div>

        @if (Notice is not null)
        {
            <FluentMessageBar Intent="MessageBarIntent.Warning" Class="polhem-form-page__notice">@Notice</FluentMessageBar>
        }

        @if (LiveComputationNotice is { } liveComputationNotice)
        {
            <FluentMessageBar Intent="MessageBarIntent.Warning" Class="polhem-form-page__notice">@liveComputationNotice</FluentMessageBar>
        }

        @if (!IsShowingRecord && Filters.HasFilters)
        {
            @* Outside the grid: a filter can leave no rows, and the cards have no headers, and it must still come off. *@
            <div class="polhem-form-page__filters" role="status">
                <span>@Text(PolhemUIText.ListFiltered)</span>
                <FluentButton Class="polhem-form-page__clear-filters" Disabled="@IsListLocked" OnClick="() => ClearFiltersAsync()">@Text(PolhemUIText.ClearFilters)</FluentButton>
            </div>
        }

        @if (!IsShowingRecord && EffectiveIsCompact)
        {
            @if (CardRows.Count == 0)
            {
                <div class="polhem-form-page__empty">@Text(PolhemUIText.NoData)</div>
            }
            else
            {
                <div class="polhem-card-list">
                    @foreach (var row in CardRows)
                    {
                        <div class="@(IsCardSelected(row) ? "polhem-card polhem-card--selected" : "polhem-card")"
                             @key="row"
                             @onclick="e => OnCardClick(row, e)">
                            @foreach (var column in CardColumns)
                            {
                                <div class="polhem-card__line">
                                    <span class="polhem-card__caption">@column.Caption</span>
                                    @if (column.ControlType == Polhem.Definition.Layouts.ControlType.CheckEdit)
                                    {
                                        <input type="checkbox" disabled checked="@IsCardChecked(row, column)" aria-label="@column.Caption" />
                                    }
                                    else
                                    {
                                        <span class="polhem-card__value">@FormatCardValue(row, column)</span>
                                    }
                                </div>
                            }
                        </div>
                    }
                    @if (CanLoadMoreCards)
                    {
                        <CardListEnd RowCount="CardRows.Count" ReachedEnd="() => LoadMoreCardsAsync()" />
                    }
                </div>
                @if (CardLimitNotice is { } cardLimitNotice)
                {
                    <div class="polhem-card-list__limit" role="status">@cardLimitNotice</div>
                }
            }
        }
        else if (!IsShowingRecord)
        {
            @if (ListLayout is not null && ListRows is { Rows.Count: > 0 })
            {
                <GridControl Filters="Filters"
                             OnFilterChanged="change => OnFilterChangedAsync(change)"
                             Layout="ListLayout"
                             DataTable="ListRows"
                             FormTable="Schema?.MasterTable"
                             AllowEdit="false"
                             SelectedRowId="SelectedRowId"
                             RowSelected="OnRowSelected"
                             RowActivated="rowId => OnRowActivatedAsync(rowId)"
                             SortFieldName="@Paging.SortFieldName"
                             SortDirection="Paging.SortDirection"
                             OnSortRequested="fieldName => OnSortRequestedAsync(fieldName)" />
            }
            else
            {
                <div class="polhem-form-page__empty">@Text(PolhemUIText.NoData)</div>
            }
            @if (ShowsPager)
            {
                <div class="polhem-form-page__pager">
                    <FluentButton Disabled="@(IsListLocked || !Paging.CanGoPrevious)" OnClick="() => GoToPageAsync(Paging.Page - 1)">@Text(PolhemUIText.PreviousPage)</FluentButton>
                    <FluentButton Disabled="@(IsListLocked || !Paging.CanGoNext)" OnClick="() => GoToPageAsync(Paging.Page + 1)">@Text(PolhemUIText.NextPage)</FluentButton>
                    <span class="polhem-form-page__page-position">@PagePosition</span>
                    <span class="polhem-form-page__page-size-label">@Text(PolhemUIText.RowsPerPage)</span>
                    <FluentSelect TOption="int"
                                  TValue="int"
                                  Class="polhem-form-page__page-size"
                                  Items="PageSizes"
                                  OptionText="@(size => size.ToString(System.Globalization.CultureInfo.CurrentCulture))"
                                  OptionValue="@(size => size)"
                                  Value="Paging.PageSize"
                                  ValueChanged="pageSize => SetPageSizeAsync(pageSize)"
                                  Disabled="@IsListLocked"
                                  AriaLabel="@Text(PolhemUIText.RowsPerPage)" />
                </div>
            }
        }
        else
        {
            <FormLayoutPresenter Layout="RecordLayout"
                                 DataObject="DataObject"
                                 FormMode="FormMode"
                                 RoundingContext="RoundingContext"
                                 IsCompact="EffectiveIsCompact"
                                 DetailEditMode="DetailEditMode"
                                 OpenRelation="OpenRelation" />
        }
    }
    @if (PendingDeleteRowId is not null)
    {
        <ConfirmDialog Title="@Text(PolhemUIText.Delete)"
                       Message="@Text(PolhemUIText.DeleteRecordPrompt)"
                       CancelText="@Text(PolhemUIText.Cancel)"
                       ConfirmText="@Text(PolhemUIText.Delete)"
                       OnCancelled="CancelDelete"
                       OnConfirmed="() => ConfirmDeleteAsync()" />
    }
    @if (Relation is { } relation)
    {
        <RelatedRecordDialog Target="relation"
                             DefinitionLoader="DefinitionLoader"
                             IsCompact="EffectiveIsCompact"
                             OnClosed="CloseRelation"
                             OnRefused="OnRelationRefused" />
    }
</div>
