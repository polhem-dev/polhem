@namespace Polhem.Web.Blazor.Fluent.Components
@implements IAsyncDisposable
@using Microsoft.JSInterop
@inject IJSRuntime JS

@* An inline FluentDialog stays where it is placed, so removing this component removes it.
   Modal renders type="alert", which a click outside does not close, so a dialog that may be dismissed asks for "modal". *@
<div class="polhem-dialog">
    <FluentDialog @ref="_dialog" Class="@Class" Modal="true" type="@(Dismissable ? "modal" : "alert")"
                  OnStateChange="OnStateChangeAsync">
        <FluentDialogBody>
            <TitleTemplate>@Title</TitleTemplate>
            <ChildContent>
                @* WARNING: an inline dialog stays inside the form that opened it, and what it shows is not that form. A
                   lookup's grid would read the form's data instead of its own rows. *@
                <CascadingValue TValue="FormScopeContext" Value="null" IsFixed="true">@ChildContent</CascadingValue>
            </ChildContent>
            <ActionTemplate>@Actions</ActionTemplate>
        </FluentDialogBody>
    </FluentDialog>
</div>

@code {
    private const string ModulePath = "./_content/Polhem.Web.Blazor.Fluent/polhem-fluent-dialog.js";

    private FluentDialog? _dialog;
    private bool _dismissed;
    private IJSObjectReference? _module;
    private bool _escapeGuarded;

    /// <summary>Gets or sets the dialog's class.</summary>
    [Parameter]
    public string? Class { get; set; }

    /// <summary>Gets or sets the title.</summary>
    [Parameter]
    public string? Title { get; set; }

    /// <summary>Gets or sets whether Escape and a click outside close the dialog.</summary>
    [Parameter]
    public bool Dismissable { get; set; }

    /// <summary>Invoked when Escape or a click outside closed the dialog.</summary>
    [Parameter]
    public EventCallback Dismissed { get; set; }

    /// <summary>Gets or sets the content.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>Gets or sets the action buttons.</summary>
    [Parameter]
    public RenderFragment? Actions { get; set; }

    /// <inheritdoc />
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_dialog is null) return;
        // WARNING: Fluent UI's `PreventDismissOnEscape` also swallows Escape meant for a dialog nested in this one, so a
        // dialog that may not be dismissed uses the guard in `polhem-fluent-dialog.js` instead. It goes on before the
        // dialog opens, so no Escape reaches the dialog unguarded.
        if (_escapeGuarded == Dismissable) await UpdateEscapeGuardAsync(_dialog.Id).ConfigureAwait(true);
        if (firstRender) await _dialog.ShowAsync().ConfigureAwait(true);
    }

    private async Task UpdateEscapeGuardAsync(string? id)
    {
        var guard = !Dismissable;
        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", ModulePath).ConfigureAwait(true);
            await _module.InvokeVoidAsync(guard ? "guardEscape" : "releaseEscape", id).ConfigureAwait(true);
            _escapeGuarded = guard;
        }
        catch (JSException)
        {
            // A dialog whose guard failed to load still opens, and Escape can then close it. Recording the state anyway
            // keeps every later render from trying, and failing, again.
            _escapeGuarded = guard;
        }
    }

    /// <inheritdoc />
    public async ValueTask DisposeAsync()
    {
        if (_module is null) return;
        try
        {
            if (_escapeGuarded) await _module.InvokeVoidAsync("releaseEscape", _dialog?.Id).ConfigureAwait(true);
            await _module.DisposeAsync().ConfigureAwait(true);
        }
        catch (JSDisconnectedException)
        {
            // The circuit is gone, and the module with it.
        }
    }

    // WARNING: FluentDialog raises OnStateChange for an inline dialog only from Fluent UI 5.1.0, and it maps any toggle
    // it does not recognise to Closed. The id check keeps a popover inside the dialog from closing it if an upgrade passes
    // those toggles on again. Closing comes from `beforetoggle` and Closed from `toggle`; the first of them dismisses.
    private async Task OnStateChangeAsync(DialogEventArgs e)
    {
        if (!string.Equals(e.Id, _dialog?.Id, StringComparison.Ordinal)
            || e.State is not (DialogState.Closing or DialogState.Closed)
            || _dismissed)
        {
            return;
        }

        _dismissed = true;
        await Dismissed.InvokeAsync().ConfigureAwait(true);
    }
}
