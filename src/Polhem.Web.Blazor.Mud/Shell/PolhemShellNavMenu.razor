@namespace Polhem.Web.Blazor.Mud.Shell
@inherits ShellNavMenuBase

@if (Error is not null)
{
    <MudAlert Severity="Severity.Error" Dense="true" Class="polhem-shell-nav__error">@Error</MudAlert>
}
else if (Rows is null)
{
    <div class="polhem-shell-nav__loading">@LoadingText</div>
}
else if (Rows.Count == 0)
{
    <div class="polhem-shell-nav__empty">@PolhemShellText.Get(PolhemShellText.MenuEmpty)</div>
}
else
{
    <MudNavMenu Class="polhem-shell-nav" Dense="true">
        @foreach (var row in Rows)
        {
            if (row.ProgId is null)
            {
                <div class="polhem-shell-nav__header">@row.Caption</div>
            }
            else
            {
                @* Not MudNavLink's OnClick: with one it renders a div instead of a link, and the address is lost. *@
                <div @onclick="() => OnNavigated.InvokeAsync()">
                    <MudNavLink Class="polhem-shell-nav__link" Href="@Options.GetFormUri(row.ProgId)">@row.Caption</MudNavLink>
                </div>
            }
        }
    </MudNavMenu>
}
