<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <Description>The MudBlazor UI package of the Polhem Blazor head.</Description>
    <PackageTags>polhem;blazor;mudblazor;rcl;ui</PackageTags>
    <!-- Empty until its first components exist. It joins nuget-publish.yml then. -->
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);RS0041</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Polhem.Web.Blazor\Polhem.Web.Blazor.csproj" />
  </ItemGroup>

</Project>
