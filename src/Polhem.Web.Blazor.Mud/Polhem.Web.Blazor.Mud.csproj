<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <Description>The MudBlazor UI package of the Polhem Blazor head.</Description>
    <PackageTags>polhem;blazor;mudblazor;rcl;ui</PackageTags>
    <!-- Joins nuget-publish.yml once the UI package is complete; no release happens before the cutover. -->
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);RS0041</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- An exact version: the density stylesheet depends on Mud's internal class names. Check it when upgrading. -->
    <PackageReference Include="MudBlazor" Version="[9.12.0]" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Polhem.Web.Blazor\Polhem.Web.Blazor.csproj" />
  </ItemGroup>

</Project>
