@namespace Polhem.Web.Blazor.Mud.Components
@inherits LoginPanelBase

<form class="polhem-login-panel" @onsubmit="() => OnSubmitAsync()" @onsubmit:preventDefault="true">
    <MudTextField T="string"
                  Class="polhem-login-panel__input"
                  InputId="@_userIdInputId"
                  Label="@DisplayedUserIdLabel"
                  @bind-Value="UserId"
                  Disabled="@IsBusy"
                  UserAttributes="s_userAttributes"
                  Variant="Variant.Outlined"
                  Margin="Margin.Dense" />
    <MudTextField T="string"
                  Class="polhem-login-panel__input"
                  InputId="@_passwordInputId"
                  Label="@DisplayedPasswordLabel"
                  InputType="InputType.Password"
                  @bind-Value="Password"
                  Disabled="@IsBusy"
                  UserAttributes="s_passwordAttributes"
                  Variant="Variant.Outlined"
                  Margin="Margin.Dense" />
    <MudButton ButtonType="ButtonType.Submit"
               Class="polhem-login-panel__submit"
               Variant="Variant.Filled"
               Color="Color.Primary"
               Disabled="@IsBusy">@DisplayedSubmitLabel</MudButton>
    @if (!string.IsNullOrEmpty(Error))
    {
        <MudAlert Severity="Severity.Error" Dense="true" Class="polhem-login-panel__error">@Error</MudAlert>
    }
</form>

@code {
    private static readonly Dictionary<string, object?> s_userAttributes = new(StringComparer.Ordinal) { ["autocomplete"] = "username" };
    private static readonly Dictionary<string, object?> s_passwordAttributes = new(StringComparer.Ordinal) { ["autocomplete"] = "current-password" };

    private readonly string _userIdInputId = $"polhem-login-user-{Guid.NewGuid():N}";
    private readonly string _passwordInputId = $"polhem-login-pwd-{Guid.NewGuid():N}";
}
