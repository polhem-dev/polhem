@namespace Polhem.Web.Blazor.Mud.Controls.Editors
@inherits TextEditorBase

@* Not Immediate: the value commits when the user finishes it, so a recalculation that depends on it runs once. *@
<MudTextField T="string"
              UserAttributes="MudAttributes.From(AdditionalAttributes)"
              InputId="@Id"
              Class="polhem-field-editor--text"
              Value="Text"
              ValueChanged="CommitText"
              ReadOnly="!IsEditable"
              MaxLength="MudAttributes.MaxLength(MaxLength)"
              Variant="Variant.Outlined"
              Margin="Margin.Dense" />
