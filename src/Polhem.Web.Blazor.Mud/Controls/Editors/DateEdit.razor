@namespace Polhem.Web.Blazor.Mud.Controls.Editors
@inherits DateEditorBase

@if (IsEditable)
{
    <MudDatePicker @key="_generation"
                   @ref="_picker"
                   UserAttributes="MudAttributes.From(AdditionalAttributes)"
                   Class="@ModifierClass"
                   Date="Date"
                   DateChanged="OnDateChanged"
                   TextChanged="OnTextChanged"
                   Editable="true"
                   DateFormat="@DisplayPattern"
                   OpenTo="OpenTo"
                   FixDay="FixDay"
                   PickerVariant="PickerVariant.Inline"
                   Variant="Variant.Outlined"
                   Margin="Margin.Dense" />
}
else
{
    <MudTextField T="string"
                  UserAttributes="MudAttributes.From(AdditionalAttributes)"
                  Class="@ModifierClass"
                  Value="ReadOnlyText"
                  ReadOnly="true"
                  Variant="Variant.Text"
                  Margin="Margin.Dense" />
}

@code {
    private MudDatePicker? _picker;
    private int _generation;

    /// <summary>
    /// Gets the modifier class that identifies the editor kind in the rendered markup.
    /// </summary>
    protected virtual string ModifierClass => "polhem-field-editor--date";

    /// <summary>
    /// Gets the view the picker opens on.
    /// </summary>
    protected virtual OpenTo OpenTo => OpenTo.Date;

    /// <summary>
    /// Gets the day of the month a pick lands on, or <c>null</c> for the day the user picks.
    /// </summary>
    protected virtual int? FixDay => null;

    // MudDatePicker reports both a cleared box and text it cannot parse as null, so only its text tells them apart; the
    // text is handled in OnTextChanged.
    private void OnDateChanged(DateTime? date)
    {
        if (date is null && !string.IsNullOrWhiteSpace(_picker?.Text)) return;
        CommitDate(date);
    }

    // The picker parses only the culture pattern it shows. Other text goes through the shared input rules, which also take
    // the stored ISO form, and the picker is recreated to show the stored date in the culture pattern again, or the
    // previous date when the text is not a date. A field that was empty raises no date change for such text at all.
    private void OnTextChanged(string? text)
    {
        if (string.IsNullOrWhiteSpace(text)
            || DateTime.TryParseExact(text, DisplayPattern, System.Globalization.CultureInfo.CurrentCulture, System.Globalization.DateTimeStyles.None, out _))
            return;
        CommitInput(text);
        _generation++;
    }
}
