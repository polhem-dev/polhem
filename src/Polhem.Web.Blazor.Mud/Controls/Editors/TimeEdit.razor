@namespace Polhem.Web.Blazor.Mud.Controls.Editors
@inherits TimeEditorBase

@* Text, not MudTimePicker: display format equals storage format in every UI head (ADR-033). *@
<MudTextField @key="_generation"
              T="string"
              UserAttributes="MudAttributes.From(AdditionalAttributes)"
              InputId="@Id"
              Class="polhem-field-editor--time"
              Value="Text"
              ValueChanged="Commit"
              ReadOnly="!IsEditable"
              MaxLength="MaxLength"
              Placeholder="HH:mm"
              InputMode="InputMode.numeric"
              Variant="@(IsEditable ? Variant.Outlined : Variant.Text)"
              Margin="Margin.Dense" />

@code {
    private int _generation;

    // MudTextField keeps showing what was typed when its value does not change, so a rejected entry recreates it.
    private void Commit(string? value)
    {
        var shown = Text;
        CommitText(value);
        if (string.Equals(Text, shown, StringComparison.Ordinal) && !string.Equals(Text, value, StringComparison.Ordinal))
            _generation++;
    }
}
