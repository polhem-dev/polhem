@namespace Polhem.Web.Blazor.Mud.Controls
@inherits GridColumnFilterBase
@using Polhem.Definition.Forms
@using Polhem.Definition.Language
@using Polhem.Definition.Layouts
@using Polhem.UI.Core.Connectors

<span class="polhem-grid-filter">
    <MudIconButton Class="@(IsFiltered ? "polhem-grid-filter__button polhem-grid-filter__button--active" : "polhem-grid-filter__button")"
                   Icon="@Icons.Material.Filled.FilterList"
                   Size="Size.Small"
                   Color="@(IsFiltered ? Color.Primary : Color.Default)"
                   aria-label="@ButtonLabel"
                   OnClick="Toggle" />
    @if (IsOpen)
    {
        @* A click outside or Escape closes the popover and drops what was typed and not applied. *@
        <MudOverlay Visible="true" AutoClose="true" OnClosed="Close" />
        <MudPopover Open="true" Class="polhem-grid-filter__panel" AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft">
            <form class="polhem-grid-filter__form" @onsubmit="() => ApplyAsync()" @onsubmit:preventDefault @onkeydown="OnKeyDown">
                @switch (Kind)
                {
                    case ColumnFilterKind.Boolean:
                    case ColumnFilterKind.Choice:
                        <MudSelect T="string" Class="polhem-grid-filter__first" @bind-Value="First" ToStringFunc="ChoiceText" Variant="Variant.Outlined" Margin="Margin.Dense" Label="@Column.Caption">
                            @foreach (var choice in Choices)
                            {
                                <MudSelectItem T="string" Value="@choice.Key">@choice.Value</MudSelectItem>
                            }
                        </MudSelect>
                        break;
                    case ColumnFilterKind.Text:
                        <MudTextField T="string" Class="polhem-grid-filter__first" @bind-Value="First" Immediate="true" AutoFocus="true" Variant="Variant.Outlined" Margin="Margin.Dense" Label="@Column.Caption" />
                        break;
                    default:
                        <MudTextField T="string" Class="polhem-grid-filter__first" @bind-Value="First" Immediate="true" AutoFocus="true" InputType="RangeInputType" Variant="Variant.Outlined" Margin="Margin.Dense" Label="@Text(PolhemUIText.FilterFrom)" Shrink="true" />
                        <MudTextField T="string" Class="polhem-grid-filter__second" @bind-Value="Second" Immediate="true" InputType="RangeInputType" Variant="Variant.Outlined" Margin="Margin.Dense" Label="@Text(PolhemUIText.FilterTo)" Shrink="true" />
                        break;
                }
                @if (IsInvalid)
                {
                    <div class="polhem-grid-filter__error" role="alert">@Text(PolhemUIText.FilterInvalid)</div>
                }
                <div class="polhem-grid-filter__buttons">
                    <MudButton Class="polhem-grid-filter__clear" Size="Size.Small" OnClick="() => ClearAsync()">@Text(PolhemUIText.FilterClear)</MudButton>
                    <MudButton Class="polhem-grid-filter__apply" ButtonType="ButtonType.Submit" Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary">@Text(PolhemUIText.FilterApply)</MudButton>
                </div>
            </form>
        </MudPopover>
    }
</span>

@code {
    private InputType RangeInputType => IsDateRange ? InputType.Date : InputType.Text;
}
