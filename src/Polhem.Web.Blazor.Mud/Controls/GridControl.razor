@namespace Polhem.Web.Blazor.Mud.Controls
@inherits GridControlBase
@implements IAsyncDisposable
@inject Microsoft.JSInterop.IJSRuntime JS
@using System.Data
@using Polhem.Definition.Language
@using Polhem.Definition.Layouts
@using Polhem.UI.Core.Connectors
@using Polhem.UI.Core.Fields
@using Polhem.Web.Blazor.Mud.Controls.Editors

<div class="polhem-grid">
    @if (ShowToolbar)
    {
        <div class="polhem-grid__toolbar">
            @if (Actions.HasFlag(GridControlAllowActions.Add))
            {
                <MudIconButton Class="polhem-grid__button polhem-grid__button--add" Icon="@Icons.Material.Filled.Add" Size="Size.Small"
                               aria-label="@Text(PolhemUIText.Add)" Disabled="@(!HasData)" OnClick="OnAddClicked" />
            }
            @if (EditMode == GridEditMode.EditForm && Actions.HasFlag(GridControlAllowActions.Edit))
            {
                <MudIconButton Class="polhem-grid__button polhem-grid__button--edit" Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                               aria-label="@Text(PolhemUIText.Edit)" Disabled="@(!HasData)" OnClick="EditSelectedRow" />
            }
            @if (Actions.HasFlag(GridControlAllowActions.Delete))
            {
                <MudIconButton Class="polhem-grid__button polhem-grid__button--delete" Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                               aria-label="@Text(PolhemUIText.Delete)" Disabled="@(!HasData)" OnClick="DeleteSelectedRow" />
            }
        </div>
    }
    @* The grid keeps the widths and the order the user gave its columns, so without the key the next form started at
       what the last one was left with. *@
    <MudDataGrid @key="LayoutIdentity"
                 T="DataRow"
                 Items="_rows"
                 RowsPerPage="@Math.Max(1, _rows.Count)"
                 ReadOnly="true"
                 Dense="true"
                 Hover="true"
                 Filterable="false"
                 ColumnResizeMode="@(Compact ? ResizeMode.None : ResizeMode.Column)"
                 DragDropColumnReordering="@(!Compact)"
                 SortMode="SortMode.None"
                 RowClick="OnRowClick"
                 RowClassFunc="RowClass">
        <Columns>
            @foreach (var column in VisibleColumns)
            {
                var current = column;
                <TemplateColumn T="DataRow"
                                Title="@FieldCaptionRules.FormatCaption(current.Caption, current.ReadOnly)"
                                Sortable="false"
                                Resizable="@(!Compact)"
                                DragAndDropEnabled="@(!Compact)"
                                HeaderClass="@HeaderClass(current)"
                                HeaderStyle="@ColumnStyle(current)">
                    <HeaderTemplate>
                        @if (IsSortable(current))
                        {
                            <button type="button" class="polhem-grid__sort" @onclick="() => OnSortRequested.InvokeAsync(current.FieldName)">@FieldCaptionRules.FormatCaption(current.Caption, current.ReadOnly)@SortMark(current)</button>
                        }
                        else
                        {
                            @FieldCaptionRules.FormatCaption(current.Caption, current.ReadOnly)
                        }
                        @if (FilterKind(current) is var filterKind && filterKind != ColumnFilterKind.None)
                        {
                            <GridColumnFilter Column="current"
                                              Field="ColumnField(current)!"
                                              Kind="filterKind"
                                              Filters="Filters!"
                                              Applied="OnFilterChanged" />
                        }
                    </HeaderTemplate>
                    <CellTemplate>
                        @if (IsInCellEditor(current))
                        {
                            <GridEditorCell Host="EditorHost"
                                            Script="_script"
                                            EditorType="FieldEditorFactory.GetEditorType(current.ControlType)"
                                            EditorParameters="BuildEditorParameters(current, context.Item)"
                                            Text="@FormatCell(context.Item, current)"
                                            IsNumeric="@(current.ControlType == ControlType.NumericEdit)"
                                            IsCheck="@(current.ControlType == ControlType.CheckEdit)"
                                            IsChecked="@IsChecked(context.Item, current)" />
                        }
                        else if (current.ControlType == ControlType.CheckEdit)
                        {
                            <input type="checkbox" disabled checked="@IsChecked(context.Item, current)" aria-label="@current.Caption" />
                        }
                        else if (OpenTarget(context.Item, current) is { } target)
                        {
                            <div class="polhem-grid__cell--opens-record"
                                 title="@Text(PolhemUIText.OpenRelatedRecord)"
                                 @ondblclick="() => OpenRelationAsync(target)">@FormatCell(context.Item, current)</div>
                        }
                        else if (current.ControlType == ControlType.NumericEdit)
                        {
                            <div class="polhem-grid-cell__text--numeric">@FormatCell(context.Item, current)</div>
                        }
                        else
                        {
                            @FormatCell(context.Item, current)
                        }
                    </CellTemplate>
                </TemplateColumn>
            }
        </Columns>
    </MudDataGrid>
</div>
@if (EditingRow is not null && BoundDataObject is not null && Layout is not null)
{
    <RowEditDialog DataObject="BoundDataObject"
                   Layout="Layout"
                   Row="EditingRow"
                   Compact="Compact"
                   EditCommitted="OnEditCommitted"
                   EditCancelled="OnEditCancelled" />
}

@code {
    private const string OpenPopupSelector = ".mud-popover-open";

    private List<DataRow> _rows = [];
    private GridEditorScript _script = default!;

    /// <inheritdoc />
    protected override void OnInitialized()
    {
        base.OnInitialized();
        _script = new GridEditorScript(JS, OpenPopupSelector);
    }

    // Loaded before any cell opens, so a key typed before the first editor arrives is already held.
    /// <inheritdoc />
    protected override Task OnAfterRenderAsync(bool firstRender)
        => VisibleColumns.Any(IsInCellEditor) ? _script.LoadAsync() : Task.CompletedTask;

    /// <inheritdoc />
    public ValueTask DisposeAsync() => _script.DisposeAsync();

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        RefreshRowList();
    }

    /// <inheritdoc />
    protected override bool ShouldRender()
    {
        RefreshRowList();
        return true;
    }

    private void RefreshRowList() => _rows = VisibleRows.ToList();

    // MudDataGrid has no double-click event; a click reports how many clicks it is.
    private Task OnRowClick(DataGridRowClickEventArgs<DataRow> e)
        => e.MouseEventArgs.Detail >= 2 ? ActivateRowAsync(e.Item) : SelectRowAsync(e.Item);

    private string RowClass(DataRow row, int index)
        => IsSelected(row) ? "polhem-grid__row polhem-grid__row--selected" : "polhem-grid__row";

    private string HeaderClass(LayoutColumn column)
        => ShowsRequiredCue(column) ? "polhem-grid__header polhem-grid__header--required" : "polhem-grid__header";

    private static string ColumnStyle(LayoutColumn column)
        => string.Create(System.Globalization.CultureInfo.InvariantCulture,
            $"min-width:{GridColumnRules.GetMinWidth(column)}px");
}
