@namespace Polhem.Web.Blazor.Mud.Controls
@implements IGridEditorSlot
@implements IAsyncDisposable
@using Microsoft.JSInterop
@inject IJSRuntime JS

@* A cell shows text until it takes the focus, because an editor in every cell costs too much on a circuit. *@
@if (ReferenceEquals(Host.Active, this))
{
    <div @ref="_editor" class="polhem-grid-cell__editor"><DynamicComponent Type="EditorType" Parameters="EditorParameters" /></div>
}
else
{
    <div @ref="_text" class="@TextClass" tabindex="0" @onfocus="OnFocus" @onkeydown="OnKeyDown">
        @if (IsCheck)
        {
            <input type="checkbox" disabled checked="@IsChecked" tabindex="-1" />
        }
        else
        {
            @Text
        }
    </div>
}

@code {
    private const string ModulePath = "./_content/Polhem.Web.Blazor.Mud/polhem-grid-editor.js";

    private ElementReference _editor;
    private ElementReference _text;
    private bool _focusEditor;
    private bool _focusText;
    private bool _ignoreFocus;
    private Microsoft.JSInterop.IJSObjectReference? _module;
    private Microsoft.JSInterop.DotNetObjectReference<GridEditorCell>? _self;

    /// <summary>Gets or sets the host that keeps one editor open in the grid.</summary>
    [Parameter, EditorRequired]
    public GridEditorHost Host { get; set; } = default!;

    /// <summary>Gets or sets the editor component.</summary>
    [Parameter, EditorRequired]
    public Type EditorType { get; set; } = default!;

    /// <summary>Gets or sets the parameters of the editor.</summary>
    [Parameter, EditorRequired]
    public Dictionary<string, object?> EditorParameters { get; set; } = default!;

    /// <summary>Gets or sets the text the cell shows at rest.</summary>
    [Parameter]
    public string Text { get; set; } = string.Empty;

    /// <summary>Gets or sets whether the value is a number, aligned to the right.</summary>
    [Parameter]
    public bool IsNumeric { get; set; }

    /// <summary>Gets or sets whether the cell shows a check box at rest.</summary>
    [Parameter]
    public bool IsCheck { get; set; }

    /// <summary>Gets or sets the state of the check box at rest.</summary>
    [Parameter]
    public bool IsChecked { get; set; }

    private string TextClass => IsNumeric ? "polhem-grid-cell__text polhem-grid-cell__text--numeric" : "polhem-grid-cell__text";

    /// <inheritdoc />
    public void RefreshEditorState() => _ = InvokeAsync(StateHasChanged);

    /// <summary>Closes the editor and returns the focus to the cell, called from script when the user presses Escape.</summary>
    [Microsoft.JSInterop.JSInvokable]
    public void CloseEditor()
    {
        if (!ReferenceEquals(Host.Active, this)) return;
        _focusText = true;
        Host.Close();
    }

    private void OnFocus()
    {
        if (_ignoreFocus)
        {
            _ignoreFocus = false;
            return;
        }
        Open();
    }

    // A key on a cell whose focus did not open it, as after Escape. Script holds the key until the editor arrives.
    private void OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key.Length == 1 || e.Key is "Enter" or "F2") Open();
    }

    private void Open()
    {
        // An event that left before the editor rendered. Focusing again would select what the user is typing.
        if (ReferenceEquals(Host.Active, this)) return;
        _focusEditor = true;
        Host.Activate(this);
    }

    /// <inheritdoc />
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Loaded with the first cell so a key typed before the first editor arrives is already held.
            _module = await JS.InvokeAsync<Microsoft.JSInterop.IJSObjectReference>("import", ModulePath).ConfigureAwait(true);
        }
        if (_focusEditor)
        {
            _focusEditor = false;
            _self ??= Microsoft.JSInterop.DotNetObjectReference.Create(this);
            if (_module is not null) await _module.InvokeVoidAsync("focusEditor", _editor, _self).ConfigureAwait(true);
        }
        else if (_focusText)
        {
            _focusText = false;
            _ignoreFocus = true;
            await _text.FocusAsync().ConfigureAwait(true);
        }
    }

    /// <inheritdoc />
    public async ValueTask DisposeAsync()
    {
        Host.Release(this);
        _self?.Dispose();
        if (_module is null) return;
        try
        {
            await _module.DisposeAsync().ConfigureAwait(true);
        }
        catch (Microsoft.JSInterop.JSDisconnectedException)
        {
            // The circuit is gone, and the module with it.
        }
    }
}
