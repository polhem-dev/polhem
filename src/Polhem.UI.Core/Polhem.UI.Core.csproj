<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <Description>Shared front-end layer for Polhem: the service contracts a UI consumes and the form value rules every head shares, with no transport.</Description>
    <PackageTags>polhem;ui;core;forms;contracts</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Polhem.Api.Contracts\Polhem.Api.Contracts.csproj" />
  </ItemGroup>

  <!-- The rules every head shares are internal and reach the framework's own UI packages through these.
       The packages ship together under one version, so the friend coupling is safe. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Polhem.UI.Avalonia" />
    <InternalsVisibleTo Include="Polhem.Web.Blazor" />
    <InternalsVisibleTo Include="Polhem.Web.Blazor.Mud" />
    <InternalsVisibleTo Include="Polhem.Web.Blazor.Fluent" />
    <InternalsVisibleTo Include="Polhem.UI.Core.UnitTests" />
    <InternalsVisibleTo Include="Polhem.UI.Avalonia.UnitTests" />
  </ItemGroup>

</Project>
