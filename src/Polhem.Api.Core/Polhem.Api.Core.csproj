<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <Description>The JSON-RPC 2.0 layer of the Polhem framework: request and response messages, the payload codecs, compression and encryption, and the server-side dispatcher.</Description>
    <PackageTags>polhem;api;jsonrpc;messagepack;serialization;encryption</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <!-- The only MessagePack dependency in the repository (adr-036): the hand-written wire
         formatters live here, and a request that declares no codec is decoded as MessagePack. -->
    <PackageReference Include="MessagePack" Version="3.1.7" />
    <!-- The executor logs the real message of a failure whose caller only sees a generic one. -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
  </ItemGroup>

  <!--
    Framework convention analyzers applied to this project itself: the collection shape rules
    (POLHEM4005, POLHEM4006) apply to the wire types declared here, and without this reference they
    stay silent for this assembly.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Polhem.Analyzers\Polhem.Analyzers.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
  </ItemGroup>

  <!-- The JSON-RPC dispatcher. PolhemJsonRpcSource switches to a local checkout; see PolhemJsonRpc.props. -->
  <ItemGroup Condition="'$(PolhemJsonRpcSource)' == ''">
    <PackageReference Include="Polhem.JsonRpc.Server" Version="$(PolhemJsonRpcVersion)" />
  </ItemGroup>
  <ItemGroup Condition="'$(PolhemJsonRpcSource)' != ''">
    <ProjectReference Include="$(PolhemJsonRpcSource)/src/Polhem.JsonRpc.Server/Polhem.JsonRpc.Server.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Polhem.Api.Contracts\Polhem.Api.Contracts.csproj" />
    <ProjectReference Include="..\Polhem.Definition\Polhem.Definition.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Polhem.Api.Core.UnitTests" />
    <!-- The error contract has two halves: JsonRpcExecutor.MapException maps an exception to a
         code, and ApiConnector.FinalizeResponse maps that code back to an exception. Only a test
         that sees both can assert they agree, and the client test project is the one that already
         references both assemblies. -->
    <InternalsVisibleTo Include="Polhem.Api.Client.UnitTests" />
  </ItemGroup>

</Project>
