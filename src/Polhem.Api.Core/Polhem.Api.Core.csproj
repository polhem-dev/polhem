<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <Description>The wire layer of the Polhem framework shared by its clients and its server: request and response messages, the payload codecs, compression and encryption, and the error contract.</Description>
    <PackageTags>polhem;api;jsonrpc;messagepack;serialization;encryption</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <!-- The only MessagePack dependency in the repository (adr-036): the hand-written wire
         formatters live here, and a request that declares no codec is decoded as MessagePack. -->
    <PackageReference Include="MessagePack" Version="3.1.11" />
  </ItemGroup>

  <!--
    Framework convention analyzers applied to this project itself: the collection shape rules
    (POLHEM4005, POLHEM4006) apply to the wire types declared here, and without this reference they
    stay silent for this assembly.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Polhem.Analyzers\Polhem.Analyzers.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
  </ItemGroup>

  <!-- The payload envelope, shared by both ends. The server-side halves (Polhem.JsonRpc.Server,
       Polhem.JsonRpc.Payload.Server) belong to Polhem.Api.Server (ADR-055). PolhemJsonRpcSource switches to a local
       checkout; see PolhemJsonRpc.props. -->
  <ItemGroup Condition="'$(PolhemJsonRpcSource)' == ''">
    <PackageReference Include="Polhem.JsonRpc.Payload" Version="$(PolhemJsonRpcVersion)" />
  </ItemGroup>
  <ItemGroup Condition="'$(PolhemJsonRpcSource)' != ''">
    <ProjectReference Include="$(PolhemJsonRpcSource)/src/Polhem.JsonRpc.Payload/Polhem.JsonRpc.Payload.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Polhem.Api.Contracts\Polhem.Api.Contracts.csproj" />
    <ProjectReference Include="..\Polhem.Definition\Polhem.Definition.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Polhem.Api.Core.UnitTests" />
    <InternalsVisibleTo Include="Polhem.Api.Server.UnitTests" />
    <!-- The client tests check that ApiConnector rebuilds every row of the error contract table declared here, and
         their fake transport binds requests the way the server does. -->
    <InternalsVisibleTo Include="Polhem.Api.Client.UnitTests" />
    <!-- IMPORTANT: the server half reads the request types, the input converter and the error contract through
         internals of this assembly. That only holds when both packages come from the same release, which is why
         Polhem.Api.Server depends on this package at an exact version (ADR-055). -->
    <InternalsVisibleTo Include="Polhem.Api.Server" />
  </ItemGroup>

</Project>
