<?xml version="1.0" encoding="utf-8"?>
<!--
  Traditional Chinese (Taiwan) translation of the framework's user-facing messages, shipped inside
  Polhem.Definition. The keys are in PolhemMessages.cs and the English text is at each throw site;
  PolhemTextResourceTests keeps this file and the keys in step. {0}, {1}, ... are the message arguments
  in the order the English text places them. A host overrides an entry with a PolhemMessages
  language resource of its own.
-->
