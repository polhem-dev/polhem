<Project>

  <!--
    Feeds the consumer's framework definition files to the Polhem analyzers.

    The definition rules (POLHEM1xxx / POLHEM2xxx) read XML through AdditionalFiles, which MSBuild has to
    supply explicitly — analyzers cannot open files on their own. Injecting the glob here is what
    makes the rules work with no setup on the consumer's side.

    This file lives in buildTransitive/ rather than build/ because NuGet imports build/ only for a
    *direct* PackageReference. A project referencing Polhem.Business or Polhem.Api.AspNetCore gets
    Polhem.Definition transitively, and therefore received the analyzer assembly (analyzers do flow
    transitively) without the glob that feeds it — the definition rules loaded and then silently
    examined nothing, with no diagnostic to say so. buildTransitive/ is imported for direct and
    transitive references alike, so one copy here covers both; a second copy under build/ would be
    dead weight, as NuGet picks buildTransitive/ even for direct consumers when both exist.

    Set PolhemAnalyzeDefinitionFiles to false to opt out, or override PolhemDefinitionFilesGlob to point at
    a non-standard layout.

    The file also carries POLHEM9004, the warning about publish configurations Polhem does not support;
    its reasons are next to the PolhemCheckTrimSupport target below.
  -->

  <PropertyGroup>
    <PolhemAnalyzeDefinitionFiles Condition="'$(PolhemAnalyzeDefinitionFiles)' == ''">true</PolhemAnalyzeDefinitionFiles>
    <PolhemDefinitionFilesGlob Condition="'$(PolhemDefinitionFilesGlob)' == ''">Define\**\*.xml</PolhemDefinitionFilesGlob>
    <PolhemRequireDefinitionFiles Condition="'$(PolhemRequireDefinitionFiles)' == ''">false</PolhemRequireDefinitionFiles>
    <PolhemSuppressTrimSupportWarning Condition="'$(PolhemSuppressTrimSupportWarning)' == ''">false</PolhemSuppressTrimSupportWarning>
  </PropertyGroup>

  <ItemGroup Condition="'$(PolhemAnalyzeDefinitionFiles)' == 'true'">
    <!--
      NOTE: The glob is rooted at the project directory rather than recursive from above it, so a
      solution with many projects does not re-scan the same tree once per project. Build output is
      excluded because a definition file copied next to the binaries is a duplicate of the source
      one, and reporting both would double every diagnostic.

      The same reasoning is why the default is not widened to search parent directories when the
      project directory has none: definitions kept beside the solution file would then be picked up
      by every project in that solution that references the framework, and each would report the
      same findings. Such a layout says so explicitly through PolhemDefinitionFilesGlob, on the one
      project that owns the definitions.
    -->
    <_PolhemDefinitionFile Include="$(PolhemDefinitionFilesGlob)"
                        Exclude="$(BaseOutputPath)**;$(BaseIntermediateOutputPath)**;bin\**;obj\**" />
    <AdditionalFiles Include="@(_PolhemDefinitionFile)" />
  </ItemGroup>

  <!--
    Makes an empty match visible. A glob that resolves to nothing is the one failure mode of this
    file that produces no symptom at all — the rules stay quiet, which is also what a project with
    no definitions looks like. Warning unconditionally is not an option, because most projects in a
    solution legitimately have none; so the count is reported at normal importance (visible under
    `dotnet build -v n`, silent by default) and a project that knows it owns definition files can
    turn the empty case into a build failure with PolhemRequireDefinitionFiles.
  -->
  <Target Name="PolhemReportDefinitionFiles"
          BeforeTargets="CoreCompile"
          Condition="'$(PolhemAnalyzeDefinitionFiles)' == 'true'">

    <Message Importance="normal"
             Text="Polhem: PolhemDefinitionFilesGlob '$(PolhemDefinitionFilesGlob)' matched @(_PolhemDefinitionFile->Count()) definition file(s) under '$(MSBuildProjectDirectory)'." />

    <Error Condition="'$(PolhemRequireDefinitionFiles)' == 'true' AND '@(_PolhemDefinitionFile)' == ''"
           Code="POLHEM9003"
           Text="PolhemRequireDefinitionFiles is set, but PolhemDefinitionFilesGlob '$(PolhemDefinitionFilesGlob)' matched no files under '$(MSBuildProjectDirectory)'. The glob is rooted at the project directory: definitions kept beside the solution file need a relative path such as '..\Define\**\*.xml'." />

  </Target>

  <!--
    POLHEM9004: a publish configuration that Polhem does not support.

    The Polhem assemblies are not marked IsTrimmable or IsAotCompatible. The JSON-RPC envelope is
    serialized by System.Text.Json through reflection, and nothing roots the members it reads. So the
    supported configurations are an untrimmed publish and the SDK's partial trim, which is what the iOS,
    Mac Catalyst and Android SDKs default to and which copies the Polhem assemblies untouched.

    The three conditions below are the ones that break the wire, and none of them fails at build time:
    - PublishAot: the envelope serializes to an empty object and deserializing it throws, so every call fails.
    - Full trim: the envelope silently loses its `jsonrpc` and `id` members. A trimmed publish with no
      TrimMode is full trim on desktop and browser-wasm, because the SDK fills TrimMode in only when it
      runs the trimmer, after this target.
    - JsonSerializerIsReflectionEnabledByDefault=false: every envelope (de)serialization throws. The SDK
      sets this for a trimmed desktop or browser-wasm publish unless the project sets it to true.

    The check runs in a target rather than at evaluation time, because the platform SDKs (iOS, Android,
    browser-wasm) set TrimMode and PublishTrimmed in their own targets, which are imported after this file.
    The Apple SDKs go further and set PublishTrimmed inside a target of their own, which may not have run
    yet; they always trim an app, so on those platforms TrimMode=full is enough to warn.

    Set PolhemSuppressTrimSupportWarning to true to silence it, for example in a project that has verified
    its own configuration.
  -->
  <Target Name="PolhemCheckTrimSupport"
          BeforeTargets="CoreCompile"
          Condition="'$(PolhemSuppressTrimSupportWarning)' != 'true'">

    <Warning Condition="'$(PublishAot)' == 'true'"
             Code="POLHEM9004"
             Text="PublishAot is set, but Polhem does not support NativeAOT: the JSON-RPC envelope is serialized by System.Text.Json through reflection, and every API call fails under NativeAOT. Publish without PublishAot, using at most the SDK's partial trim (TrimMode=partial). Set PolhemSuppressTrimSupportWarning=true to silence this warning." />

    <Warning Condition="'$(PublishAot)' != 'true' AND (('$(PublishTrimmed)' == 'true' AND ('$(TrimMode)' == 'full' OR '$(TrimMode)' == '')) OR ('$(TrimMode)' == 'full' AND ('$(TargetPlatformIdentifier)' == 'ios' OR '$(TargetPlatformIdentifier)' == 'maccatalyst' OR '$(TargetPlatformIdentifier)' == 'tvos')))"
             Code="POLHEM9004"
             Text="The project trims with TrimMode=full (TrimMode is '$(TrimMode)'; with PublishTrimmed=true an empty value means the SDK default, which is full on desktop and browser-wasm, and AndroidLinkMode=Full or MtouchLink=Full also select it), but Polhem supports only TrimMode=partial: full trimming removes members of the JSON-RPC envelope that System.Text.Json reads through reflection, and requests go out without their 'jsonrpc' and 'id' members. Set TrimMode=partial, or turn trimming off. Set PolhemSuppressTrimSupportWarning=true to silence this warning." />

    <Warning Condition="'$(PublishAot)' != 'true' AND '$(JsonSerializerIsReflectionEnabledByDefault)' == 'false'"
             Code="POLHEM9004"
             Text="JsonSerializerIsReflectionEnabledByDefault is false, but Polhem serializes the JSON-RPC envelope with reflection-based System.Text.Json, so every API call throws at run time. Set JsonSerializerIsReflectionEnabledByDefault=true in the project. Set PolhemSuppressTrimSupportWarning=true to silence this warning." />

  </Target>

</Project>
