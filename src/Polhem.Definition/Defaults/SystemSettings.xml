<?xml version="1.0" encoding="utf-8"?>
<!--
  Framework-shipped SystemSettings template.

  After materialising via `Polhem.Definition.Defaults.MaterializeTo(...)`, review the
  fields below and adjust for your deployment. The defaults here are conservative
  (debug mode off, no namespaces allow-listed for cross-tier type resolution) so
  the application boots in a production-shaped state out of the box.

  Required field to set before first run:
    - BackendConfiguration/SecurityKeySettings/MasterKeySource
      Default points at the `POLHEM_MASTER_KEY` environment variable. Set the env
      var (a Base64 AES-CBC-HMAC combined 64-byte key), or change Type to File
      and supply the key file path as the Value.

  Required when DatabaseSettings holds passwords:
    - BackendConfiguration/SecurityKeySettings/ConfigEncryptionKey
      The key that encrypts the passwords in DatabaseSettings.xml (stored as "enc:..."),
      itself encrypted with the master key. Without it, passwords are saved and read
      in clear text, and a warning is logged when DatabaseSettings is loaded or saved.

  Localization (review for your users):
    - CommonConfiguration/DefaultLanguage: the culture of users with no st_user.culture of
      their own, and the last language fall-back for captions, UI text and messages.
    - BackendConfiguration/DefaultTimeZone: the IANA zone of users with no st_user.time_zone of
      their own; empty means UTC.

  Optional fields to consider:
    - CommonConfiguration/IsDebugMode: enable verbose error responses for
      development environments.
    - CommonConfiguration/AllowedTypeNamespaces: allow-list of namespaces that may
      be deserialised across the API tier, separated by '|' (a comma is not a
      separator). Empty means no consumer-defined types are accepted (framework
      types always allowed).
    - BackendConfiguration/LogOptions/DbAccess: thresholds for slow-query /
      large-resultset logging.
    - BackendConfiguration/Components: assembly-qualified type names that replace
      framework services (e.g. CacheProvider, DefineStorage); omitted or blank
      means the framework default.
-->
<SystemSettings xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <CommonConfiguration>
    <Version>1.0.0</Version>
    <IsDebugMode>false</IsDebugMode>
    <DefaultLanguage>zh-TW</DefaultLanguage>
    <AllowedTypeNamespaces></AllowedTypeNamespaces>
    <ApiPayloadOptions>
      <Compressor>gzip</Compressor>
      <Encryptor>aes-cbc-hmac</Encryptor>
    </ApiPayloadOptions>
  </CommonConfiguration>
  <BackendConfiguration>
    <LogOptions>
      <DbAccess>
        <Level>Warning</Level>
        <AffectedRowThreshold>10000</AffectedRowThreshold>
        <ResultRowThreshold>10000</ResultRowThreshold>
        <ExecutionTimeThreshold>300</ExecutionTimeThreshold>
      </DbAccess>
    </LogOptions>
    <SecurityKeySettings>
      <MasterKeySource>
        <Type>Environment</Type>
        <Value>POLHEM_MASTER_KEY</Value>
      </MasterKeySource>
    </SecurityKeySettings>
    <DefaultTimeZone>Asia/Taipei</DefaultTimeZone>
  </BackendConfiguration>
  <FrontendConfiguration />
  <WebsiteConfiguration />
  <BackgroundServiceConfiguration />
</SystemSettings>
