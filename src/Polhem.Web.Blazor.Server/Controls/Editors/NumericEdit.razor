@namespace Polhem.Web.Blazor.Server.Controls.Editors
@inherits TextEdit

<input @attributes="AdditionalAttributes"
       id="@Id"
       type="text"
       class="@BuildCssClass(ModifierClass)"
       readonly="@(!IsEditable)"
       inputmode="@InputMode"
       @onfocus="OnFocus"
       @onblur="OnBlur"
       @bind:get="Text"
       @bind:set="CommitText" />
