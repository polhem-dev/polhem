@namespace Polhem.Web.Blazor.Server.Controls.Editors
@inherits NumericEditorBase

<input @attributes="AdditionalAttributes"
       id="@Id"
       type="text"
       class="@BuildCssClass("polhem-field-editor--numeric")"
       readonly="@(!IsEditable)"
       inputmode="decimal"
       @onfocus="BeginEditing"
       @onblur="EndEditing"
       @bind:get="Text"
       @bind:set="CommitText" />
