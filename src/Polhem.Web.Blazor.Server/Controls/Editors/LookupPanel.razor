@namespace Polhem.Web.Blazor.Server.Controls.Editors
@inherits LookupPanelBase
@using Polhem.Definition.Language
@using Polhem.Web.Blazor.Server.Components

<div class="polhem-lookup-panel">
    <form class="polhem-lookup-panel__search" @onsubmit="() => SearchAsync()" @onsubmit:preventDefault>
        <input type="search"
               class="polhem-lookup-panel__search-input"
               placeholder="@Text(PolhemUIText.Search)"
               @bind="SearchText" />
        <button type="submit" class="polhem-lookup-panel__search-button">@Text(PolhemUIText.Search)</button>
    </form>
    @if (Error is not null)
    {
        <div class="polhem-lookup-panel__error" role="alert">@Error</div>
    }
    @if (TruncationNotice is not null)
    {
        <div class="polhem-lookup-panel__notice" role="status">@TruncationNotice</div>
    }
    <DynamicGrid Layout="Layout"
                 Rows="Rows"
                 FormTable="Schema?.MasterTable"
                 SelectedRowId="SelectedRowId"
                 OnRowSelected="Select"
                 OnRowActivated="rowId => ActivateAsync(rowId)" />
    <div class="polhem-lookup-panel__buttons">
        <button type="button" class="polhem-lookup-panel__ok" disabled="@(SelectedRow is null)" @onclick="() => CommitAsync()">@Text(PolhemUIText.Ok)</button>
        <button type="button" class="polhem-lookup-panel__cancel" @onclick="() => CancelAsync()">@Text(PolhemUIText.Cancel)</button>
    </div>
</div>
