@namespace Polhem.Web.Blazor.Server.Controls.Editors

@* Inline positioning keeps the dialog modal without the host's stylesheet, as LookupDialog does. *@
<div class="polhem-row-edit-dialog"
     role="dialog"
     aria-modal="true"
     aria-label="@Title"
     style="position:fixed;inset:0;z-index:1000;display:flex;align-items:center;justify-content:center">
    <div class="polhem-row-edit-dialog__backdrop" style="position:absolute;inset:0;background:rgba(0,0,0,0.4)"></div>
    <div class="polhem-row-edit-dialog__card" style="position:relative;max-width:100%;max-height:100%;overflow:auto">
        @if (!string.IsNullOrEmpty(Title))
        {
            <div class="polhem-row-edit-dialog__title">@Title</div>
        }
        <RowEditPanel DataObject="DataObject"
                      Layout="Layout"
                      Row="Row"
                      Compact="Compact"
                      EditCommitted="EditCommitted"
                      EditCancelled="EditCancelled" />
    </div>
</div>
