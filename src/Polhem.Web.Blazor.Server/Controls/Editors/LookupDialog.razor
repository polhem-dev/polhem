@namespace Polhem.Web.Blazor.Server.Controls.Editors

@* The overlay's positioning is inline because without it the dialog is not modal at all; colors,
   spacing and the card's look are left to the host's stylesheet through the class names. *@
<div class="polhem-lookup-dialog"
     role="dialog"
     aria-modal="true"
     aria-label="@Title"
     style="position:fixed;inset:0;z-index:1000;display:flex;align-items:center;justify-content:center">
    <div class="polhem-lookup-dialog__backdrop"
         style="position:absolute;inset:0;background:rgba(0,0,0,0.4)"
         @onclick="CancelAsync"></div>
    <div class="polhem-lookup-dialog__card" style="position:relative;max-width:100%;max-height:100%;overflow:auto">
        <div class="polhem-lookup-dialog__title">@Title</div>
        @if (_error is not null)
        {
            <div class="polhem-lookup-dialog__error" role="alert">@_error</div>
            <button type="button" class="polhem-lookup-panel__cancel" @onclick="CancelAsync">@CancelText</button>
        }
        else if (_schema is null || _connector is null)
        {
            <div class="polhem-lookup-dialog__loading">@LoadingText</div>
        }
        else
        {
            <LookupPanel Schema="_schema"
                         Connector="_connector"
                         OnCommitted="CommitAsync"
                         OnCancelled="CancelAsync" />
        }
    </div>
</div>
