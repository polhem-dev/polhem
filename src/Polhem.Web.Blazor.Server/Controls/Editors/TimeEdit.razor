@namespace Polhem.Web.Blazor.Server.Controls.Editors
@inherits TimeEditorBase

<input @attributes="AdditionalAttributes"
       id="@Id"
       type="text"
       class="@BuildCssClass("polhem-field-editor--time")"
       readonly="@(!IsEditable)"
       maxlength="@MaxLength"
       inputmode="numeric"
       pattern="[0-2][0-9]:[0-5][0-9]"
       placeholder="HH:mm"
       @bind:get="Text"
       @bind:set="CommitText" />
