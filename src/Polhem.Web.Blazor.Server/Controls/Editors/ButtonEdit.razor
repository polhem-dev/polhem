@namespace Polhem.Web.Blazor.Server.Controls.Editors
@inherits TextEdit
@using Polhem.UI.Core.Fields

<span class="polhem-button-edit">
    <input @attributes="AdditionalAttributes"
           id="@Id"
           type="text"
           class="@BuildCssClass(ModifierClass)"
           readonly="@(HasLookup || !IsEditable)"
           maxlength="@MaxLengthAttribute"
           title="@_failure"
           @onkeydown="OnKeyDown"
           @bind:get="Text"
           @bind:set="CommitText" />
    @if (IsEditable)
    {
        @* The magnifier glyph is Semi.Avalonia's `SemiIconSearchStroked` (MIT), the one the Avalonia
           ButtonEdit embeds, so both heads show the same icon. *@
        <button type="button"
                class="polhem-button-edit__button"
                aria-label="@SearchText"
                title="@SearchText"
                @onclick="OnButtonClickAsync">
            <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true" focusable="false">
                <path fill="currentColor" d="M16 10a6 6 0 1 1-12 0 6 6 0 0 1 12 0Zm-1.1 6.32a8 8 0 1 1 1.41-1.41l5.4 5.38a1 1 0 0 1-1.42 1.42l-5.38-5.39Z" />
            </svg>
        </button>
    }
</span>
@if (_lookupOpen && FormField is { } lookupField)
{
    <LookupDialog ProgId="@LookupFieldRules.ResolveProgId(lookupField)"
                  OnCommitted="ApplySelectionAsync"
                  OnCancelled="CloseLookup"
                  OnFailed="ReportFailureAsync" />
}
