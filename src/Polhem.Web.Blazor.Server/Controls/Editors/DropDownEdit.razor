@namespace Polhem.Web.Blazor.Server.Controls.Editors
@inherits DropDownEditorBase

@if (IsEditable)
{
    <select @attributes="AdditionalAttributes"
            id="@Id"
            class="@BuildCssClass("polhem-field-editor--select")"
            @bind:get="SelectedValue"
            @bind:set="CommitValue">
        @if (SelectedItem is null)
        {
            <option value=""></option>
        }
        @foreach (var item in Items)
        {
            <option value="@item.Value">@item.Text</option>
        }
    </select>
}
else
{
    <input @attributes="AdditionalAttributes"
           id="@Id"
           type="text"
           class="@BuildCssClass("polhem-field-editor--select")"
           readonly
           value="@SelectedItem?.Text" />
}
