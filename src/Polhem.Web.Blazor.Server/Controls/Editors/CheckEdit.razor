@namespace Polhem.Web.Blazor.Server.Controls.Editors
@inherits FieldEditorBase

<input @attributes="AdditionalAttributes"
       id="@Id"
       type="checkbox"
       class="@BuildCssClass("polhem-field-editor--checkbox")"
       disabled="@(!IsEditable)"
       @bind:get="_checked"
       @bind:set="CommitChecked" />
