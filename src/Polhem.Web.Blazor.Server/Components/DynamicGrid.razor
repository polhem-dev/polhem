@using System.Data
@using Polhem.Definition.Layouts

@if (Layout is null || Rows is null || Rows.Rows.Count == 0)
{
    <div class="polhem-dynamic-grid polhem-dynamic-grid--empty">@DisplayedEmptyText</div>
}
else
{
    <table class="polhem-dynamic-grid">
        <thead>
            <tr>
                @foreach (var column in VisibleColumns)
                {
                    <th class="polhem-dynamic-grid__header" style="@BuildColumnStyle(column)" aria-sort="@AriaSort(column)">
                        @if (IsSortable(column))
                        {
                            <button type="button" class="polhem-dynamic-grid__sort" @onclick="() => OnSortRequested.InvokeAsync(column.FieldName)">@column.Caption@SortMark(column)</button>
                        }
                        else
                        {
                            @column.Caption
                        }
                    </th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (DataRow row in Rows.Rows)
            {
                <tr class="@RowClass(row)"
                    @onclick="() => OnRowClickAsync(row)"
                    @ondblclick="() => OnRowDoubleClickAsync(row)">
                    @foreach (var column in VisibleColumns)
                    {
                        <td class="polhem-dynamic-grid__cell">@FormatCell(row, column)</td>
                    }
                </tr>
            }
        </tbody>
    </table>
}
