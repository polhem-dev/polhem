@using Polhem.Web.Blazor.Server.DataObjects
@using Polhem.Definition.Language

<div class="polhem-form-page">
    @if (_error is not null)
    {
        <div class="polhem-form-page__error">@_error</div>
    }
    else if (_isInitializing || _dataObject is null)
    {
        <div class="polhem-form-page__loading">@Text(PolhemUIText.Loading)</div>
    }
    else
    {
        <div class="polhem-form-page__toolbar">
            <button type="button" disabled="@_isBusy" @onclick="OnNewAsync">@Text(PolhemUIText.New)</button>
            <button type="button" disabled="@(_isBusy || _dataObject.MasterRow is null)" @onclick="OnSaveAsync">@Text(PolhemUIText.Save)</button>
            <button type="button" disabled="@(_isBusy || _dataObject.MasterRow is null)" @onclick="OnDeleteAsync">@Text(PolhemUIText.Delete)</button>
            @if (_dataObject.IsDirty)
            {
                <span class="polhem-form-page__dirty">@Text(PolhemUIText.Unsaved)</span>
            }
        </div>

        @if (_notice is not null)
        {
            <div class="polhem-form-page__notice" role="alert">@_notice</div>
        }

        <DynamicGrid Layout="_listLayout"
                     Rows="_listRows"
                     FormTable="_schema?.MasterTable"
                     OnRowSelected="OnRowSelectedAsync" />

        <DynamicForm Layout="_formLayout"
                     DataObject="_dataObject" />
    }
</div>
