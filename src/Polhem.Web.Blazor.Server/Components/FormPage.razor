@using Polhem.Web.Blazor.Server.DataObjects
@using Polhem.Definition.Language
@using Polhem.Definition.Settings
@using Polhem.Web.Blazor.Server.Controls

<div class="polhem-form-page">
    @if (IsCompact is null)
    {
        <CompactViewportObserver CompactWidthThreshold="CompactWidthThreshold" CompactChanged="OnCompactChanged" />
    }
    @if (_error is not null)
    {
        <div class="polhem-form-page__error">@_error</div>
    }
    else if (_isInitializing || _dataObject is null)
    {
        <div class="polhem-form-page__loading">@Text(PolhemUIText.Loading)</div>
    }
    else
    {
        @* A command the user lacks the permission for is hidden, as in the Avalonia views. *@
        <div class="polhem-form-page__toolbar">
            @if (!_isShowingRecord)
            {
                @if (Can(PermissionActions.Read))
                {
                    <button type="button" disabled="@(IsListLocked || _selectedRowId is null)" @onclick="OnViewAsync">@Text(PolhemUIText.View)</button>
                }
                @if (Can(PermissionActions.Create))
                {
                    <button type="button" disabled="@IsListLocked" @onclick="OnNewAsync">@Text(PolhemUIText.New)</button>
                }
                @if (Can(PermissionActions.Update))
                {
                    <button type="button" disabled="@(IsListLocked || _selectedRowId is null)" @onclick="OnEditAsync">@Text(PolhemUIText.Edit)</button>
                }
                @if (Can(PermissionActions.Delete))
                {
                    <button type="button" disabled="@(IsListLocked || _selectedRowId is null)" @onclick="OnDeleteAsync">@Text(PolhemUIText.Delete)</button>
                }
            }
            else if (IsEditing)
            {
                @if (Can(PermissionActions.Create | PermissionActions.Update))
                {
                    <button type="button" disabled="@_isBusy" @onclick="OnSaveAsync">@Text(PolhemUIText.Save)</button>
                }
                <button type="button" disabled="@_isBusy" @onclick="OnClose">@Text(PolhemUIText.Cancel)</button>
                @if (_dataObject.IsDirty)
                {
                    <span class="polhem-form-page__dirty">@Text(PolhemUIText.Unsaved)</span>
                }
            }
            else
            {
                <button type="button" disabled="@_isBusy" @onclick="OnClose">@Text(PolhemUIText.Back)</button>
            }
        </div>

        @if (_notice is not null)
        {
            <div class="polhem-form-page__notice" role="alert">@_notice</div>
        }

        @if (LiveComputationNotice is { } liveComputationNotice)
        {
            <div class="polhem-form-page__notice" role="status">@liveComputationNotice</div>
        }

        @if (!_isShowingRecord)
        {
            <DynamicGrid Layout="_listLayout"
                         Rows="_listRows"
                         FormTable="_schema?.MasterTable"
                         SelectedRowId="_selectedRowId"
                         OnRowSelected="OnRowSelected"
                         OnRowActivated="OnRowActivatedAsync"
                         SortFieldName="@_paging.SortFieldName"
                         SortDirection="_paging.SortDirection"
                         OnSortRequested="OnSortRequestedAsync" />
            @if (ShowsPager)
            {
                <div class="polhem-form-page__pager">
                    <button type="button" disabled="@(IsListLocked || !_paging.CanGoPrevious)" @onclick="() => GoToPageAsync(_paging.Page - 1)">@Text(PolhemUIText.PreviousPage)</button>
                    <button type="button" disabled="@(IsListLocked || !_paging.CanGoNext)" @onclick="() => GoToPageAsync(_paging.Page + 1)">@Text(PolhemUIText.NextPage)</button>
                    <span class="polhem-form-page__page-position">@PagePosition</span>
                    <label class="polhem-form-page__page-size">
                        @Text(PolhemUIText.RowsPerPage)
                        <select disabled="@IsListLocked" @onchange="OnPageSizeChangedAsync">
                            @foreach (var pageSize in s_pageSizes)
                            {
                                <option value="@pageSize" selected="@(pageSize == _paging.PageSize)">@pageSize</option>
                            }
                        </select>
                    </label>
                </div>
            }
        }
        else
        {
            <FormLayoutPresenter Layout="_formLayout"
                                 DataObject="_dataObject"
                                 FormMode="FormMode"
                                 RoundingContext="_roundingContext"
                                 IsCompact="EffectiveIsCompact"
                                 DetailEditMode="DetailEditMode"
                                 OpenRelation="OpenRelation" />
        }
    }
    @if (_pendingDeleteRowId is not null)
    {
        @* Inline positioning keeps the dialog modal without the host's stylesheet, as LookupDialog does. *@
        <div class="polhem-confirm-dialog"
             role="alertdialog"
             aria-modal="true"
             aria-label="@Text(PolhemUIText.Delete)"
             style="position:fixed;inset:0;z-index:1000;display:flex;align-items:center;justify-content:center"
             @onkeydown="OnConfirmDeleteKeyDown">
            <div class="polhem-confirm-dialog__backdrop" style="position:absolute;inset:0;background:rgba(0,0,0,0.4)" @onclick="CancelDelete"></div>
            <div class="polhem-confirm-dialog__card" style="position:relative;max-width:100%;max-height:100%;overflow:auto">
                <div class="polhem-confirm-dialog__title">@Text(PolhemUIText.Delete)</div>
                <div class="polhem-confirm-dialog__message">@Text(PolhemUIText.DeleteRecordPrompt)</div>
                <div class="polhem-confirm-dialog__buttons">
                    <button type="button" class="polhem-confirm-dialog__cancel" @ref="_cancelDeleteButton" @onclick="CancelDelete">@Text(PolhemUIText.Cancel)</button>
                    <button type="button" class="polhem-confirm-dialog__confirm" @onclick="ConfirmDeleteAsync">@Text(PolhemUIText.Delete)</button>
                </div>
            </div>
        </div>
    }
    @if (_relation is { } relation)
    {
        <RelatedRecordDialog Target="relation"
                             DefinitionLoader="DefinitionLoader"
                             IsCompact="EffectiveIsCompact"
                             OnClosed="CloseRelation"
                             OnRefused="OnRelationRefused" />
    }
</div>
