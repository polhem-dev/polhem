@inherits RelatedRecordDialogBase
@using Polhem.Definition.Language
@using Polhem.Definition.Layouts
@using Polhem.Web.Blazor.Server.Controls

@if (IsPermitted || Error is not null)
{
    @* Inline positioning keeps the dialog modal without the host's stylesheet, as LookupDialog does. A dialog opened
       from this one comes later in the document, so it stacks on top. *@
    <div class="polhem-related-record-dialog"
         role="dialog"
         aria-modal="true"
         aria-label="@Title"
         style="position:fixed;inset:0;z-index:1000;display:flex;align-items:center;justify-content:center">
        <div class="polhem-related-record-dialog__backdrop" style="position:absolute;inset:0;background:rgba(0,0,0,0.4)"></div>
        <div class="polhem-related-record-dialog__card" style="position:relative;max-width:100%;max-height:100%;overflow:auto">
            @if (!string.IsNullOrEmpty(Title))
            {
                <div class="polhem-related-record-dialog__title">@Title</div>
            }
            <div class="polhem-related-record-dialog__toolbar">
                <button type="button" @onclick="() => OnClosed.InvokeAsync()">@Text(PolhemUIText.Close)</button>
            </div>
            @if (Notice is not null)
            {
                <div class="polhem-related-record-dialog__notice" role="alert">@Notice</div>
            }
            @if (Error is not null)
            {
                <div class="polhem-related-record-dialog__error">@Error</div>
            }
            else if (DataObject is null)
            {
                <div class="polhem-related-record-dialog__loading">@Text(PolhemUIText.Loading)</div>
            }
            else
            {
                <FormLayoutPresenter Layout="FormLayout"
                                     DataObject="DataObject"
                                     FormMode="SingleFormMode.View"
                                     RoundingContext="RoundingContext"
                                     IsCompact="IsCompact"
                                     IdPrefix="@IdPrefix"
                                     OpenRelation="OpenRelation" />
            }
        </div>
    </div>
}
@if (Relation is { } relation)
{
    <RelatedRecordDialog Target="relation"
                         DefinitionLoader="DefinitionLoader"
                         IsCompact="IsCompact"
                         OnClosed="CloseRelation"
                         OnRefused="OnRelationRefused" />
}
