@inherits ShellNavMenuBase
@if (Error is not null)
{
    <div class="polhem-shell-nav__error" role="alert">@Error</div>
}
else if (Rows is null)
{
    <div class="polhem-shell-nav__loading">@LoadingText</div>
}
else if (Rows.Count == 0)
{
    <div class="polhem-shell-nav__empty">@PolhemShellText.Get(PolhemShellText.MenuEmpty)</div>
}
else
{
    <ul class="polhem-shell-nav">
        @foreach (var row in Rows)
        {
            if (row.ProgId is null)
            {
                <li class="polhem-shell-nav__header">@row.Caption</li>
            }
            else
            {
                <li>
                    <NavLink class="polhem-shell-nav__link" href="@Options.GetFormUri(row.ProgId)" @onclick="OnNavigated">@row.Caption</NavLink>
                </li>
            }
        }
    </ul>
}
