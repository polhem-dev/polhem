<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <Description>Avalonia control library for Polhem: FormSchema-driven UI for desktop, browser (WebAssembly), iOS and Android heads.</Description>
    <PackageTags>polhem;avalonia;ui;controls;forms</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Lower bounds, not the version the heads run: NuGet treats these as the minimum, so a host is free to bring a
      newer Avalonia 12.x. The heads in this repository run the 12.1 line, and
      tests/Polhem.UI.Avalonia.UnitTests references that line explicitly so the tests run what the heads ship.
    -->
    <PackageReference Include="Avalonia" Version="12.0.0" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Polhem.UI.Core\Polhem.UI.Core.csproj" />
    <ProjectReference Include="..\Polhem.Api.Client\Polhem.Api.Client.csproj" />
    <ProjectReference Include="..\Polhem.Definition\Polhem.Definition.csproj" />
    <ProjectReference Include="..\Polhem.Expressions\Polhem.Expressions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Polhem.UI.Avalonia.UnitTests" />
  </ItemGroup>

</Project>
