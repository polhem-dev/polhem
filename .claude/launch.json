{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "northwind-server",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": [
        "run",
        "--project",
        "apps/Polhem.Northwind/Polhem.Northwind.Server/Polhem.Northwind.Server.csproj",
        "--configuration",
        "Debug"
      ],
      "port": 5100,
      "autoPort": false
    },
    {
      "name": "northwind-browser",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": [
        "run",
        "--project",
        "apps/Polhem.Northwind/Polhem.Northwind.Browser/Polhem.Northwind.Browser.csproj",
        "--configuration",
        "Debug"
      ],
      "port": 5200,
      "autoPort": false
    },
    {
      "name": "northwind-blazor",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": [
        "run",
        "--project",
        "apps/Polhem.Northwind/Polhem.Northwind.Blazor/Polhem.Northwind.Blazor.csproj",
        "--configuration",
        "Debug"
      ],
      "port": 5300,
      "autoPort": false
    },
    {
      "name": "northwind-blazor-remote",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": [
        "run",
        "--project",
        "apps/Polhem.Northwind/Polhem.Northwind.Blazor/Polhem.Northwind.Blazor.csproj",
        "--configuration",
        "Debug",
        "--",
        "--Northwind:Mode=Remote"
      ],
      "port": 5300,
      "autoPort": false
    },
    {
      "name": "northwind-blazor-wasm",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": [
        "run",
        "--project",
        "apps/Polhem.Northwind/Polhem.Northwind.BlazorWasm/Polhem.Northwind.BlazorWasm.csproj",
        "--configuration",
        "Debug"
      ],
      "port": 5600,
      "autoPort": false
    },
    {
      "name": "northwind-demo",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": [
        "run",
        "--project",
        "apps/Polhem.Northwind/Polhem.Northwind.Blazor/Polhem.Northwind.Blazor.csproj",
        "--configuration",
        "Debug",
        "--launch-profile",
        "Demo"
      ],
      "port": 5400,
      "autoPort": false
    },
    {
      "name": "blazor-mud-democenter",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": [
        "run",
        "--project",
        "samples/Blazor.Mud.DemoCenter/Blazor.Mud.DemoCenter.csproj",
        "--configuration",
        "Debug"
      ],
      "port": 5055,
      "autoPort": false
    },
    {
      "name": "blazor-fluent-democenter",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": [
        "run",
        "--project",
        "samples/Blazor.Fluent.DemoCenter/Blazor.Fluent.DemoCenter.csproj",
        "--configuration",
        "Debug"
      ],
      "port": 5056,
      "autoPort": false
    },
    {
      "name": "northwind-blazor-fluent-wasm",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": [
        "run",
        "--project",
        "apps/Polhem.Northwind/Polhem.Northwind.BlazorFluentWasm/Polhem.Northwind.BlazorFluentWasm.csproj",
        "--configuration",
        "Debug"
      ],
      "port": 5700,
      "autoPort": false
    }
  ]
}
