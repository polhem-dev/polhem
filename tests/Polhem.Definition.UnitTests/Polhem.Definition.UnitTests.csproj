<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.1.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Polhem.Core\Polhem.Core.csproj" />
    <ProjectReference Include="..\..\src\Polhem.Definition\Polhem.Definition.csproj" />
    <!--
      Polhem.Definition no longer references Polhem.Expressions (the abstraction now lives in Polhem.Core;
      see adr-038). The FormExpressionCalculator tests still exercise the real DynamicExpresso
      implementation on purpose — the point of those tests is that client and server agree on the
      computed value — so the test project takes the same explicit reference a composition root
      would. This does not weaken DefinitionDependencyGateTests, which walks Polhem.Definition's own
      dependency edges rather than this project's.
    -->
    <ProjectReference Include="..\..\src\Polhem.Expressions\Polhem.Expressions.csproj" />
    <ProjectReference Include="..\Polhem.Tests.Shared\Polhem.Tests.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
