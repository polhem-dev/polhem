<?xml version="1.0" encoding="utf-8"?>
<!--
  Per-form audit rules. Maintained through the framework's own CRUD path, so changing the audit
  policy is itself an ordinary form save — and is always recorded, whatever this table says.

  PermissionModelId is declared deliberately, unlike the other framework-shipped forms: audit
  policy is a privileged operation (SAP gates SE13 behind Basis rights, Odoo puts auditlog.rule
  behind Technical Features). Enforcement is fail-closed, so after copying this into a deployment
  the `AuditRule` model must be granted to a role before anyone can open the form. See
  PermissionModels.xml for the matching registry entry.

  The two mode fields take their dropdown options from the `AuditRuleMode` language enum, so the
  options follow the caller's language like every other label. The static English ListItems are the
  base the localizer falls back to: FormSchemaLocalizer replaces them when the enum resolves and
  leaves them in place when it does not. Without them the dropdowns were empty whenever no
  localization ran at all (a head with no definition loader, a blank culture) or ran for a language
  with no resource file. The codes are the persisted `AuditRuleMode` values; DefaultsTests pins them
  against the enum and the language files. The captions are English for the same reason.

  ControlType is set explicitly on all three non-text fields. `Auto` does not infer a dropdown from
  the presence of options — it falls back to TextEdit — so an option source without a ControlType
  loads the options and then has nowhere to show them.
-->
<FormSchema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" ProgId="AuditRule" DisplayName="Audit Rule" CategoryId="company" PermissionModelId="AuditRule" ListFields="sys_id,sys_name,change_mode,access_mode,is_sensitive">
  <Tables>
    <FormTable TableName="AuditRule" DbTableName="st_audit_rule" DisplayName="Audit Rule">
      <Fields>
        <FormField FieldName="sys_no" Caption="Sequence No." DbType="AutoIncrement" Visible="false" />
        <FormField FieldName="sys_rowid" Caption="Row Id" DbType="Guid" Visible="false" />
        <FormField FieldName="sys_id" Caption="Program Id" DbType="String" Required="true" />
        <FormField FieldName="sys_name" Caption="Form Name" DbType="String" />
        <FormField FieldName="change_mode" Caption="Change Log" DbType="Integer" ControlType="DropDownEdit" LangEnumName="AuditRuleMode">
          <ListItems>
            <ListItem Value="0" Text="Inherit" />
            <ListItem Value="1" Text="On" />
            <ListItem Value="2" Text="Off" />
          </ListItems>
        </FormField>
        <FormField FieldName="access_mode" Caption="Access Log" DbType="Integer" ControlType="DropDownEdit" LangEnumName="AuditRuleMode">
          <ListItems>
            <ListItem Value="0" Text="Inherit" />
            <ListItem Value="1" Text="On" />
            <ListItem Value="2" Text="Off" />
          </ListItems>
        </FormField>
        <FormField FieldName="is_sensitive" Caption="Sensitive" DbType="Boolean" ControlType="CheckEdit" />
        <FormField FieldName="remark" Caption="Remark" DbType="String" />
        <FormField FieldName="sys_insert_time" Caption="Created At" DbType="DateTime" Visible="false" ReadOnly="true" />
      </Fields>
    </FormTable>
  </Tables>
</FormSchema>
