<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.1.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!--
      Analyzers are driven through a small in-repo harness (see AnalyzerRunner) rather than
      Microsoft.CodeAnalysis.CSharp.Analyzer.Testing. That package resolves reference assemblies
      from NuGet at test time, which makes the suite depend on network access, and its markup
      syntax only pays off for code fix tests, which this project does not have. Building the
      compilation directly also keeps full control over the AdditionalFiles the rules read.
    -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Referenced as a plain assembly, not as an analyzer: the tests drive the analyzers through
      the test harness explicitly. Applying them to this project as well would report the
      framework conventions against the test code itself.
    -->
    <ProjectReference Include="..\..\src\Polhem.Analyzers\Polhem.Analyzers.csproj" />
    <!-- net10.0 references used by the synchronisation assertions and by rules that resolve framework
         types (FieldDbType, BusinessObject, ApiAccessControlAttribute). -->
    <ProjectReference Include="..\..\src\Polhem.Definition\Polhem.Definition.csproj" />
    <ProjectReference Include="..\..\src\Polhem.Business\Polhem.Business.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared with the test projects that reference Polhem.Tests.Shared; this project does not. -->
    <Compile Include="..\Polhem.Tests.Shared\RepoRoot.cs" Link="RepoRoot.cs" />
  </ItemGroup>

</Project>
