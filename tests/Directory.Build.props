<Project>
  <PropertyGroup>
    <!-- Language features -->
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Health checks -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!-- Second safeguard: the Sonar-wrapped build in build-ci.yml weakens the effect of TreatWarningsAsErrors on
         some analyzer rules. WarningsAsErrors hardens them by name, and the Sonar ruleset cannot override it. -->
    <WarningsAsErrors>$(WarningsAsErrors);IDE0005;CA1861;S2699</WarningsAsErrors>

    <!-- IDE0005 is only detected at compile time when GenerateDocumentationFile is also enabled.
         Test projects have no public API to document, so every XML comment warning is turned off. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1570;CS1572;CS1573;CS1574;CS1580;CS1581;CS1584;CS1587;CS1589;CS1591;CS1592</NoWarn>
  </PropertyGroup>
</Project>
