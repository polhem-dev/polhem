<Project>
  <PropertyGroup>
    <!-- Language features -->
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Health checks -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!-- Second safeguard: the Sonar-wrapped build in build-ci.yml weakens the effect of TreatWarningsAsErrors on
         some analyzer rules. WarningsAsErrors hardens them by name, and the Sonar ruleset cannot override it. -->
    <WarningsAsErrors>$(WarningsAsErrors);IDE0005;CA1861;S2699</WarningsAsErrors>

    <!-- IDE0005 is only detected at compile time when GenerateDocumentationFile is also enabled, which also makes
         the compiler check every XML comment. Test code does not have to document each member (CS1591), but the
         comments it does write keep the same guard as src: a <see cref> to a type or member that no longer exists
         fails the build (CS1574), and malformed XML does too (CS1570). -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
</Project>
