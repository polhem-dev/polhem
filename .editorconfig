root = true

# All files
[*]
indent_style = space
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

# C# files
[*.cs]
indent_size = 4

# Compile-time check: remove unnecessary using directives
dotnet_diagnostic.IDE0005.severity = warning

# Compile-time check: use collection initializers
dotnet_diagnostic.IDE0028.severity = warning

# Compile-time check: a type name must not match the last segment of a namespace
dotnet_diagnostic.CA1724.severity = warning

# ───── Rules moved from SonarCloud to compile time ─────

# A method that uses no instance members should be static (S2325)
dotnet_diagnostic.CA1822.severity = warning

# A class with only static members should be a static class (S1118/S3442)
dotnet_diagnostic.CA1052.severity = warning

# A field never assigned after initialization should be readonly (S2933)
dotnet_diagnostic.IDE0044.severity = warning

# Unused private members (S4487)
dotnet_diagnostic.IDE0051.severity = warning
dotnet_diagnostic.IDE0052.severity = warning

# Parameter names of an override or interface implementation must match the declaration (S927)
dotnet_diagnostic.CA1725.severity = warning

# Culture-dependent APIs must be given an IFormatProvider (S6580)
dotnet_diagnostic.CA1305.severity = warning

# ───── Security (see .claude/rules/scanning.md) ─────

# XXE: safe XML parsing settings
dotnet_diagnostic.CA3075.severity = warning

# No SHA1 / MD5 for security hashing
dotnet_diagnostic.CA5350.severity = warning
dotnet_diagnostic.CA5351.severity = warning

# No System.Random for security purposes
dotnet_diagnostic.CA5394.severity = warning

# ───── Field naming (see .claude/rules/code-style.md; previously enforced only by the prompt) ─────
#
# The rules are matched in declaration order and the first match wins, so the order of the three
# must not change: const, then static, then the remaining private/protected fields.
dotnet_diagnostic.IDE1006.severity = warning

dotnet_naming_rule.private_const_fields_pascal.symbols = private_const_fields
dotnet_naming_rule.private_const_fields_pascal.style = pascal_case_style
dotnet_naming_rule.private_const_fields_pascal.severity = warning
dotnet_naming_symbols.private_const_fields.applicable_kinds = field
dotnet_naming_symbols.private_const_fields.applicable_accessibilities = private, protected, protected_internal, private_protected
dotnet_naming_symbols.private_const_fields.required_modifiers = const

# `required_modifiers` is `static`, not `static readonly`: **mutable** process-wide state is exactly what
# most needs to be marked for the reader. If only immutable statics were covered, mutable statics would fall
# through to the `_camelCase` rule below and look like instance fields, whose concurrency risks are very different.
dotnet_naming_rule.private_static_fields_s_prefix.symbols = private_static_fields
dotnet_naming_rule.private_static_fields_s_prefix.style = s_camel_case_style
dotnet_naming_rule.private_static_fields_s_prefix.severity = warning
dotnet_naming_symbols.private_static_fields.applicable_kinds = field
dotnet_naming_symbols.private_static_fields.applicable_accessibilities = private, protected, protected_internal, private_protected
dotnet_naming_symbols.private_static_fields.required_modifiers = static

dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_camel_case_style
dotnet_naming_rule.private_fields_underscore.severity = warning
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private, protected, protected_internal, private_protected

dotnet_naming_style.pascal_case_style.capitalization = pascal_case
dotnet_naming_style.s_camel_case_style.required_prefix = s_
dotnet_naming_style.s_camel_case_style.capitalization = camel_case
dotnet_naming_style.underscore_camel_case_style.required_prefix = _
dotnet_naming_style.underscore_camel_case_style.capitalization = camel_case

# `PermissionAction` is deliberately singular: callers always pass a single action, as in
# `Can(token, modelId, PermissionAction.Read)`. `[Flags]` is used only to store the `allowed_actions` mask.
# This is marked False Positive in SonarCloud; the compile-time warning is turned off here as well, so that CI
# does not show the same annotation on every run.
[src/Polhem.Definition/Settings/Permission/PermissionAction.cs]
dotnet_diagnostic.S2342.severity = none

# XML project files
[*.{csproj,props,targets}]
indent_size = 2

# XML files
[*.xml]
indent_size = 2

# JSON files
[*.json]
indent_size = 2

# Markdown files
[*.md]
indent_size = 2
trim_trailing_whitespace = false

# Solution files
[*.{sln,slnx}]
indent_size = 2
